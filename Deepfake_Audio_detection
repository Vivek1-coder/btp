34:25.283607Z"}},"outputs":[{"name":"stdout","text":"[INFO] Global random seed set to 42\n","output_type":"stream"}],"execution_count":12},{"id":"8303e836-a22d-47d9-bd25-43e853b00f3f","cell_type":"code","source":"# ==============================================================\n# Cell 5: Configuration dictionary\n# ==============================================================\nCONFIG: Dict[str, Any] = {\n    # ---------------- Audio ----------------\n    \"sample_rate\": 16000,\n    \"max_audio_seconds\": 4.0,          # utterances are trimmed/padded to this length\n    \"n_fft\": 512,\n    \"hop_length\": 160,\n    \"win_length\": 400,\n    \"n_mels\": 80,\n\n    # ---------------- VAD ----------------\n    \"use_vad\": True,\n    \"vad_frame_ms\": 30,\n    \"vad_energy_threshold_db\": -35.0,  # used by the energy-based VAD fallback\n\n    # ---------------- SSL Encoder ----------------\n    \"ssl_model_name\": \"ntu-spml/distilhubert\",  # DistilHuBERT on HuggingFace Hub\n    \"ssl_freeze\": True,                # freeze SSL encoder initially\n    \"ssl_finetune\": False,             # flip to True (and ssl_freeze=False) to fine-tune SSL encoder\n    \"ssl_output_dim\": 768,             # DistilHuBERT hidden size\n\n    # ---------------- CNN backbone ----------------\n    \"cnn_backbone\": \"mobilenetv3_small\",   # \"mobilenetv3_small\" or \"efficientnet_lite0\"\n    \"cnn_pretrained\": True,\n    \"cnn_out_dim\": 576,                 # mobilenetv3_small feature dim (auto-detected at runtime too)\n\n    # ---------------- Wavelet block ----------------\n    \"use_wavelet\": True,\n    \"wavelet_name\": \"db4\",\n    \"wavelet_level\": 3,\n    \"wavelet_out_dim\": 128,\n\n    # ---------------- Attention pooling ----------------\n    \"attention_hidden_dim\": 128,\n\n    # ---------------- Classifier ----------------\n    \"classifier_hidden_dim\": 256,\n    \"dropout\": 0.3,\n    \"num_classes\": 2,   # 0 = fake/spoof, 1 = real/bonafide\n\n    # ---------------- Training ----------------\n    \"batch_size\": 16,\n    \"num_workers\": 4,\n    \"epochs\": 20,\n    \"lr\": 3e-4,\n    \"weight_decay\": 1e-4,\n    \"warmup_epochs\": 1,\n    \"use_amp\": True,\n    \"use_focal_loss\": False,\n    \"focal_gamma\": 2.0,\n    \"grad_clip_norm\": 5.0,\n    \"early_stopping_patience\": 5,\n\n    # ---------------- Augmentation ----------------\n    \"use_augmentation\": True,\n    \"spec_freq_mask_param\": 15,\n    \"spec_time_mask_param\": 25,\n    \"noise_prob\": 0.3,\n    \"noise_snr_db_range\": (5, 20),\n    \"pitch_shift_prob\": 0.2,\n    \"pitch_shift_semitones_range\": (-2, 2),\n    \"time_stretch_prob\": 0.2,\n    \"time_stretch_rate_range\": (0.9, 1.1),\n\n    # ---------------- Paths ----------------\n    \"checkpoint_dir\": \"./checkpoints\",\n    \"results_dir\": \"./results\",\n    \"best_model_path\": \"./checkpoints/best_model.pt\",\n\n    # ---------------- Misc ----------------\n    \"seed\": SEED,\n    \"label_map\": {\"bonafide\": 1, \"spoof\": 0},  # real = 1, fake = 0\n}\n\nos.makedirs(CONFIG[\"checkpoint_dir\"], exist_ok=True)\nos.makedirs(CONFIG[\"results_dir\"], exist_ok=True)\n\nprint(json.dumps(CONFIG, indent=2, default=str))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.286194Z","iopub.execute_input":"2026-08-14T17:34:25.286552Z","iopub.status.idle":"2026-08-14T17:34:25.297896Z","shell.execute_reply.started":"2026-08-14T17:34:25.286531Z","shell.execute_reply":"2026-08-14T17:34:25.29722Z"}},"outputs":[{"name":"stdout","text":"{\n  \"sample_rate\": 16000,\n  \"max_audio_seconds\": 4.0,\n  \"n_fft\": 512,\n  \"hop_length\": 160,\n  \"win_length\": 400,\n  \"n_mels\": 80,\n  \"use_vad\": true,\n  \"vad_frame_ms\": 30,\n  \"vad_energy_threshold_db\": -35.0,\n  \"ssl_model_name\": \"ntu-spml/distilhubert\",\n  \"ssl_freeze\": true,\n  \"ssl_finetune\": false,\n  \"ssl_output_dim\": 768,\n  \"cnn_backbone\": \"mobilenetv3_small\",\n  \"cnn_pretrained\": true,\n  \"cnn_out_dim\": 576,\n  \"use_wavelet\": true,\n  \"wavelet_name\": \"db4\",\n  \"wavelet_level\": 3,\n  \"wavelet_out_dim\": 128,\n  \"attention_hidden_dim\": 128,\n  \"classifier_hidden_dim\": 256,\n  \"dropout\": 0.3,\n  \"num_classes\": 2,\n  \"batch_size\": 16,\n  \"num_workers\": 4,\n  \"epochs\": 20,\n  \"lr\": 0.0003,\n  \"weight_decay\": 0.0001,\n  \"warmup_epochs\": 1,\n  \"use_amp\": true,\n  \"use_focal_loss\": false,\n  \"focal_gamma\": 2.0,\n  \"grad_clip_norm\": 5.0,\n  \"early_stopping_patience\": 5,\n  \"use_augmentation\": true,\n  \"spec_freq_mask_param\": 15,\n  \"spec_time_mask_param\": 25,\n  \"noise_prob\": 0.3,\n  \"noise_snr_db_range\": [\n    5,\n    20\n  ],\n  \"pitch_shift_prob\": 0.2,\n  \"pitch_shift_semitones_range\": [\n    -2,\n    2\n  ],\n  \"time_stretch_prob\": 0.2,\n  \"time_stretch_rate_range\": [\n    0.9,\n    1.1\n  ],\n  \"checkpoint_dir\": \"./checkpoints\",\n  \"results_dir\": \"./results\",\n  \"best_model_path\": \"./checkpoints/best_model.pt\",\n  \"seed\": 42,\n  \"label_map\": {\n    \"bonafide\": 1,\n    \"spoof\": 0\n  }\n}\n","output_type":"stream"}],"execution_count":13},{"id":"c9a29362-3835-4929-9348-8ab17c1a2474","cell_type":"code","source":"# ==============================================================\n# Cell 6: Dataset paths (ASVspoof2024)\n# ==============================================================\n# Update these paths to point to your local copy of the ASVspoof2024 dataset.\n# Expected ASVspoof-style layout:\n#\n#   ASVspoof2024_root/\n#     ├── flac/                                  (or wav/)  <- audio files\n#     ├── ASVspoof2024.LA.cm.train.trn.txt        <- train protocol\n#     ├── ASVspoof2024.LA.cm.dev.trl.txt          <- dev protocol\n#     └── ASVspoof2024.LA.cm.eval.trl.txt         <- eval protocol\n#\n# Each protocol line typically follows:\n#   SPEAKER_ID  AUDIO_FILE_NAME  -  ATTACK_ID  LABEL(bonafide/spoof)\n\nDATA_ROOT = Path(\"./ASVspoof2024\")            # <-- CHANGE ME\nAUDIO_DIR = DATA_ROOT / \"flac\"                # <-- CHANGE ME (folder holding .flac/.wav files)\n\nPROTOCOL_PATHS = {\n    \"train\": DATA_ROOT / \"ASVspoof2024.LA.cm.train.trn.txt\",\n    \"dev\":   DATA_ROOT / \"ASVspoof2024.LA.cm.dev.trl.txt\",\n    \"eval\":  DATA_ROOT / \"ASVspoof2024.LA.cm.eval.trl.txt\",\n}\n\nAUDIO_EXTENSION = \".flac\"  # change to \".wav\" if applicable\n\nfor split, p in PROTOCOL_PATHS.items():\n    status = \"FOUND\" if p.exists() else \"MISSING (please update DATA_ROOT)\"\n    print(f\"[{split.upper():5s}] protocol file: {p}  -> {status}\")\n\nprint(f\"[INFO] Audio directory: {AUDIO_DIR} -> \"\n      f\"{'FOUND' if AUDIO_DIR.exists() else 'MISSING (please update AUDIO_DIR)'}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.298615Z","iopub.execute_input":"2026-08-14T17:34:25.298854Z","iopub.status.idle":"2026-08-14T17:34:25.313906Z","shell.execute_reply.started":"2026-08-14T17:34:25.298835Z","shell.execute_reply":"2026-08-14T17:34:25.313302Z"}},"outputs":[{"name":"stdout","text":"[TRAIN] protocol file: ASVspoof2024/ASVspoof2024.LA.cm.train.trn.txt  -> MISSING (please update DATA_ROOT)\n[DEV  ] protocol file: ASVspoof2024/ASVspoof2024.LA.cm.dev.trl.txt  -> MISSING (please update DATA_ROOT)\n[EVAL ] protocol file: ASVspoof2024/ASVspoof2024.LA.cm.eval.trl.txt  -> MISSING (please update DATA_ROOT)\n[INFO] Audio directory: ASVspoof2024/flac -> MISSING (please update AUDIO_DIR)\n","output_type":"stream"}],"execution_count":14},{"id":"505c5882-108c-4abb-bbfe-b598ad66c7d7","cell_type":"code","source":"# ==============================================================\n# Cell 7: Read ASVspoof protocol files\n# ==============================================================\ndef read_asvspoof_protocol(protocol_path: Union[str, Path],\n                            audio_dir: Union[str, Path],\n                            audio_ext: str = \".flac\") -> pd.DataFrame:\n    '''Parse an ASVspoof-style protocol/key file into a DataFrame.\n\n    The standard ASVspoof CM protocol format (whitespace separated) is:\n        SPEAKER_ID  AUDIO_FILE_NAME  SYSTEM_ID  ATTACK_ID  KEY\n\n    Where KEY is one of {bonafide, spoof}. This parser is robust to protocol\n    files with 4 or 5 columns (some releases omit SYSTEM_ID).\n\n    Args:\n        protocol_path: Path to the ASVspoof protocol/key text file.\n        audio_dir: Directory containing the audio files referenced in the protocol.\n        audio_ext: File extension of the audio files (e.g. \".flac\", \".wav\").\n\n    Returns:\n        DataFrame with columns: [speaker_id, file_name, filepath, attack_id, label, target]\n    '''\n    protocol_path = Path(protocol_path)\n    audio_dir = Path(audio_dir)\n\n    if not protocol_path.exists():\n        warnings.warn(f\"Protocol file not found: {protocol_path}. Returning empty DataFrame.\")\n        return pd.DataFrame(columns=[\"speaker_id\", \"file_name\", \"filepath\",\n                                      \"attack_id\", \"label\", \"target\"])\n\n    rows = []\n    with open(protocol_path, \"r\") as f:\n        for line in f:\n            parts = line.strip().split()\n            if len(parts) < 4:\n                continue\n            speaker_id = parts[0]\n            file_name = parts[1]\n            label = parts[-1].lower()  # last column is always bonafide/spoof\n            attack_id = parts[-2] if len(parts) >= 4 else \"-\"\n\n            filepath = audio_dir / f\"{file_name}{audio_ext}\"\n            target = CONFIG[\"label_map\"].get(label, -1)\n\n            rows.append({\n                \"speaker_id\": speaker_id,\n                \"file_name\": file_name,\n                \"filepath\": str(filepath),\n                \"attack_id\": attack_id,\n                \"label\": label,\n                \"target\": target,\n            })\n\n    df = pd.DataFrame(rows)\n    df = df[df[\"target\"] != -1].reset_index(drop=True)  # drop malformed rows\n    return df\n\n\ndef load_splits(protocol_paths: Dict[str, Path],\n                 audio_dir: Path,\n                 audio_ext: str) -> Dict[str, pd.DataFrame]:\n    '''Load train/dev/eval protocol DataFrames, printing class balance summaries.'''\n    splits = {}\n    for split_name, path in protocol_paths.items():\n        df = read_asvspoof_protocol(path, audio_dir, audio_ext)\n        splits[split_name] = df\n        if len(df) > 0:\n            counts = df[\"label\"].value_counts().to_dict()\n            print(f\"[{split_name.upper():5s}] {len(df):>7d} utterances | class balance: {counts}\")\n        else:\n            print(f\"[{split_name.upper():5s}] 0 utterances found — check DATA_ROOT / protocol path.\")\n    return splits\n\n\nsplits = load_splits(PROTOCOL_PATHS, AUDIO_DIR, AUDIO_EXTENSION)\ntrain_df, dev_df, eval_df = splits[\"train\"], splits[\"dev\"], splits[\"eval\"]\ntrain_df.head()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.314829Z","iopub.execute_input":"2026-08-14T17:34:25.315097Z","iopub.status.idle":"2026-08-14T17:34:25.341556Z","shell.execute_reply.started":"2026-08-14T17:34:25.315071Z","shell.execute_reply":"2026-08-14T17:34:25.340819Z"}},"outputs":[{"name":"stdout","text":"[TRAIN] 0 utterances found — check DATA_ROOT / protocol path.\n[DEV  ] 0 utterances found — check DATA_ROOT / protocol path.\n[EVAL ] 0 utterances found — check DATA_ROOT / protocol path.\n","output_type":"stream"},{"execution_count":15,"output_type":"execute_result","data":{"text/plain":"Empty DataFrame\nColumns: [speaker_id, file_name, filepath, attack_id, label, target]\nIndex: []","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>speaker_id</th>\n      <th>file_name</th>\n      <th>filepath</th>\n      <th>attack_id</th>\n      <th>label</th>\n      <th>target</th>\n    </tr>\n  </thead>\n  <tbody>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":15},{"id":"b8ed64a5-03bb-4a96-b8ab-a7a2d00c68e3","cell_type":"code","source":"# ==============================================================\n# Cell 8: Dataset class\n# ==============================================================\nclass ASVspoofDataset(Dataset):\n    '''PyTorch Dataset for ASVspoof2024 bonafide/spoof audio classification.\n\n    Loads raw waveforms, resamples to the target sample rate, and (optionally)\n    applies VAD + waveform-level augmentation. Feature extraction (log-mel) is\n    performed downstream in the collate function / training loop for flexibility.\n\n    Args:\n        df: DataFrame with columns ['filepath', 'target'] as produced by\n            `read_asvspoof_protocol`.\n        config: Global CONFIG dictionary.\n        train: If True, waveform augmentations may be applied.\n        apply_vad_fn: Optional callable(waveform, sr) -> waveform, used to strip silence.\n    '''\n\n    def __init__(self,\n                 df: pd.DataFrame,\n                 config: Dict[str, Any],\n                 train: bool = False,\n                 apply_vad_fn: Optional[Any] = None):\n        self.df = df.reset_index(drop=True)\n        self.config = config\n        self.train = train\n        self.apply_vad_fn = apply_vad_fn\n        self.sample_rate = config[\"sample_rate\"]\n        self.max_len = int(config[\"max_audio_seconds\"] * self.sample_rate)\n\n    def __len__(self) -> int:\n        return len(self.df)\n\n    def _load_waveform(self, filepath: str) -> torch.Tensor:\n        '''Load an audio file and resample to the target sample rate (mono).'''\n        waveform, sr = torchaudio.load(filepath)\n        if waveform.shape[0] > 1:\n            waveform = waveform.mean(dim=0, keepdim=True)  # downmix to mono\n        if sr != self.sample_rate:\n            resampler = T.Resample(orig_freq=sr, new_freq=self.sample_rate)\n            waveform = resampler(waveform)\n        return waveform.squeeze(0)  # (T,)\n\n    def _fix_length(self, waveform: torch.Tensor) -> torch.Tensor:\n        '''Center-pad or randomly-crop/trim waveform to a fixed length.'''\n        length = waveform.shape[0]\n        if length >= self.max_len:\n            if self.train:\n                start = random.randint(0, length - self.max_len)\n            else:\n                start = (length - self.max_len) // 2\n            waveform = waveform[start:start + self.max_len]\n        else:\n            pad = self.max_len - length\n            waveform = F.pad(waveform, (0, pad))\n        return waveform\n\n    def __getitem__(self, idx: int) -> Dict[str, Any]:\n        row = self.df.iloc[idx]\n        filepath = row[\"filepath\"]\n        target = int(row[\"target\"])\n\n        try:\n            waveform = self._load_waveform(filepath)\n        except Exception as e:\n            warnings.warn(f\"Failed to load {filepath}: {e}. Returning silence.\")\n            waveform = torch.zeros(self.max_len)\n\n        if self.config.get(\"use_vad\", True) and self.apply_vad_fn is not None:\n            waveform = self.apply_vad_fn(waveform, self.sample_rate)\n\n        waveform = self._fix_length(waveform)\n\n        return {\n            \"waveform\": waveform,\n            \"target\": torch.tensor(target, dtype=torch.long),\n            \"filepath\": filepath,\n        }\n\n\ndef collate_fn(batch: List[Dict[str, Any]]) -> Dict[str, Any]:\n    '''Collate a list of dataset samples into a batch.'''\n    waveforms = torch.stack([b[\"waveform\"] for b in batch], dim=0)\n    targets = torch.stack([b[\"target\"] for b in batch], dim=0)\n    filepaths = [b[\"filepath\"] for b in batch]\n    return {\"waveform\": waveforms, \"target\": targets, \"filepath\": filepaths}\n\nprint(\"[INFO] ASVspoofDataset and collate_fn defined.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.34263Z","iopub.execute_input":"2026-08-14T17:34:25.343019Z","iopub.status.idle":"2026-08-14T17:34:25.358602Z","shell.execute_reply.started":"2026-08-14T17:34:25.342996Z","shell.execute_reply":"2026-08-14T17:34:25.35787Z"}},"outputs":[{"name":"stdout","text":"[INFO] ASVspoofDataset and collate_fn defined.\n","output_type":"stream"}],"execution_count":16},{"id":"cf571dc5-7d0b-4226-ba7d-952e54073234","cell_type":"code","source":"# ==============================================================\n# Cell 9: DataLoaders\n# ==============================================================\ndef build_dataloaders(train_df: pd.DataFrame,\n                       dev_df: pd.DataFrame,\n                       eval_df: pd.DataFrame,\n                       config: Dict[str, Any],\n                       vad_fn: Optional[Any] = None) -> Dict[str, DataLoader]:\n    '''Construct train/dev/eval DataLoaders from protocol DataFrames.'''\n    train_ds = ASVspoofDataset(train_df, config, train=True, apply_vad_fn=vad_fn)\n    dev_ds = ASVspoofDataset(dev_df, config, train=False, apply_vad_fn=vad_fn)\n    eval_ds = ASVspoofDataset(eval_df, config, train=False, apply_vad_fn=vad_fn)\n\n    loaders = {\n        \"train\": DataLoader(train_ds, batch_size=config[\"batch_size\"], shuffle=True,\n                             num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n                             pin_memory=True, drop_last=True),\n        \"dev\": DataLoader(dev_ds, batch_size=config[\"batch_size\"], shuffle=False,\n                           num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n                           pin_memory=True),\n        \"eval\": DataLoader(eval_ds, batch_size=config[\"batch_size\"], shuffle=False,\n                            num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n                            pin_memory=True),\n    }\n    for name, loader in loaders.items():\n        print(f\"[{name.upper():5s}] {len(loader.dataset)} samples -> {len(loader)} batches \"\n              f\"(batch_size={config['batch_size']})\")\n    return loaders\n\n# NOTE: dataloaders are (re)built in Cell 10 once the VAD function is available,\n# so that VAD can be applied inside the Dataset.","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.359503Z","iopub.execute_input":"2026-08-14T17:34:25.359863Z","iopub.status.idle":"2026-08-14T17:34:25.375126Z","shell.execute_reply.started":"2026-08-14T17:34:25.359832Z","shell.execute_reply":"2026-08-14T17:34:25.374481Z"}},"outputs":[],"execution_count":17},{"id":"45c147ab-d65a-42dd-b4bd-d0761cc6c32b","cell_type":"code","source":"# ==============================================================\n# Cell 10: Voice Activity Detection (VAD)\n# ==============================================================\nclass EnergyVAD:\n    '''Lightweight, dependency-free energy-based Voice Activity Detector.\n\n    Splits the waveform into fixed-length frames, computes per-frame log-energy,\n    and keeps only frames above an adaptive threshold. This avoids a hard\n    dependency on `webrtcvad` while still removing leading/trailing/inner silence,\n    which is important for anti-spoofing since silence padding can leak\n    recording-device / dataset artifacts unrelated to the bonafide/spoof decision.\n\n    Args:\n        sample_rate: Audio sample rate in Hz.\n        frame_ms: Frame length in milliseconds used for energy computation.\n        threshold_db: Frames with energy below (max_energy_db + threshold_db) are dropped.\n    '''\n\n    def __init__(self, sample_rate: int = 16000, frame_ms: int = 30, threshold_db: float = -35.0):\n        self.sample_rate = sample_rate\n        self.frame_len = int(sample_rate * frame_ms / 1000)\n        self.threshold_db = threshold_db\n\n    def __call__(self, waveform: torch.Tensor, sample_rate: int) -> torch.Tensor:\n        '''Remove non-speech (low-energy) frames from a waveform.\n\n        Args:\n            waveform: 1D tensor of shape (T,).\n            sample_rate: Sample rate of `waveform` (assumed to match self.sample_rate).\n\n        Returns:\n            1D tensor containing only the speech-active frames concatenated together.\n            Falls back to the original waveform if VAD would remove everything.\n        '''\n        wav = waveform.numpy()\n        n_frames = max(1, len(wav) // self.frame_len)\n        frames = [wav[i * self.frame_len:(i + 1) * self.frame_len] for i in range(n_frames)]\n\n        energies_db = []\n        for fr in frames:\n            energy = np.mean(fr ** 2) + 1e-10\n            energies_db.append(10 * np.log10(energy))\n        energies_db = np.array(energies_db)\n\n        if len(energies_db) == 0:\n            return waveform\n\n        max_db = energies_db.max()\n        active_mask = energies_db >= (max_db + self.threshold_db)\n\n        if active_mask.sum() == 0:\n            # Nothing passed the threshold -> keep original audio rather than return silence.\n            return waveform\n\n        active_frames = [frames[i] for i in range(len(frames)) if active_mask[i]]\n        active_wav = np.concatenate(active_frames)\n        return torch.from_numpy(active_wav).float()\n\n\nclass WebRTCVAD:\n    '''Wrapper around the `webrtcvad` library (optional dependency).\n\n    Falls back gracefully to EnergyVAD if `webrtcvad` is not installed.\n    '''\n\n    def __init__(self, sample_rate: int = 16000, frame_ms: int = 30, aggressiveness: int = 2):\n        self.sample_rate = sample_rate\n        self.frame_ms = frame_ms\n        self.frame_len = int(sample_rate * frame_ms / 1000)\n        try:\n            import webrtcvad\n            self.vad = webrtcvad.Vad(aggressiveness)\n            self.available = True\n        except ImportError:\n            warnings.warn(\"webrtcvad not installed; falling back to EnergyVAD.\")\n            self.available = False\n            self._fallback = EnergyVAD(sample_rate, frame_ms)\n\n    def __call__(self, waveform: torch.Tensor, sample_rate: int) -> torch.Tensor:\n        if not self.available:\n            return self._fallback(waveform, sample_rate)\n\n        wav_int16 = (waveform.numpy() * 32768.0).astype(np.int16)\n        n_frames = len(wav_int16) // self.frame_len\n        active_frames = []\n        for i in range(n_frames):\n            frame_bytes = wav_int16[i * self.frame_len:(i + 1) * self.frame_len].tobytes()\n            if len(frame_bytes) < self.frame_len * 2:\n                continue\n            if self.vad.is_speech(frame_bytes, self.sample_rate):\n                active_frames.append(wav_int16[i * self.frame_len:(i + 1) * self.frame_len])\n\n        if len(active_frames) == 0:\n            return waveform\n\n        active_wav = np.concatenate(active_frames).astype(np.float32) / 32768.0\n        return torch.from_numpy(active_wav)\n\n\n# Instantiate the VAD used throughout the pipeline (energy-based by default; robust, no extra deps).\nvad_fn = EnergyVAD(\n    sample_rate=CONFIG[\"sample_rate\"],\n    frame_ms=CONFIG[\"vad_frame_ms\"],\n    threshold_db=CONFIG[\"vad_energy_threshold_db\"],\n) if CONFIG[\"use_vad\"] else None\n\n# Now that vad_fn exists, build the real dataloaders.\ndataloaders = build_dataloaders(train_df, dev_df, eval_df, CONFIG, vad_fn=vad_fn)\nprint(\"[INFO] VAD module ready:\", type(vad_fn).__name__ if vad_fn else \"disabled\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.376081Z","iopub.execute_input":"2026-08-14T17:34:25.376348Z","iopub.status.idle":"2026-08-14T17:34:25.399502Z","shell.execute_reply.started":"2026-08-14T17:34:25.376329Z","shell.execute_reply":"2026-08-14T17:34:25.397697Z"}},"outputs":[{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mValueError\u001b[0m                                Traceback (most recent call last)","\u001b[0;32m