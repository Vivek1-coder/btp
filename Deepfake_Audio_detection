      <td>0</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>D_3074</td>\n","      <td>D_0000000148</td>\n","      <td>/kaggle/input/datasets/ulianazb/asvspoof-2024/...</td>\n","      <td>A12</td>\n","      <td>spoof</td>\n","      <td>0</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>D_4461</td>\n","      <td>D_0000000169</td>\n","      <td>/kaggle/input/datasets/ulianazb/asvspoof-2024/...</td>\n","      <td>A14</td>\n","      <td>spoof</td>\n","      <td>0</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","      <td>D_0461</td>\n","      <td>D_0000000190</td>\n","      <td>/kaggle/input/datasets/ulianazb/asvspoof-2024/...</td>\n","      <td>bonafide</td>\n","      <td>bonafide</td>\n","      <td>1</td>\n","    </tr>\n","    <tr>\n","      <th>4</th>\n","      <td>D_4579</td>\n","      <td>D_0000000211</td>\n","      <td>/kaggle/input/datasets/ulianazb/asvspoof-2024/...</td>\n","      <td>A09</td>\n","      <td>spoof</td>\n","      <td>0</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["  speaker_id     file_name                                           filepath  \\\n","0     D_0062  D_0000000001  /kaggle/input/datasets/ulianazb/asvspoof-2024/...   \n","1     D_3074  D_0000000148  /kaggle/input/datasets/ulianazb/asvspoof-2024/...   \n","2     D_4461  D_0000000169  /kaggle/input/datasets/ulianazb/asvspoof-2024/...   \n","3     D_0461  D_0000000190  /kaggle/input/datasets/ulianazb/asvspoof-2024/...   \n","4     D_4579  D_0000000211  /kaggle/input/datasets/ulianazb/asvspoof-2024/...   \n","\n","  attack_id     label  target  \n","0       A11     spoof       0  \n","1       A12     spoof       0  \n","2       A14     spoof       0  \n","3  bonafide  bonafide       1  \n","4       A09     spoof       0  "]},"metadata":{},"output_type":"display_data"}],"source":["# ==============================================================\n","# Cell 7: Read ASVspoof 5 Metadata\n","# ==============================================================\n","\n","def empty_asvspoof_df():\n","    return pd.DataFrame(\n","        columns=[\n","            \"speaker_id\",\n","            \"file_name\",\n","            \"filepath\",\n","            \"attack_id\",\n","            \"label\",\n","            \"target\",\n","        ]\n","    )\n","\n","\n","def read_asvspoof5_metadata(\n","    metadata_path: Union[str, Path],\n","    audio_dir: Union[str, Path],\n","    audio_ext: str = \".flac\",\n",") -> pd.DataFrame:\n","    \"\"\"\n","    Parse the ASVspoof 5 metadata format used in this dataset.\n","\n","    Format:\n","        SPEAKER_ID FLAC_FILE_NAME GENDER CODEC ATTACK_ID KEY\n","\n","    Examples:\n","        T_4850 T_0000000000 F - A05 spoof\n","        T_1869 T_0000000011 F - bonafide bonafide\n","\n","    The final field (KEY) is the classification label:\n","        spoof\n","        bonafide\n","    \"\"\"\n","\n","    metadata_path = Path(metadata_path)\n","    audio_dir = Path(audio_dir)\n","\n","    if not metadata_path.exists():\n","        raise FileNotFoundError(\n","            f\"Metadata file not found:\\n{metadata_path}\"\n","        )\n","\n","    if not audio_dir.exists():\n","        raise FileNotFoundError(\n","            f\"Audio directory not found:\\n{audio_dir}\"\n","        )\n","\n","    print(f\"\\n[INFO] Metadata: {metadata_path}\")\n","    print(f\"[INFO] Audio directory: {audio_dir}\")\n","\n","    rows = []\n","\n","    malformed = 0\n","    unknown_labels = 0\n","\n","    with open(metadata_path, \"r\", encoding=\"utf-8\") as f:\n","\n","        for line_number, line in enumerate(f, start=1):\n","\n","            line = line.strip()\n","\n","            if not line:\n","                continue\n","\n","            parts = line.split()\n","\n","            # --------------------------------------------------\n","            # Expected:\n","            #\n","            # 0 -> speaker_id\n","            # 1 -> file_name\n","            # 2 -> gender\n","            # 3 -> codec\n","            # 4 -> attack_id\n","            # 5 -> label\n","            # --------------------------------------------------\n","\n","            if len(parts) < 6:\n","                malformed += 1\n","\n","                if malformed <= 5:\n","                    print(\n","                        f\"[WARNING] Malformed line {line_number}: \"\n","                        f\"{line}\"\n","                    )\n","\n","                continue\n","\n","            speaker_id = parts[0]\n","            file_name = parts[1]\n","            gender = parts[2]\n","            codec = parts[3]\n","            attack_id = parts[4]\n","            label = parts[5].lower()\n","\n","            # --------------------------------------------------\n","            # Only keep bonafide/spoof\n","            # --------------------------------------------------\n","\n","            if label not in CONFIG[\"label_map\"]:\n","                unknown_labels += 1\n","                continue\n","\n","            # --------------------------------------------------\n","            # Metadata contains filename WITHOUT .flac\n","            #\n","            # T_0000000000\n","            #\n","            # Therefore:\n","            #\n","            # T_0000000000.flac\n","            # --------------------------------------------------\n","\n","            file_path = audio_dir / f\"{file_name}{audio_ext}\"\n","\n","            target = CONFIG[\"label_map\"][label]\n","\n","            rows.append({\n","                \"speaker_id\": speaker_id,\n","                \"file_name\": file_name,\n","                \"filepath\": str(file_path),\n","                \"attack_id\": attack_id,\n","                \"label\": label,\n","                \"target\": target,\n","            })\n","\n","    # ----------------------------------------------------------\n","    # Create DataFrame\n","    # ----------------------------------------------------------\n","\n","    if not rows:\n","        print(\"\\n[ERROR] No valid metadata rows were found.\")\n","\n","        print(f\"Malformed rows: {malformed}\")\n","        print(f\"Unknown labels: {unknown_labels}\")\n","\n","        return empty_asvspoof_df()\n","\n","    df = pd.DataFrame(rows)\n","\n","    # ----------------------------------------------------------\n","    # Check actual audio files\n","    # ----------------------------------------------------------\n","\n","    exists = df[\"filepath\"].map(os.path.exists)\n","\n","    print(f\"\\n[INFO] Metadata entries: {len(df):,}\")\n","\n","    print(\n","        f\"[INFO] Audio files found: \"\n","        f\"{exists.sum():,} / {len(df):,}\"\n","    )\n","\n","    # ----------------------------------------------------------\n","    # Class distribution\n","    # ----------------------------------------------------------\n","\n","    print(\n","        f\"[INFO] Class distribution: \"\n","        f\"{df['label'].value_counts().to_dict()}\"\n","    )\n","\n","    # ----------------------------------------------------------\n","    # Show missing files if any\n","    # ----------------------------------------------------------\n","\n","    if not exists.all():\n","\n","        missing = df.loc[~exists, \"filepath\"]\n","\n","        print(\n","            f\"\\n[WARNING] Missing audio files: \"\n","            f\"{len(missing):,}\"\n","        )\n","\n","        print(\"\\n[DEBUG] First 5 missing files:\")\n","\n","        for path in missing.head(5):\n","            print(f\"    {path}\")\n","\n","    return df.reset_index(drop=True)\n","\n","\n","# ==============================================================\n","# NEW (v2): Speaker-disjoint split of the `dev` protocol into\n","# `val` (used for early stopping / checkpoint selection) and\n","# `test` (held out, evaluated exactly once at the end).\n","#\n","# WHY: v1 hard-coded `eval_df` to an empty DataFrame, so the model\n","# was selected AND reported on the same `dev` split -- the\n","# confusion-matrix/ROC/per-class cell never ran at all. ASVspoof 5\n","# does not ship public eval-set labels, so we carve the held-out\n","# test set out of `dev` ourselves. Splitting by `speaker_id` (not\n","# by row) prevents the same speaker's utterances from leaking\n","# across the val/test boundary.\n","# ==============================================================\n","def split_dev_into_val_test(dev_df: pd.DataFrame, test_fraction: float,\n","                             seed: int) -> Tuple[pd.DataFrame, pd.DataFrame]:\n","    \"\"\"Group-split a DataFrame by `speaker_id` into (val_df, test_df).\"\"\"\n","    if len(dev_df) == 0:\n","        return dev_df, empty_asvspoof_df()\n","\n","    splitter = GroupShuffleSplit(n_splits=1, test_size=test_fraction, random_state=seed)\n","    val_idx, test_idx = next(splitter.split(dev_df, groups=dev_df[\"speaker_id\"]))\n","    val_df = dev_df.iloc[val_idx].reset_index(drop=True)\n","    test_df = dev_df.iloc[test_idx].reset_index(drop=True)\n","\n","    # Sanity check: no speaker should appear in both splits.\n","    overlap = set(val_df[\"speaker_id\"]) & set(test_df[\"speaker_id\"])\n","    assert len(overlap) == 0, f\"Speaker leakage between val/test: {overlap}\"\n","\n","    return val_df, test_df\n","\n","\n","# ==============================================================\n","# Load Train + Dev\n","# ==============================================================\n","\n","def load_splits(\n","    protocol_paths: Dict[str, Path],\n","    train_audio_dir: Path,\n","    dev_audio_dir: Path,\n","    audio_ext: str = \".flac\",\n",") -> Dict[str, pd.DataFrame]:\n","\n","    splits = {}\n","\n","    # ----------------------------------------------------------\n","    # TRAIN\n","    # ----------------------------------------------------------\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"TRAIN SPLIT\")\n","    print(\"=\" * 70)\n","\n","    train_df = read_asvspoof5_metadata(\n","        metadata_path=protocol_paths[\"train\"],\n","        audio_dir=train_audio_dir,\n","        audio_ext=audio_ext,\n","    )\n","\n","    splits[\"train\"] = train_df\n","\n","    # ----------------------------------------------------------\n","    # DEV (protocol) -> split into VAL (early stopping) + TEST (held out)\n","    # ----------------------------------------------------------\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"DEV SPLIT (raw, before val/test split)\")\n","    print(\"=\" * 70)\n","\n","    dev_df_raw = read_asvspoof5_metadata(\n","        metadata_path=protocol_paths[\"dev\"],\n","        audio_dir=dev_audio_dir,\n","        audio_ext=audio_ext,\n","    )\n","\n","    val_df, test_df = split_dev_into_val_test(\n","        dev_df_raw, test_fraction=CONFIG[\"test_fraction_of_speakers\"], seed=CONFIG[\"seed\"]\n","    )\n","\n","    print(f\"\\n[INFO] Speaker-disjoint split of `dev`: \"\n","          f\"val={len(val_df):,} rows / {val_df['speaker_id'].nunique() if len(val_df) else 0} speakers, \"\n","          f\"test={len(test_df):,} rows / {test_df['speaker_id'].nunique() if len(test_df) else 0} speakers\")\n","    if len(val_df):\n","        print(f\"[INFO] val class distribution:  {val_df['label'].value_counts().to_dict()}\")\n","    if len(test_df):\n","        print(f\"[INFO] test class distribution: {test_df['label'].value_counts().to_dict()}\")\n","\n","    splits[\"dev\"] = val_df    # kept as \"dev\" for backward compatibility with the rest of the notebook (= validation set)\n","    splits[\"eval\"] = test_df  # CHANGED: no longer hard-coded empty -- this is now the real held-out test set\n","\n","    # ----------------------------------------------------------\n","    # Summary\n","    # ----------------------------------------------------------\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"DATASET SUMMARY\")\n","    print(\"=\" * 70)\n","\n","    print(f\"Train : {len(train_df):,}\")\n","    print(f\"Val   : {len(val_df):,}   (early stopping / checkpoint selection)\")\n","    print(f\"Test  : {len(test_df):,}   (held out, evaluated once at the end)\")\n","\n","    return splits\n","\n","\n","# ==============================================================\n","# Build DataFrames\n","# ==============================================================\n","\n","splits = load_splits(\n","    protocol_paths=PROTOCOL_PATHS,\n","    train_audio_dir=TRAIN_AUDIO_DIR,\n","    dev_audio_dir=DEV_AUDIO_DIR,\n","    audio_ext=AUDIO_EXTENSION,\n",")\n","\n","train_df = splits[\"train\"]\n","dev_df = splits[\"dev\"]     # validation set (speaker-disjoint subset of the original `dev` protocol)\n","eval_df = splits[\"eval\"]   # held-out test set (the other speaker-disjoint subset)\n","\n","\n","# ==============================================================\n","# Sanity Check\n","# ==============================================================\n","\n","if len(train_df) == 0:\n","    raise RuntimeError(\n","        \"Training DataFrame is empty. \"\n","        \"Check metadata and audio paths.\"\n","    )\n","\n","if len(dev_df) == 0:\n","    raise RuntimeError(\n","        \"Validation DataFrame is empty. \"\n","        \"Check metadata and audio paths.\"\n","    )\n","\n","if len(eval_df) == 0:\n","    warnings.warn(\n","        \"Held-out test DataFrame is empty -- confusion matrix / per-class \"\n","        \"report at the end of the notebook will be skipped. Check \"\n","        \"`test_fraction_of_speakers` and the dev metadata.\"\n","    )\n","\n","print(\"\\n[INFO] Train sample:\")\n","display(train_df.head())\n","\n","print(\"\\n[INFO] Val sample:\")\n","display(dev_df.head())\n","\n","print(\"\\n[INFO] Test sample:\")\n","display(eval_df.head())\n"]},{"cell_type":"code","execution_count":7,"id":"de3d9575","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:30:34.654397Z","iopub.status.busy":"2026-08-17T06:30:34.654086Z","iopub.status.idle":"2026-08-17T06:30:34.666296Z","shell.execute_reply":"2026-08-17T06:30:34.66547Z"},"papermill":{"duration":0.034829,"end_time":"2026-08-17T06:30:34.667929+00:00","exception":false,"start_time":"2026-08-17T06:30:34.6331+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] ASVspoofDataset and collate_fn defined (v2: augmentation now applied inside __getitem__).\n"]}],"source":["# ==============================================================\n","# Cell 8: Dataset class\n","# ==============================================================\n","class ASVspoofDataset(Dataset):\n","    '''PyTorch Dataset for ASVspoof2024/5 bonafide/spoof audio classification.\n","\n","    Loads raw waveforms, resamples to the target sample rate, and (optionally)\n","    applies VAD + waveform-level augmentation. Feature extraction (log-mel) is\n","    performed downstream in the collate function / training loop for flexibility.\n","\n","    CHANGED (v2): waveform augmentation now happens HERE, inside `__getitem__`,\n","    instead of after the DataLoader has already collated a batch on the main\n","    process. This lets PyTorch's `num_workers` parallelize the (slow) librosa\n","    pitch-shift/time-stretch calls across worker processes instead of running\n","    them serially in the training loop, which was the dominant cost behind the\n","    ~72 min/epoch observed in v1.\n","\n","    Args:\n","        df: DataFrame with columns ['filepath', 'target'] as produced by\n","            `read_asvspoof_protocol`.\n","        config: Global CONFIG dictionary.\n","        train: If True, waveform augmentations may be applied.\n","        apply_vad_fn: Optional callable(waveform, sr) -> waveform, used to strip silence.\n","        augmenter: Optional WaveformAugmenter, applied only when `train=True`.\n","    '''\n","\n","    def __init__(self,\n","                 df: pd.DataFrame,\n","                 config: Dict[str, Any],\n","                 train: bool = False,\n","                 apply_vad_fn: Optional[Any] = None,\n","                 augmenter: Optional[Any] = None):\n","        self.df = df.reset_index(drop=True)\n","        self.config = config\n","        self.train = train\n","        self.apply_vad_fn = apply_vad_fn\n","        self.augmenter = augmenter  # NEW\n","        self.sample_rate = config[\"sample_rate\"]\n","        self.max_len = int(config[\"max_audio_seconds\"] * self.sample_rate)\n","\n","    def __len__(self) -> int:\n","        return len(self.df)\n","\n","    def _load_waveform(self, filepath: str) -> torch.Tensor:\n","        '''Load an audio file and resample to the target sample rate (mono).'''\n","        waveform, sr = torchaudio.load(filepath)\n","        if waveform.shape[0] > 1:\n","            waveform = waveform.mean(dim=0, keepdim=True)  # downmix to mono\n","        if sr != self.sample_rate:\n","            resampler = T.Resample(orig_freq=sr, new_freq=self.sample_rate)\n","            waveform = resampler(waveform)\n","        return waveform.squeeze(0)  # (T,)\n","\n","    def _fix_length(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''Center-pad or randomly-crop/trim waveform to a fixed length.'''\n","        length = waveform.shape[0]\n","        if length >= self.max_len:\n","            if self.train:\n","                start = random.randint(0, length - self.max_len)\n","            else:\n","                start = (length - self.max_len) // 2\n","            waveform = waveform[start:start + self.max_len]\n","        else:\n","            pad = self.max_len - length\n","            waveform = F.pad(waveform, (0, pad))\n","        return waveform\n","\n","    def __getitem__(self, idx: int) -> Dict[str, Any]:\n","        row = self.df.iloc[idx]\n","        filepath = row[\"filepath\"]\n","        target = int(row[\"target\"])\n","\n","        try:\n","            waveform = self._load_waveform(filepath)\n","        except Exception as e:\n","            warnings.warn(f\"Failed to load {filepath}: {e}. Returning silence.\")\n","            waveform = torch.zeros(self.max_len)\n","\n","        if self.config.get(\"use_vad\", True) and self.apply_vad_fn is not None:\n","            waveform = self.apply_vad_fn(waveform, self.sample_rate)\n","\n","        # NEW (v2): waveform-level augmentation, applied per-sample inside the\n","        # (parallelizable) Dataset instead of per-batch in the training loop.\n","        if self.train and self.config.get(\"use_augmentation\", False) and self.augmenter is not None:\n","            waveform = self.augmenter(waveform)\n","\n","        waveform = self._fix_length(waveform)\n","\n","        return {\n","            \"waveform\": waveform,\n","            \"target\": torch.tensor(target, dtype=torch.long),\n","            \"filepath\": filepath,\n","        }\n","\n","\n","def collate_fn(batch: List[Dict[str, Any]]) -> Dict[str, Any]:\n","    '''Collate a list of dataset samples into a batch.'''\n","    waveforms = torch.stack([b[\"waveform\"] for b in batch], dim=0)\n","    targets = torch.stack([b[\"target\"] for b in batch], dim=0)\n","    filepaths = [b[\"filepath\"] for b in batch]\n","    return {\"waveform\": waveforms, \"target\": targets, \"filepath\": filepaths}\n","\n","print(\"[INFO] ASVspoofDataset and collate_fn defined (v2: augmentation now applied inside __getitem__).\")\n"]},{"cell_type":"code","execution_count":8,"id":"e0e3d27c","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:30:34.709775Z","iopub.status.busy":"2026-08-17T06:30:34.709312Z","iopub.status.idle":"2026-08-17T06:30:34.717643Z","shell.execute_reply":"2026-08-17T06:30:34.717013Z"},"papermill":{"duration":0.030833,"end_time":"2026-08-17T06:30:34.719019+00:00","exception":false,"start_time":"2026-08-17T06:30:34.688186+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ==============================================================\n","# Cell 9: DataLoaders\n","# ==============================================================\n","def build_dataloaders(train_df: pd.DataFrame,\n","                       dev_df: pd.DataFrame,\n","                       eval_df: pd.DataFrame,\n","                       config: Dict[str, Any],\n","                       vad_fn: Optional[Any] = None,\n","                       augmenter: Optional[Any] = None) -> Dict[str, DataLoader]:\n","    '''Construct train/dev(=val)/eval(=test) DataLoaders from protocol DataFrames.\n","\n","    CHANGED (v2):\n","      - `augmenter` is now passed into the *train* Dataset only (see Cell 8),\n","        instead of being applied post-hoc in the training loop.\n","      - The train loader now optionally uses a `WeightedRandomSampler` built\n","        from inverse class frequency, which is the primary fix for class\n","        imbalance in this notebook (replacing v1's loss-level class weights,\n","        see CONFIG[\"use_weighted_sampler\"] / CONFIG[\"use_loss_class_weights\"]\n","        and Cell 1 for the reasoning).\n","    '''\n","    train_ds = ASVspoofDataset(train_df, config, train=True, apply_vad_fn=vad_fn, augmenter=augmenter)\n","    dev_ds = ASVspoofDataset(dev_df, config, train=False, apply_vad_fn=vad_fn)\n","    eval_ds = ASVspoofDataset(eval_df, config, train=False, apply_vad_fn=vad_fn)\n","\n","    # ---- NEW: weighted sampler for the train loader (class-imbalance fix) ----\n","    train_sampler = None\n","    shuffle_train = True\n","    if config.get(\"use_weighted_sampler\", False) and len(train_df) > 0:\n","        class_counts = train_df[\"target\"].value_counts().sort_index()\n","        # inverse-frequency weight per class, then map to a per-sample weight\n","        class_weight_map = (1.0 / class_counts).to_dict()\n","        sample_weights = train_df[\"target\"].map(class_weight_map).values.astype(np.float64)\n","        train_sampler = WeightedRandomSampler(\n","            weights=torch.as_tensor(sample_weights, dtype=torch.double),\n","            num_samples=len(sample_weights),\n","            replacement=True,\n","        )\n","        shuffle_train = False  # `sampler` and `shuffle` are mutually exclusive in DataLoader\n","\n","    loaders = {\n","        \"train\": DataLoader(train_ds, batch_size=config[\"batch_size\"],\n","                             shuffle=shuffle_train, sampler=train_sampler,\n","                             num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n","                             pin_memory=True, drop_last=True,\n","                             persistent_workers=config[\"num_workers\"] > 0),\n","        \"dev\": DataLoader(dev_ds, batch_size=config[\"batch_size\"], shuffle=False,\n","                           num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n","                           pin_memory=True, persistent_workers=config[\"num_workers\"] > 0),\n","        \"eval\": DataLoader(eval_ds, batch_size=config[\"batch_size\"], shuffle=False,\n","                            num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n","                            pin_memory=True, persistent_workers=config[\"num_workers\"] > 0),\n","    }\n","    for name, loader in loaders.items():\n","        print(f\"[{name.upper():5s}] {len(loader.dataset)} samples -> {len(loader)} batches \"\n","              f\"(batch_size={config['batch_size']})\")\n","    if train_sampler is not None:\n","        print(\"[INFO] Train loader uses a WeightedRandomSampler (inverse class frequency).\")\n","    return loaders\n","\n","# NOTE: dataloaders are (re)built further below, once both the VAD function\n","# (Cell 9) and the waveform augmenter (Cell 11) are available, since the train\n","# Dataset now needs the augmenter at construction time.\n"]},{"cell_type":"code","execution_count":9,"id":"321ddad6","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:30:34.762389Z","iopub.status.busy":"2026-08-17T06:30:34.76183Z","iopub.status.idle":"2026-08-17T06:30:34.773937Z","shell.execute_reply":"2026-08-17T06:30:34.773322Z"},"papermill":{"duration":0.037156,"end_time":"2026-08-17T06:30:34.775744+00:00","exception":false,"start_time":"2026-08-17T06:30:34.738588+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] VAD module ready: EnergyVAD\n"]}],"source":["# ==============================================================\n","# Cell 10: Voice Activity Detection (VAD)\n","# ==============================================================\n","class EnergyVAD:\n","    '''Lightweight, dependency-free energy-based Voice Activity Detector.\n","\n","    Splits the waveform into fixed-length frames, computes per-frame log-energy,\n","    and keeps only frames above an adaptive threshold. This avoids a hard\n","    dependency on `webrtcvad` while still removing leading/trailing/inner silence,\n","    which is important for anti-spoofing since silence padding can leak\n","    recording-device / dataset artifacts unrelated to the bonafide/spoof decision.\n","\n","    Args:\n","        sample_rate: Audio sample rate in Hz.\n","        frame_ms: Frame length in milliseconds used for energy computation.\n","        threshold_db: Frames with energy below (max_energy_db + threshold_db) are dropped.\n","    '''\n","\n","    def __init__(self, sample_rate: int = 16000, frame_ms: int = 30, threshold_db: float = -35.0):\n","        self.sample_rate = sample_rate\n","        self.frame_len = int(sample_rate * frame_ms / 1000)\n","        self.threshold_db = threshold_db\n","\n","    def __call__(self, waveform: torch.Tensor, sample_rate: int) -> torch.Tensor:\n","        '''Remove non-speech (low-energy) frames from a waveform.\n","\n","        Args:\n","            waveform: 1D tensor of shape (T,).\n","            sample_rate: Sample rate of `waveform` (assumed to match self.sample_rate).\n","\n","        Returns:\n","            1D tensor containing only the speech-active frames concatenated together.\n","            Falls back to the original waveform if VAD would remove everything.\n","        '''\n","        wav = waveform.numpy()\n","        n_frames = max(1, len(wav) // self.frame_len)\n","        frames = [wav[i * self.frame_len:(i + 1) * self.frame_len] for i in range(n_frames)]\n","\n","        energies_db = []\n","        for fr in frames:\n","            energy = np.mean(fr ** 2) + 1e-10\n","            energies_db.append(10 * np.log10(energy))\n","        energies_db = np.array(energies_db)\n","\n","        if len(energies_db) == 0:\n","            return waveform\n","\n","        max_db = energies_db.max()\n","        active_mask = energies_db >= (max_db + self.threshold_db)\n","\n","        if active_mask.sum() == 0:\n","            # Nothing passed the threshold -> keep original audio rather than return silence.\n","            return waveform\n","\n","        active_frames = [frames[i] for i in range(len(frames)) if active_mask[i]]\n","        active_wav = np.concatenate(active_frames)\n","        return torch.from_numpy(active_wav).float()\n","\n","\n","class WebRTCVAD:\n","    '''Wrapper around the `webrtcvad` library (optional dependency).\n","\n","    Falls back gracefully to EnergyVAD if `webrtcvad` is not installed.\n","    '''\n","\n","    def __init__(self, sample_rate: int = 16000, frame_ms: int = 30, aggressiveness: int = 2):\n","        self.sample_rate = sample_rate\n","        self.frame_ms = frame_ms\n","        self.frame_len = int(sample_rate * frame_ms / 1000)\n","        try:\n","            import webrtcvad\n","            self.vad = webrtcvad.Vad(aggressiveness)\n","            self.available = True\n","        except ImportError:\n","            warnings.warn(\"webrtcvad not installed; falling back to EnergyVAD.\")\n","            self.available = False\n","            self._fallback = EnergyVAD(sample_rate, frame_ms)\n","\n","    def __call__(self, waveform: torch.Tensor, sample_rate: int) -> torch.Tensor:\n","        if not self.available:\n","            return self._fallback(waveform, sample_rate)\n","\n","        wav_int16 = (waveform.numpy() * 32768.0).astype(np.int16)\n","        n_frames = len(wav_int16) // self.frame_len\n","        active_frames = []\n","        for i in range(n_frames):\n","            frame_bytes = wav_int16[i * self.frame_len:(i + 1) * self.frame_len].tobytes()\n","            if len(frame_bytes) < self.frame_len * 2:\n","                continue\n","            if self.vad.is_speech(frame_bytes, self.sample_rate):\n","                active_frames.append(wav_int16[i * self.frame_len:(i + 1) * self.frame_len])\n","\n","        if len(active_frames) == 0:\n","            return waveform\n","\n","        active_wav = np.concatenate(active_frames).astype(np.float32) / 32768.0\n","        return torch.from_numpy(active_wav)\n","\n","\n","# Instantiate the VAD used throughout the pipeline (energy-based by default; robust, no extra deps).\n","vad_fn = EnergyVAD(\n","    sample_rate=CONFIG[\"sample_rate\"],\n","    frame_ms=CONFIG[\"vad_frame_ms\"],\n","    threshold_db=CONFIG[\"vad_energy_threshold_db\"],\n",") if CONFIG[\"use_vad\"] else None\n","\n","print(\"[INFO] VAD module ready:\", type(vad_fn).__name__ if vad_fn else \"disabled\")\n","# NOTE (v2): actual DataLoader construction is deferred to Cell 11, after the\n","# waveform augmenter is instantiated (the train Dataset needs it at construction time).\n"]},{"cell_type":"code","execution_count":10,"id":"6d48cb9e","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:30:34.818139Z","iopub.status.busy":"2026-08-17T06:30:34.817861Z","iopub.status.idle":"2026-08-17T06:30:35.200214Z","shell.execute_reply":"2026-08-17T06:30:35.199391Z"},"papermill":{"duration":0.405124,"end_time":"2026-08-17T06:30:35.201824+00:00","exception":false,"start_time":"2026-08-17T06:30:34.7967+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] LogMelSpectrogramExtractor ready (visualization-only; see note above).\n"]}],"source":["# ==============================================================\n","# Cell 11: Feature extraction — 80-bin Log-Mel Spectrogram\n","# ==============================================================\n","# NOTE (v2): the model itself does NOT consume this log-mel spectrogram — the\n","# SSL encoder (DistilHuBERT) is designed to take the raw waveform directly, per\n","# the HuggingFace/HuBERT convention, and the temporal CNN then operates on the\n","# SSL encoder's output. This extractor is kept purely for spectrogram\n","# visualization/EDA below (useful for sanity-checking VAD + augmentation), and\n","# is *not* dead weight in the model's forward pass to begin with, so nothing\n","# was removed here — just documented, since this was a source of confusion in\n","# v1 (the architecture diagram implied it fed the model when it did not).\n","class LogMelSpectrogramExtractor(nn.Module):\n","    '''Computes an 80-bin log-Mel spectrogram from a raw waveform batch.\n","\n","    Wraps `torchaudio.transforms.MelSpectrogram` with log-compression, and is\n","    implemented as an `nn.Module` so it moves to GPU with `.to(device)` and can\n","    be placed directly inside the model's forward pass if desired.\n","    '''\n","\n","    def __init__(self, config: Dict[str, Any]):\n","        super().__init__()\n","        self.mel_spec = T.MelSpectrogram(\n","            sample_rate=config[\"sample_rate\"],\n","            n_fft=config[\"n_fft\"],\n","            hop_length=config[\"hop_length\"],\n","            win_length=config[\"win_length\"],\n","            n_mels=config[\"n_mels\"],\n","            power=2.0,\n","        )\n","        self.amplitude_to_db = T.AmplitudeToDB(stype=\"power\", top_db=80)\n","\n","    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            waveform: (B, T) raw audio tensor.\n","\n","        Returns:\n","            (B, n_mels, frames) log-mel spectrogram tensor.\n","        '''\n","        mel = self.mel_spec(waveform)           # (B, n_mels, frames)\n","        log_mel = self.amplitude_to_db(mel)      # log-scaled, dB\n","        # Per-utterance normalization (zero mean, unit variance) stabilizes training.\n","        mean = log_mel.mean(dim=(-2, -1), keepdim=True)\n","        std = log_mel.std(dim=(-2, -1), keepdim=True) + 1e-6\n","        log_mel = (log_mel - mean) / std\n","        return log_mel\n","\n","\n","mel_extractor = LogMelSpectrogramExtractor(CONFIG).to(DEVICE)\n","\n","\n","def visualize_spectrograms(loader: DataLoader, extractor: nn.Module, n_examples: int = 4) -> None:\n","    '''Plot log-mel spectrograms for a handful of real and fake examples.'''\n","    batch = next(iter(loader))\n","    waveforms = batch[\"waveform\"][:n_examples].to(DEVICE)\n","    targets = batch[\"target\"][:n_examples]\n","\n","    with torch.no_grad():\n","        specs = extractor(waveforms).cpu().numpy()\n","\n","    fig, axes = plt.subplots(1, n_examples, figsize=(4 * n_examples, 4))\n","    if n_examples == 1:\n","        axes = [axes]\n","    for i, ax in enumerate(axes):\n","        label = \"Bonafide (Real)\" if targets[i].item() == 1 else \"Spoof (Fake)\"\n","        img = librosa.display.specshow(specs[i], sr=CONFIG[\"sample_rate\"],\n","                                        hop_length=CONFIG[\"hop_length\"],\n","                                        x_axis=\"time\", y_axis=\"mel\", ax=ax, cmap=\"magma\")\n","        ax.set_title(label)\n","    fig.suptitle(\"Log-Mel Spectrogram Examples (Normalized)\")\n","    plt.tight_layout()\n","    plt.savefig(os.path.join(CONFIG[\"results_dir\"], \"sample_spectrograms.png\"), dpi=150)\n","    plt.show()\n","\n","# NOTE (v2): actually calling `visualize_spectrograms` is deferred to Cell 11,\n","# after the real dataloaders (which now depend on the waveform augmenter) are built.\n","print(\"[INFO] LogMelSpectrogramExtractor ready (visualization-only; see note above).\")\n"]},{"cell_type":"code","execution_count":11,"id":"20943d5f","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:30:35.246725Z","iopub.status.busy":"2026-08-17T06:30:35.246466Z","iopub.status.idle":"2026-08-17T06:31:02.802831Z","shell.execute_reply":"2026-08-17T06:31:02.801892Z"},"papermill":{"duration":27.584803,"end_time":"2026-08-17T06:31:02.808902+00:00","exception":false,"start_time":"2026-08-17T06:30:35.224099+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] Augmentation modules ready: WaveformAugmenter (noise/pitch/stretch), SpecAugment (freq/time mask).\n","[TRAIN] 182357 samples -> 3799 batches (batch_size=48)\n","[DEV  ] 99309 samples -> 2069 batches (batch_size=48)\n","[EVAL ] 41641 samples -> 868 batches (batch_size=48)\n","[INFO] Train loader uses a WeightedRandomSampler (inverse class frequency).\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1600x400 with 4 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# ==============================================================\n","# Cell 12: Data Augmentation (SpecAugment + waveform-level augmentation)\n","# ==============================================================\n","class WaveformAugmenter:\n","    '''Waveform-level augmentations applied before feature extraction: additive\n","    noise, pitch shift, and time stretch. Each is applied stochastically.\n","\n","    CHANGED (v2): this class is unchanged in *logic*, but it is now invoked\n","    from inside `ASVspoofDataset.__getitem__` (Cell 8) instead of in a Python\n","    for-loop over the whole batch inside the training loop. Since\n","    `DataLoader(num_workers=...)` parallelizes `__getitem__` calls across\n","    worker processes, the same (slow) librosa calls no longer serialize on the\n","    main training process -- this was the dominant cost behind v1's ~72\n","    min/epoch. `pitch_shift_prob`/`time_stretch_prob` were also lowered\n","    slightly in CONFIG since those two ops remain the most expensive per-call.\n","    '''\n","\n","    def __init__(self, config: Dict[str, Any]):\n","        self.config = config\n","        self.sample_rate = config[\"sample_rate\"]\n","\n","    def add_noise(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''Add Gaussian noise at a randomly sampled SNR (dB).'''\n","        snr_low, snr_high = self.config[\"noise_snr_db_range\"]\n","        snr_db = random.uniform(snr_low, snr_high)\n","        signal_power = waveform.pow(2).mean()\n","        noise_power = signal_power / (10 ** (snr_db / 10))\n","        noise = torch.randn_like(waveform) * torch.sqrt(noise_power + 1e-12)\n","        return waveform + noise\n","\n","    def pitch_shift(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''Shift pitch by a random number of semitones using librosa.'''\n","        low, high = self.config[\"pitch_shift_semitones_range\"]\n","        n_steps = random.uniform(low, high)\n","        wav_np = waveform.numpy()\n","        shifted = librosa.effects.pitch_shift(y=wav_np, sr=self.sample_rate, n_steps=n_steps)\n","        return torch.from_numpy(shifted).float()\n","\n","    def time_stretch(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''Time-stretch the waveform and crop/pad back to the original length.'''\n","        low, high = self.config[\"time_stretch_rate_range\"]\n","        rate = random.uniform(low, high)\n","        wav_np = waveform.numpy()\n","        stretched = librosa.effects.time_stretch(y=wav_np, rate=rate)\n","        stretched = torch.from_numpy(stretched).float()\n","\n","        orig_len = waveform.shape[0]\n","        if stretched.shape[0] > orig_len:\n","            start = random.randint(0, stretched.shape[0] - orig_len)\n","            stretched = stretched[start:start + orig_len]\n","        else:\n","            stretched = F.pad(stretched, (0, orig_len - stretched.shape[0]))\n","        return stretched\n","\n","    def __call__(self, waveform: torch.Tensor) -> torch.Tensor:\n","        if random.random() < self.config[\"noise_prob\"]:\n","            waveform = self.add_noise(waveform)\n","        if random.random() < self.config[\"pitch_shift_prob\"]:\n","            waveform = self.pitch_shift(waveform)\n","        if random.random() < self.config[\"time_stretch_prob\"]:\n","            waveform = self.time_stretch(waveform)\n","        return waveform\n","\n","\n","class SpecAugment(nn.Module):\n","    '''SpecAugment: frequency masking + time masking applied to a log-mel spectrogram batch.\n","\n","    NOTE: not currently applied in the training loop, since the model does not\n","    consume the log-mel spectrogram directly (see Cell 10). Kept available for\n","    anyone who wants to add a log-mel branch to the model.\n","    '''\n","\n","    def __init__(self, config: Dict[str, Any]):\n","        super().__init__()\n","        self.freq_mask = T.FrequencyMasking(freq_mask_param=config[\"spec_freq_mask_param\"])\n","        self.time_mask = T.TimeMasking(time_mask_param=config[\"spec_time_mask_param\"])\n","\n","    def forward(self, spec: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            spec: (B, n_mels, frames) log-mel spectrogram.\n","\n","        Returns:\n","            Augmented spectrogram of the same shape.\n","        '''\n","        spec = self.freq_mask(spec)\n","        spec = self.time_mask(spec)\n","        return spec\n","\n","\n","waveform_augmenter = WaveformAugmenter(CONFIG)\n","spec_augmenter = SpecAugment(CONFIG).to(DEVICE)\n","\n","print(\"[INFO] Augmentation modules ready: WaveformAugmenter (noise/pitch/stretch), SpecAugment (freq/time mask).\")\n","\n","# ==============================================================\n","# NEW (v2): build the real dataloaders here, now that both `vad_fn` (Cell 9)\n","# and `waveform_augmenter` (this cell) exist. The train Dataset applies\n","# `waveform_augmenter` internally and in parallel across `num_workers` (see\n","# Cell 8), fixing the v1 bottleneck where augmentation ran serially in the\n","# training loop.\n","# ==============================================================\n","dataloaders = build_dataloaders(train_df, dev_df, eval_df, CONFIG, vad_fn=vad_fn, augmenter=waveform_augmenter)\n","\n","# ---- Visualize a few example spectrograms (EDA only, see Cell 10) ----\n","if len(dataloaders[\"train\"].dataset) > 0:\n","    visualize_spectrograms(dataloaders[\"train\"], mel_extractor)\n","else:\n","    print(\"[WARN] Train dataset is empty — populate DATA_ROOT with ASVspoof5 to visualize spectrograms.\")\n"]},{"cell_type":"code","execution_count":12,"id":"fd43c64b","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:31:02.884104Z","iopub.status.busy":"2026-08-17T06:31:02.883576Z","iopub.status.idle":"2026-08-17T06:31:06.017213Z","shell.execute_reply":"2026-08-17T06:31:06.016413Z"},"papermill":{"duration":3.174158,"end_time":"2026-08-17T06:31:06.01892+00:00","exception":false,"start_time":"2026-08-17T06:31:02.844762+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"2e37f9086f1945c699e1fd5fc2e4b971","version_major":2,"version_minor":0},"text/plain":["config.json: 0.00B [00:00, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"0353c2fb4f9743cdac89bf60056bda4d","version_major":2,"version_minor":0},"text/plain":["model.safetensors:   0%|          | 0.00/94.0M [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"c8bd7ec8987c4cc2a2d7d917acd11d77","version_major":2,"version_minor":0},"text/plain":["Loading weights:   0%|          | 0/49 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["[INFO] Loaded SSL encoder 'ntu-spml/distilhubert' (hidden_size=768, trainable_params=14,175,744, fully_frozen=False, unfrozen_last_n_layers=2)\n"]}],"source":["# ==============================================================\n","# Cell 13: Tiny SSL Encoder (DistilHuBERT)\n","# ==============================================================\n","class TinySSLEncoder(nn.Module):\n","    '''Tiny self-supervised speech encoder wrapping a distilled HuBERT model\n","    (DistilHuBERT) from HuggingFace. Consumes raw waveforms and outputs a\n","    sequence of contextualized frame-level embeddings.\n","\n","    CHANGED (v2), two fixes:\n","\n","    1) BUG FIX -- frozen submodule leaking into train() mode. In v1, calling\n","       the outer model's `.train()` every epoch (standard in `run_epoch`)\n","       recursively set `.train(True)` on every submodule, INCLUDING this\n","       (supposedly frozen) SSL encoder. Since HuBERT contains dropout/layer\n","       norm, this meant the \"frozen\" encoder was silently stochastic during\n","       training (dropout active) but deterministic at eval time -- a\n","       train/eval feature-distribution mismatch that likely contributed to\n","       the large train/val gap seen from epoch 1 onward. This class now\n","       overrides `.train()` so any *frozen* parameters always stay in `eval()`\n","       regardless of what the parent model requests.\n","    2) NEW -- partial fine-tuning. Rather than a binary frozen/fully-finetuned\n","       choice, the last `unfreeze_last_n_layers` transformer layers can now be\n","       unfrozen (with a small discriminative LR, see the optimizer cell) while\n","       the rest (feature extractor + early transformer layers) stays frozen.\n","       Off-the-shelf DistilHuBERT is trained for ASR-style phonetic content and\n","       may under-represent the vocoder/high-frequency artifacts that separate\n","       bonafide from spoof; a small amount of task-specific adaptation in the\n","       last layers is a common fix in the anti-spoofing literature, at a much\n","       lower compute/overfitting cost than fine-tuning the whole encoder.\n","\n","    Args:\n","        model_name: HuggingFace hub id, e.g. \"ntu-spml/distilhubert\".\n","        freeze: If True (and finetune=False and unfreeze_last_n_layers<=0), all\n","            SSL encoder parameters are frozen (no gradient).\n","        finetune: If True, unfreezes the ENTIRE SSL encoder (legacy, expensive/\n","            unstable; off by default). Overrides `freeze` and `unfreeze_last_n_layers`.\n","        unfreeze_last_n_layers: Number of trailing transformer layers to unfreeze\n","            for partial fine-tuning (ignored if `finetune=True`).\n","        sample_rate: Expected input sample rate (must match the SSL model's\n","            pretraining sample rate, typically 16 kHz).\n","    '''\n","\n","    def __init__(self,\n","                 model_name: str = \"ntu-spml/distilhubert\",\n","                 freeze: bool = True,\n","                 finetune: bool = False,\n","                 unfreeze_last_n_layers: int = 0,\n","                 sample_rate: int = 16000):\n","        super().__init__()\n","        self.sample_rate = sample_rate\n","        self.model = AutoModel.from_pretrained(model_name)\n","        self.output_dim = self.model.config.hidden_size\n","\n","        # ---- Determine which parameters get gradients ----\n","        if finetune:\n","            # Legacy behavior: unfreeze everything.\n","            for param in self.model.parameters():\n","                param.requires_grad = True\n","            self._frozen_module = None  # nothing to force back into eval()\n","        else:\n","            # Start fully frozen ...\n","            for param in self.model.parameters():\n","                param.requires_grad = False\n","            # ... then selectively unfreeze the last N transformer layers, if requested.\n","            transformer_layers = self._get_transformer_layers()\n","            if unfreeze_last_n_layers > 0 and transformer_layers is not None:\n","                n = min(unfreeze_last_n_layers, len(transformer_layers))\n","                for layer in transformer_layers[-n:]:\n","                    for param in layer.parameters():\n","                        param.requires_grad = True\n","            self._frozen_module = self.model  # the whole HF module still needs its .train() forced per-param below\n","\n","        do_freeze = freeze and not finetune\n","        self._frozen = do_freeze and unfreeze_last_n_layers <= 0\n","        self.model.train(mode=not (do_freeze and unfreeze_last_n_layers <= 0))\n","\n","    def _get_transformer_layers(self):\n","        '''Best-effort lookup of the transformer layer stack across HF model variants\n","        (HuBERT/Wav2Vec2-style models expose `model.encoder.layers`).'''\n","        encoder = getattr(self.model, \"encoder\", None)\n","        if encoder is not None and hasattr(encoder, \"layers\"):\n","            return encoder.layers\n","        return None\n","\n","    @staticmethod\n","    def _force_eval_on_frozen_subtrees(module: nn.Module) -> None:\n","        '''Recursively force `.eval()` on any subtree with zero trainable\n","        parameters, leaving subtrees that contain at least one trainable\n","        parameter untouched (so their own `.train()`/`.eval()` state -- and\n","        that of any parameter-less leaves like Dropout inside them, e.g. in an\n","        unfrozen transformer layer -- is decided by recursing one level\n","        further rather than checked in one shot). Checking `module.parameters(\n","        recurse=False)` alone (an earlier version of this fix) misses\n","        parameter-less leaves such as `nn.Dropout`, which would otherwise be\n","        silently left in train() mode.'''\n","        has_trainable = any(p.requires_grad for p in module.parameters(recurse=True))\n","        if not has_trainable:\n","            module.eval()\n","        else:\n","            for child in module.children():\n","                TinySSLEncoder._force_eval_on_frozen_subtrees(child)\n","\n","    def train(self, mode: bool = True):\n","        '''Override so that any FULLY FROZEN subtree (requires_grad=False\n","        throughout) always runs in eval() mode (fixes the v1 bug where the\n","        whole frozen encoder was flipped back into train() by the outer\n","        model's `.train()` call every epoch), while any unfrozen (partially\n","        fine-tuned) sub-layers -- including parameter-less modules like\n","        Dropout that live inside them -- still correctly switch between\n","        train/eval like normal.'''\n","        super().train(mode)\n","        if mode:\n","            self._force_eval_on_frozen_subtrees(self.model)\n","        return self\n","\n","    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            waveform: (B, T) raw audio at `self.sample_rate`.\n","\n","        Returns:\n","            (B, frames, hidden_size) contextualized SSL embeddings.\n","        '''\n","        if self._frozen:\n","            with torch.no_grad():\n","                outputs = self.model(waveform)\n","        else:\n","            outputs = self.model(waveform)\n","        return outputs.last_hidden_state  # (B, frames, hidden_size)\n","\n","\n","# Instantiate the SSL encoder (downloads pretrained weights from the HF Hub).\n","try:\n","    ssl_encoder = TinySSLEncoder(\n","        model_name=CONFIG[\"ssl_model_name\"],\n","        freeze=CONFIG[\"ssl_freeze\"],\n","        finetune=CONFIG[\"ssl_finetune\"],\n","        unfreeze_last_n_layers=CONFIG[\"ssl_unfreeze_last_n_layers\"],\n","        sample_rate=CONFIG[\"sample_rate\"],\n","    ).to(DEVICE)\n","    CONFIG[\"ssl_output_dim\"] = ssl_encoder.output_dim\n","    n_trainable = sum(p.numel() for p in ssl_encoder.parameters() if p.requires_grad)\n","    print(f\"[INFO] Loaded SSL encoder '{CONFIG['ssl_model_name']}' \"\n","          f\"(hidden_size={ssl_encoder.output_dim}, trainable_params={n_trainable:,}, \"\n","          f\"fully_frozen={ssl_encoder._frozen}, \"\n","          f\"unfrozen_last_n_layers={CONFIG['ssl_unfreeze_last_n_layers'] if not CONFIG['ssl_finetune'] else 'ALL'})\")\n","except Exception as e:\n","    print(f\"[WARN] Could not download SSL encoder weights ({e}). \"\n","          f\"Ensure internet access / the model id is correct before training.\")\n","    ssl_encoder = None\n"]},{"cell_type":"code","execution_count":13,"id":"a34c0c9a","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:31:06.077646Z","iopub.status.busy":"2026-08-17T06:31:06.0773Z","iopub.status.idle":"2026-08-17T06:31:06.10864Z","shell.execute_reply":"2026-08-17T06:31:06.107583Z"},"papermill":{"duration":0.061453,"end_time":"2026-08-17T06:31:06.110178+00:00","exception":false,"start_time":"2026-08-17T06:31:06.048725+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] Loaded CNN backbone 'temporal_cnn' (out_dim=128, total_params=1,476,480)\n"]}],"source":["# ==============================================================\n","# Cell 14: Lightweight CNN backbone\n","# ==============================================================\n","# CHANGED (v2) -- root-cause architecture fix.\n","#\n","# v1 reshaped the SSL encoder's output `(B, frames, 768)` into a single-channel\n","# \"image\" `(B, 1, frames, 768)` and ran it through an ImageNet-pretrained\n","# MobileNetV3-Small / EfficientNet-Lite0. This is an axis mismatch: 2D\n","# convolutions assume local, roughly-stationary correlation along BOTH spatial\n","# axes (as in a photo), but the SSL \"width\" axis here is just 768 arbitrary,\n","# unordered feature channels -- there is no reason neighbouring channels are\n","# more related than distant ones, so sliding a 2D kernel across that axis mixes\n","# unrelated features and destroys the sequence's real (1D, time-only)\n","# structure. It also can't benefit from ImageNet pretraining, since the input\n","# statistics are nothing like natural images.\n","#\n","# FIX: `LightweightTemporalCNN` below uses `Conv1d` over the TIME axis only,\n","# treating the 768 SSL dims as feature channels (the standard, architecturally\n","# correct way to convolve a frame-embedding sequence). It's trained from\n","# scratch -- there's no pretrained checkpoint that matches this input\n","# distribution, so nothing is lost by not using one, and this keeps the\n","# backbone small (a few hundred thousand parameters) for the \"lightweight /\n","# real-time\" design goal.\n","#\n","# The original image-based backbones are KEPT below (unused by default) purely\n","# for anyone who wants to run a controlled ablation against the v1 approach;\n","# set CONFIG[\"cnn_backbone\"] = \"mobilenetv3_small\" or \"efficientnet_lite0\" to\n","# use them, but this is not recommended given the diagnosis above.\n","\n","class LightweightTemporalCNN(nn.Module):\n","    '''1D-convolutional temporal feature extractor operating directly on the\n","    SSL frame-embedding sequence.\n","\n","    Args:\n","        in_channels: Dimensionality of each input frame embedding (SSL hidden size).\n","        channels: List of output channel counts for each Conv1d block.\n","        kernel_size: Convolution kernel size (odd, same padding).\n","        dropout: Dropout probability between conv blocks.\n","    '''\n","\n","    def __init__(self, in_channels: int, channels: List[int], kernel_size: int = 5,\n","                 dropout: float = 0.2):\n","        super().__init__()\n","        layers = []\n","        prev_c = in_channels\n","        for c in channels:\n","            layers += [\n","                nn.Conv1d(prev_c, c, kernel_size=kernel_size, padding=kernel_size // 2),\n","                nn.BatchNorm1d(c),\n","                nn.GELU(),\n","                nn.Dropout(dropout),\n","            ]\n","            prev_c = c\n","        self.conv = nn.Sequential(*layers)\n","        self.pool = nn.AdaptiveAvgPool1d(1)\n","        self.out_dim = channels[-1]\n","\n","    def forward(self, x: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            x: (B, in_channels, T) -- SSL sequence with time as the LAST axis\n","               and SSL dim as CHANNELS (the architecturally correct layout for\n","               Conv1d; see module docstring above).\n","\n","        Returns:\n","            (B, out_dim) pooled embedding.\n","        '''\n","        feats = self.conv(x)          # (B, out_channels, T)\n","        pooled = self.pool(feats)     # (B, out_channels, 1)\n","        return pooled.flatten(1)      # (B, out_channels)\n","\n","\n","class LightweightCNN(nn.Module):\n","    '''LEGACY (v1) image-based CNN feature extractor -- kept only for optional\n","    ablation against the fixed `LightweightTemporalCNN` above. See the\n","    module-level comment for why this is not the default anymore.\n","\n","    Supports:\n","      - \"mobilenetv3_small\": torchvision MobileNetV3-Small, classifier removed.\n","      - \"efficientnet_lite0\": timm EfficientNet-Lite0, classifier removed.\n","    '''\n","\n","    def __init__(self, backbone: str = \"mobilenetv3_small\", pretrained: bool = True,\n","                 in_channels: int = 1):\n","        super().__init__()\n","        self.backbone_name = backbone\n","\n","        if backbone == \"mobilenetv3_small\":\n","            net = torchvision.models.mobilenet_v3_small(\n","                weights=torchvision.models.MobileNet_V3_Small_Weights.DEFAULT if pretrained else None\n","            )\n","            old_conv = net.features[0][0]\n","            new_conv = nn.Conv2d(in_channels, old_conv.out_channels,\n","                                  kernel_size=old_conv.kernel_size, stride=old_conv.stride,\n","                                  padding=old_conv.padding, bias=False)\n","            with torch.no_grad():\n","                new_conv.weight[:] = old_conv.weight.mean(dim=1, keepdim=True).repeat(1, in_channels, 1, 1)\n","            net.features[0][0] = new_conv\n","            self.features = net.features\n","            self.pool = nn.AdaptiveAvgPool2d(1)\n","            self.out_dim = net.classifier[0].in_features\n","\n","        elif backbone == \"efficientnet_lite0\":\n","            net = timm.create_model(\"efficientnet_lite0\", pretrained=pretrained,\n","                                     in_chans=in_channels, num_classes=0, global_pool=\"avg\")\n","            self.features = net\n","            self.pool = None\n","            self.out_dim = net.num_features\n","\n","        else:\n","            raise ValueError(f\"Unknown backbone: {backbone}\")\n","\n","    def forward(self, x: torch.Tensor) -> torch.Tensor:\n","        if self.backbone_name == \"mobilenetv3_small\":\n","            feats = self.features(x)\n","            pooled = self.pool(feats)\n","            return pooled.flatten(1)\n","        else:\n","            return self.features(x)\n","\n","\n","def build_cnn_backbone(config: Dict[str, Any]) -> nn.Module:\n","    '''Factory selecting the temporal (recommended) or legacy image-based backbone.'''\n","    if config[\"cnn_backbone\"] == \"temporal_cnn\":\n","        return LightweightTemporalCNN(\n","            in_channels=config[\"ssl_output_dim\"],\n","            channels=config[\"temporal_cnn_channels\"],\n","            kernel_size=config[\"temporal_cnn_kernel_size\"],\n","            dropout=config[\"dropout\"] * 0.5,  # milder dropout inside the backbone than the classifier head\n","        )\n","    else:\n","        return LightweightCNN(\n","            backbone=config[\"cnn_backbone\"],\n","            pretrained=config[\"cnn_pretrained\"],\n","            in_channels=1,\n","        )\n","\n","\n","cnn_backbone = build_cnn_backbone(CONFIG).to(DEVICE)\n","CONFIG[\"cnn_out_dim\"] = cnn_backbone.out_dim\n","\n","n_params = sum(p.numel() for p in cnn_backbone.parameters())\n","print(f\"[INFO] Loaded CNN backbone '{CONFIG['cnn_backbone']}' \"\n","      f\"(out_dim={cnn_backbone.out_dim}, total_params={n_params:,})\")\n"]},{"cell_type":"code","execution_count":14,"id":"59cf29f4","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:31:06.163277Z","iopub.status.busy":"2026-08-17T06:31:06.163032Z","iopub.status.idle":"2026-08-17T06:31:06.173623Z","shell.execute_reply":"2026-08-17T06:31:06.17285Z"},"papermill":{"duration":0.036772,"end_time":"2026-08-17T06:31:06.175078+00:00","exception":false,"start_time":"2026-08-17T06:31:06.138306+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] Wavelet block ENABLED (db4, level=3, out_dim=128)\n"]}],"source":["# ==============================================================\n","# Cell 15: (Optional) Wavelet Block — DWT feature fusion\n","# ==============================================================\n","class WaveletBlock(nn.Module):\n","    '''Extracts multi-resolution Discrete Wavelet Transform (DWT) statistics\n","    from the raw waveform and projects them into a fixed-size embedding to be\n","    fused with the CNN embedding.\n","\n","    Motivation: vocoder-based TTS/voice-conversion artifacts often manifest as\n","    subtle high-frequency sub-band irregularities that a wavelet decomposition\n","    can expose more directly than a Mel spectrogram alone.\n","\n","    Args:\n","        wavelet_name: PyWavelets wavelet family, e.g. \"db4\".\n","        level: Number of DWT decomposition levels.\n","        out_dim: Output embedding dimensionality after projection.\n","    '''\n","\n","    def __init__(self, wavelet_name: str = \"db4\", level: int = 3, out_dim: int = 128):\n","        super().__init__()\n","        self.wavelet_name = wavelet_name\n","        self.level = level\n","        # 5 summary statistics per sub-band (mean, std, max, min, energy) x (level+1) sub-bands.\n","        n_subbands = level + 1\n","        in_dim = n_subbands * 5\n","        self.proj = nn.Sequential(\n","            nn.Linear(in_dim, out_dim),\n","            nn.GELU(),\n","            nn.LayerNorm(out_dim),\n","        )\n","        self.out_dim = out_dim\n","\n","    def _dwt_features_single(self, wav_np: np.ndarray) -> np.ndarray:\n","        '''Compute summary statistics over DWT coefficients for one waveform.'''\n","        coeffs = pywt.wavedec(wav_np, self.wavelet_name, level=self.level)\n","        feats = []\n","        for c in coeffs:\n","            c = c.astype(np.float64)\n","            feats.extend([\n","                c.mean(),\n","                c.std(),\n","                c.max() if c.size > 0 else 0.0,\n","                c.min() if c.size > 0 else 0.0,\n","                np.sum(c ** 2) / max(c.size, 1),  # average energy\n","            ])\n","        return np.array(feats, dtype=np.float32)\n","\n","    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            waveform: (B, T) raw audio tensor (CPU or GPU; DWT itself runs on CPU/numpy).\n","\n","        Returns:\n","            (B, out_dim) wavelet embedding, on the same device as `waveform`.\n","        '''\n","        device = waveform.device\n","        wav_np = waveform.detach().cpu().numpy()\n","        batch_feats = np.stack([self._dwt_features_single(w) for w in wav_np], axis=0)\n","        batch_feats = torch.from_numpy(batch_feats).float().to(device)\n","        return self.proj(batch_feats)\n","\n","\n","wavelet_block = WaveletBlock(\n","    wavelet_name=CONFIG[\"wavelet_name\"],\n","    level=CONFIG[\"wavelet_level\"],\n","    out_dim=CONFIG[\"wavelet_out_dim\"],\n",").to(DEVICE) if CONFIG[\"use_wavelet\"] else None\n","\n","print(f\"[INFO] Wavelet block {'ENABLED' if wavelet_block is not None else 'DISABLED'} \"\n","      f\"({CONFIG['wavelet_name']}, level={CONFIG['wavelet_level']}, \"\n","      f\"out_dim={CONFIG['wavelet_out_dim']})\")"]},{"cell_type":"code","execution_count":15,"id":"388187c0","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:31:06.223787Z","iopub.status.busy":"2026-08-17T06:31:06.223216Z","iopub.status.idle":"2026-08-17T06:31:06.229152Z","shell.execute_reply":"2026-08-17T06:31:06.228322Z"},"papermill":{"duration":0.031797,"end_time":"2026-08-17T06:31:06.230697+00:00","exception":false,"start_time":"2026-08-17T06:31:06.1989+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] SelfAttentionPooling defined.\n"]}],"source":["# ==============================================================\n","# Cell 16: Self-Attention Pooling\n","# ==============================================================\n","class SelfAttentionPooling(nn.Module):\n","    '''Self-attention pooling layer that collapses a sequence of frame-level\n","    embeddings into a single utterance-level embedding using a learned\n","    attention weight per frame (Lee et al., \"Self-Attentive Pooling\").\n","\n","    Args:\n","        input_dim: Dimensionality of each frame embedding.\n","        hidden_dim: Hidden size of the attention scoring MLP.\n","    '''\n","\n","    def __init__(self, input_dim: int, hidden_dim: int = 128):\n","        super().__init__()\n","        self.attention = nn.Sequential(\n","            nn.Linear(input_dim, hidden_dim),\n","            nn.Tanh(),\n","            nn.Linear(hidden_dim, 1),\n","        )\n","\n","    def forward(self, x: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            x: (B, T, D) sequence of frame embeddings.\n","\n","        Returns:\n","            (B, D) attention-weighted utterance embedding.\n","        '''\n","        scores = self.attention(x)                 # (B, T, 1)\n","        weights = torch.softmax(scores, dim=1)      # (B, T, 1)\n","        pooled = torch.sum(weights * x, dim=1)      # (B, D)\n","        return pooled\n","\n","print(\"[INFO] SelfAttentionPooling defined.\")"]},{"cell_type":"code","execution_count":16,"id":"47ff5edf","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:31:06.279745Z","iopub.status.busy":"2026-08-17T06:31:06.279035Z","iopub.status.idle":"2026-08-17T06:31:06.284754Z","shell.execute_reply":"2026-08-17T06:31:06.284129Z"},"papermill":{"duration":0.031914,"end_time":"2026-08-17T06:31:06.286224+00:00","exception":false,"start_time":"2026-08-17T06:31:06.25431+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] ClassifierHead defined (v2: Dropout moved after GELU).\n"]}],"source":["# ==============================================================\n","# Cell 17: Classifier Head\n","# ==============================================================\n","class ClassifierHead(nn.Module):\n","    '''Final MLP classifier head: Linear -> GELU -> Dropout -> Linear -> logits.\n","\n","    CHANGED (v2): reordered to Linear -> GELU -> Dropout -> Linear (was\n","    Linear -> Dropout -> GELU -> Linear in v1). Applying dropout to raw,\n","    pre-activation linear outputs is unusual and slightly weakens its\n","    regularizing effect; the conventional placement is after the nonlinearity,\n","    which is what's used here. Minor fix, but free and consistent with common\n","    practice.\n","\n","    Args:\n","        input_dim: Dimensionality of the fused utterance embedding.\n","        hidden_dim: Hidden layer width.\n","        num_classes: Number of output classes (2 for real/fake).\n","        dropout: Dropout probability.\n","    '''\n","\n","    def __init__(self, input_dim: int, hidden_dim: int = 256,\n","                 num_classes: int = 2, dropout: float = 0.3):\n","        super().__init__()\n","        self.net = nn.Sequential(\n","            nn.Linear(input_dim, hidden_dim),\n","            nn.GELU(),\n","            nn.Dropout(dropout),\n","            nn.Linear(hidden_dim, num_classes),\n","        )\n","\n","    def forward(self, x: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            x: (B, input_dim) fused embedding.\n","\n","        Returns:\n","            (B, num_classes) raw logits.\n","        '''\n","        return self.net(x)\n","\n","print(\"[INFO] ClassifierHead defined (v2: Dropout moved after GELU).\")\n"]},{"cell_type":"code","execution_count":17,"id":"646d21df","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:31:06.337946Z","iopub.status.busy":"2026-08-17T06:31:06.33748Z","iopub.status.idle":"2026-08-17T06:31:06.352481Z","shell.execute_reply":"2026-08-17T06:31:06.351715Z"},"papermill":{"duration":0.041429,"end_time":"2026-08-17T06:31:06.353962+00:00","exception":false,"start_time":"2026-08-17T06:31:06.312533+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] DeepfakeDetector built. Total params: 25,332,867 | Trainable params: 16,016,643\n"]}],"source":["# ==============================================================\n","# Cell 18: Complete Model — DeepfakeDetector\n","# ==============================================================\n","class DeepfakeDetector(nn.Module):\n","    '''End-to-end lightweight deepfake audio detector.\n","\n","    Pipeline: raw waveform -> (VAD applied upstream in Dataset) -> Tiny SSL\n","    encoder -> Lightweight Temporal CNN (Conv1d over time) -> [+ optional\n","    wavelet features] -> Self-Attention Pooling (on SSL sequence) -> fused\n","    embedding -> Classifier -> logits.\n","\n","    CHANGED (v2): the CNN branch now feeds the SSL sequence to the backbone as\n","    `(B, ssl_dim, T)` -- i.e. SSL dims as CHANNELS, time as the convolved axis\n","    -- matching `LightweightTemporalCNN`'s `Conv1d` layout, instead of v1's\n","    `(B, 1, T, ssl_dim)` \"image\" reshape. See Cell 13 for the full rationale.\n","    The legacy image-based backbones are still supported (their branch is\n","    unchanged) for anyone running the ablation.\n","\n","    Args:\n","        ssl_encoder: TinySSLEncoder module.\n","        cnn_backbone: LightweightTemporalCNN (recommended) or legacy LightweightCNN module.\n","        wavelet_block: Optional WaveletBlock module (None to disable).\n","        config: Global CONFIG dictionary.\n","    '''\n","\n","    def __init__(self,\n","                 ssl_encoder: TinySSLEncoder,\n","                 cnn_backbone: nn.Module,\n","                 wavelet_block: Optional[WaveletBlock],\n","                 config: Dict[str, Any]):\n","        super().__init__()\n","        self.ssl_encoder = ssl_encoder\n","        self.cnn_backbone = cnn_backbone\n","        self.wavelet_block = wavelet_block\n","        self.config = config\n","        self._use_temporal_cnn = (config[\"cnn_backbone\"] == \"temporal_cnn\")\n","\n","        # Attention pooling operates on the SSL sequence directly (pre-CNN) to\n","        # produce a second, complementary utterance embedding.\n","        self.attn_pool = SelfAttentionPooling(\n","            input_dim=config[\"ssl_output_dim\"],\n","            hidden_dim=config[\"attention_hidden_dim\"],\n","        )\n","\n","        fused_dim = config[\"cnn_out_dim\"] + config[\"ssl_output_dim\"]\n","        if wavelet_block is not None:\n","            fused_dim += wavelet_block.out_dim\n","\n","        self.classifier = ClassifierHead(\n","            input_dim=fused_dim,\n","            hidden_dim=config[\"classifier_hidden_dim\"],\n","            num_classes=config[\"num_classes\"],\n","            dropout=config[\"dropout\"],\n","        )\n","\n","    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            waveform: (B, T) raw audio (already VAD-processed & length-normalized).\n","\n","        Returns:\n","            (B, num_classes) classification logits.\n","        '''\n","        # 1) Tiny SSL encoder -> (B, frames, ssl_dim)\n","        ssl_feats = self.ssl_encoder(waveform)\n","\n","        # 2) Attention-pooled SSL embedding (utterance-level, complementary to CNN branch)\n","        ssl_pooled = self.attn_pool(ssl_feats)                       # (B, ssl_dim)\n","\n","        # 3) CNN branch.\n","        if self._use_temporal_cnn:\n","            # CHANGED (v2): (B, frames, ssl_dim) -> (B, ssl_dim, frames) so\n","            # Conv1d convolves over TIME with SSL dims as channels (correct axis usage).\n","            cnn_input = ssl_feats.transpose(1, 2)\n","        else:\n","            # Legacy (v1): treat the sequence as a single-channel \"image\".\n","            cnn_input = ssl_feats.unsqueeze(1)\n","        cnn_feats = self.cnn_backbone(cnn_input)                     # (B, cnn_out_dim)\n","\n","        # 4) Optional wavelet-domain features from the raw waveform\n","        fused = [cnn_feats, ssl_pooled]\n","        if self.wavelet_block is not None:\n","            wavelet_feats = self.wavelet_block(waveform)             # (B, wavelet_out_dim)\n","            fused.append(wavelet_feats)\n","\n","        fused_embedding = torch.cat(fused, dim=1)                    # (B, fused_dim)\n","\n","        # 5) Classify\n","        logits = self.classifier(fused_embedding)                    # (B, num_classes)\n","        return logits\n","\n","\n","model = DeepfakeDetector(\n","    ssl_encoder=ssl_encoder,\n","    cnn_backbone=cnn_backbone,\n","    wavelet_block=wavelet_block,\n","    config=CONFIG,\n",").to(DEVICE) if ssl_encoder is not None else None\n","\n","if model is not None:\n","    total_params = sum(p.numel() for p in model.parameters())\n","    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n","    print(f\"[INFO] DeepfakeDetector built. Total params: {total_params:,} | \"\n","          f\"Trainable params: {trainable_params:,}\")\n","else:\n","    print(\"[WARN] Model not built because the SSL encoder failed to load (see Cell 13).\")\n"]},{"cell_type":"code","execution_count":18,"id":"36bdd99f","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:31:06.404593Z","iopub.status.busy":"2026-08-17T06:31:06.404303Z","iopub.status.idle":"2026-08-17T06:31:06.41827Z","shell.execute_reply":"2026-08-17T06:31:06.417595Z"},"papermill":{"duration":0.041075,"end_time":"2026-08-17T06:31:06.419945+00:00","exception":false,"start_time":"2026-08-17T06:31:06.37887+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] Loss function: CrossEntropyLoss | label_smoothing=0.05 | loss_class_weights=disabled (using WeightedRandomSampler instead)\n"]}],"source":["# ==============================================================\n","# Cell 19: Loss Functions\n","# ==============================================================\n","class FocalLoss(nn.Module):\n","    '''Multi-class Focal Loss (Lin et al., 2017), useful under class imbalance\n","    (ASVspoof training sets are typically dominated by spoof utterances).\n","\n","    Args:\n","        gamma: Focusing parameter; higher values down-weight easy examples more.\n","        weight: Optional per-class weight tensor (as in `nn.CrossEntropyLoss`).\n","        reduction: 'mean' | 'sum' | 'none'.\n","    '''\n","\n","    def __init__(self, gamma: float = 2.0, weight: Optional[torch.Tensor] = None,\n","                 reduction: str = \"mean\"):\n","        super().__init__()\n","        self.gamma = gamma\n","        self.weight = weight\n","        self.reduction = reduction\n","\n","    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:\n","        ce_loss = F.cross_entropy(logits, targets, weight=self.weight, reduction=\"none\")\n","        pt = torch.exp(-ce_loss)\n","        focal_loss = ((1 - pt) ** self.gamma) * ce_loss\n","        if self.reduction == \"mean\":\n","            return focal_loss.mean()\n","        elif self.reduction == \"sum\":\n","            return focal_loss.sum()\n","        return focal_loss\n","\n","\n","def build_loss_fn(config: Dict[str, Any], class_weights: Optional[torch.Tensor] = None) -> nn.Module:\n","    '''Factory for the training loss function, selected via CONFIG['use_focal_loss'].\n","\n","    CHANGED (v2): `class_weights` is now only passed through when\n","    `CONFIG[\"use_loss_class_weights\"]` is True. By default it is False --\n","    class imbalance is instead corrected once, at the data level, via the\n","    `WeightedRandomSampler` in the train DataLoader (Cell 9). Combining BOTH a\n","    balanced sampler AND inverse-frequency loss weights (as v1 did) applies the\n","    correction twice, which is a likely contributor to v1's dev-set behavior\n","    of over-predicting \"bonafide\" (recall=0.94 / precision=0.42 on that class).\n","    Also adds label smoothing (mild regularization + better-calibrated\n","    probabilities, which matters for the EER metric).\n","    '''\n","    if config[\"use_focal_loss\"]:\n","        return FocalLoss(gamma=config[\"focal_gamma\"], weight=class_weights)\n","    return nn.CrossEntropyLoss(weight=class_weights, label_smoothing=config.get(\"label_smoothing\", 0.0))\n","\n","\n","# Compute inverse-frequency class weights from the training split (only used if\n","# CONFIG[\"use_loss_class_weights\"] is True -- see rationale above).\n","if len(train_df) > 0:\n","    class_counts = train_df[\"target\"].value_counts().sort_index()\n","    weights = (1.0 / class_counts).reindex(range(CONFIG[\"num_classes\"])).fillna(1.0)\n","    weights = (weights / weights.sum()) * CONFIG[\"num_classes\"]\n","    class_weights = torch.tensor(weights.values, dtype=torch.float32).to(DEVICE)\n","else:\n","    class_weights = None\n","\n","loss_class_weights = class_weights if CONFIG.get(\"use_loss_class_weights\", False) else None\n","criterion = build_loss_fn(CONFIG, loss_class_weights)\n","print(f\"[INFO] Loss function: {type(criterion).__name__} | \"\n","      f\"label_smoothing={CONFIG.get('label_smoothing', 0.0)} | \"\n","      f\"loss_class_weights={'disabled (using WeightedRandomSampler instead)' if loss_class_weights is None else loss_class_weights}\")\n"]},{"cell_type":"code","execution_count":19,"id":"7710f681","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:31:06.472766Z","iopub.status.busy":"2026-08-17T06:31:06.472066Z","iopub.status.idle":"2026-08-17T06:31:06.483941Z","shell.execute_reply":"2026-08-17T06:31:06.483083Z"},"papermill":{"duration":0.03943,"end_time":"2026-08-17T06:31:06.485292+00:00","exception":false,"start_time":"2026-08-17T06:31:06.445862+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] Optimizer: AdamW(weight_decay=0.0005)\n","       param group 'head': 1,840,899 params, lr=0.0\n","       param group 'ssl_finetune': 14,175,744 params, lr=0.0\n","[INFO] Scheduler: Cosine with 1 warmup epoch(s)\n","[INFO] Mixed precision (AMP): True\n"]}],"source":["# ==============================================================\n","# Cell 20: Optimizer, LR Scheduler, Mixed Precision\n","# ==============================================================\n","def build_optimizer_and_scheduler(model: nn.Module, config: Dict[str, Any],\n","                                   steps_per_epoch: int):\n","    '''Builds AdamW optimizer with a cosine-annealing LR schedule with linear warmup.\n","\n","    CHANGED (v2): uses two discriminative-LR parameter groups instead of one:\n","      - \"head\" group (temporal CNN / wavelet block / attention pooling /\n","        classifier -- everything trained from scratch): CONFIG[\"lr\"].\n","      - \"ssl_finetune\" group (the last N unfrozen DistilHuBERT transformer\n","        layers, if any -- see Cell 12): CONFIG[\"ssl_finetune_lr\"], a much\n","        smaller LR to avoid destroying the pretrained representation.\n","    Falls back to a single group if no SSL parameters are trainable (fully\n","    frozen encoder), matching v1's behavior in that case.\n","\n","    Args:\n","        model: The model whose trainable parameters will be optimized.\n","        config: Global CONFIG dictionary.\n","        steps_per_epoch: Number of optimizer steps per epoch (len(train_loader)).\n","\n","    Returns:\n","        (optimizer, scheduler) tuple.\n","    '''\n","    ssl_params = [p for n, p in model.named_parameters()\n","                  if p.requires_grad and n.startswith(\"ssl_encoder.\")]\n","    head_params = [p for n, p in model.named_parameters()\n","                   if p.requires_grad and not n.startswith(\"ssl_encoder.\")]\n","\n","    param_groups = [{\"params\": head_params, \"lr\": config[\"lr\"], \"name\": \"head\"}]\n","    if len(ssl_params) > 0:\n","        param_groups.append({\"params\": ssl_params, \"lr\": config[\"ssl_finetune_lr\"], \"name\": \"ssl_finetune\"})\n","\n","    optimizer = torch.optim.AdamW(param_groups, weight_decay=config[\"weight_decay\"])\n","\n","    total_steps = steps_per_epoch * config[\"epochs\"]\n","    warmup_steps = steps_per_epoch * config[\"warmup_epochs\"]\n","\n","    def lr_lambda(current_step: int) -> float:\n","        if current_step < warmup_steps:\n","            return float(current_step) / float(max(1, warmup_steps))\n","        progress = float(current_step - warmup_steps) / float(max(1, total_steps - warmup_steps))\n","        return 0.5 * (1.0 + math.cos(math.pi * progress))\n","\n","    # LambdaLR applies `lr_lambda` as a *multiplier* on each group's own base LR,\n","    # so both groups keep their relative LR ratio throughout the schedule.\n","    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda)\n","    return optimizer, scheduler\n","\n","\n","if model is not None and len(dataloaders[\"train\"]) > 0:\n","    optimizer, scheduler = build_optimizer_and_scheduler(\n","        model, CONFIG, steps_per_epoch=len(dataloaders[\"train\"])\n","    )\n","    scaler = GradScaler(enabled=CONFIG[\"use_amp\"] and DEVICE.type == \"cuda\")\n","    print(f\"[INFO] Optimizer: AdamW(weight_decay={CONFIG['weight_decay']})\")\n","    for g in optimizer.param_groups:\n","        print(f\"       param group '{g.get('name', '?')}': {sum(p.numel() for p in g['params']):,} params, lr={g['lr']}\")\n","    print(f\"[INFO] Scheduler: Cosine with {CONFIG['warmup_epochs']} warmup epoch(s)\")\n","    print(f\"[INFO] Mixed precision (AMP): {scaler.is_enabled()}\")\n","else:\n","    optimizer, scheduler, scaler = None, None, None\n","    print(\"[WARN] Optimizer/scheduler not built — model or train loader unavailable.\")\n"]},{"cell_type":"code","execution_count":20,"id":"791da1f6","metadata":{"execution":{"iopub.execute_input":"2026-08-17T06:31:06.54099Z","iopub.status.busy":"2026-08-17T06:31:06.540684Z","iopub.status.idle":"2026-08-17T17:32:47.030229Z","shell.execute_reply":"2026-08-17T17:32:47.028347Z"},"papermill":{"duration":39700.521727,"end_time":"2026-08-17T17:32:47.034622+00:00","exception":false,"start_time":"2026-08-17T06:31:06.512895+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"e6fcf4dbd3bb4b96ac6c90599a5b4a4e","version_major":2,"version_minor":0},"text/plain":["Train:   0%|          | 0/3799 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"bb0500d829454b7aa1e19b8611e79d4b","version_major":2,"version_minor":0},"text/plain":["Eval:   0%|          | 0/2069 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["[Epoch 01/30] train_loss=0.2028 train_acc=0.9564 train_f1=0.9559 train_eer=0.0436 | val_loss=1.6157 val_acc=0.4231 val_f1=0.4354 val_eer=0.2268 | 3354.3s\n","  -> New best model saved (val_eer=0.2268) -> ./checkpoints/best_model.pt\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"4ab872b40bb049cea8268be34cdd15e1","version_major":2,"version_minor":0},"text/plain":["Tra