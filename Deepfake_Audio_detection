dev_df.iloc[test_idx].reset_index(drop=True)\n\n    # Sanity check: no speaker should appear in both splits.\n    overlap = set(val_df[\"speaker_id\"]) & set(test_df[\"speaker_id\"])\n    assert len(overlap) == 0, f\"Speaker leakage between val/test: {overlap}\"\n\n    return val_df, test_df\n\n\ndef load_splits(\n    protocol_paths: Dict[str, Path],\n    train_audio_dir: Path,\n    dev_audio_dir: Path,\n    audio_ext: str = \".flac\",\n) -> Dict[str, pd.DataFrame]:\n\n    splits = {}\n\n    print(\"\\n\" + \"=\" * 70)\n    print(\"TRAIN SPLIT\")\n    print(\"=\" * 70)\n\n    train_df = read_asvspoof5_metadata(\n        metadata_path=protocol_paths[\"train\"],\n        audio_dir=train_audio_dir,\n        audio_ext=audio_ext,\n    )\n\n    splits[\"train\"] = train_df\n\n    print(\"\\n\" + \"=\" * 70)\n    print(\"DEV SPLIT (raw, before val/test split)\")\n    print(\"=\" * 70)\n\n    dev_df_raw = read_asvspoof5_metadata(\n        metadata_path=protocol_paths[\"dev\"],\n        audio_dir=dev_audio_dir,\n        audio_ext=audio_ext,\n    )\n\n    val_df, test_df = split_dev_into_val_test(\n        dev_df_raw, test_fraction=CONFIG[\"test_fraction_of_speakers\"], seed=CONFIG[\"seed\"]\n    )\n\n    print(f\"\\n[INFO] Speaker-disjoint split of `dev`: \"\n          f\"val={len(val_df):,} rows / {val_df['speaker_id'].nunique() if len(val_df) else 0} speakers, \"\n          f\"test={len(test_df):,} rows / {test_df['speaker_id'].nunique() if len(test_df) else 0} speakers\")\n    if len(val_df):\n        print(f\"[INFO] val class distribution:  {val_df['label'].value_counts().to_dict()}\")\n    if len(test_df):\n        print(f\"[INFO] test class distribution: {test_df['label'].value_counts().to_dict()}\")\n\n    splits[\"dev\"] = val_df    \n    splits[\"eval\"] = test_df  \n\n    print(\"\\n\" + \"=\" * 70)\n    print(\"DATASET SUMMARY\")\n    print(\"=\" * 70)\n\n    print(f\"Train : {len(train_df):,}\")\n    print(f\"Val   : {len(val_df):,}   (early stopping / checkpoint selection)\")\n    print(f\"Test  : {len(test_df):,}   (held out, evaluated once at the end)\")\n\n    return splits\n\n\nsplits = load_splits(\n    protocol_paths=PROTOCOL_PATHS,\n    train_audio_dir=TRAIN_AUDIO_DIR,\n    dev_audio_dir=DEV_AUDIO_DIR,\n    audio_ext=AUDIO_EXTENSION,\n)\n\ntrain_df = splits[\"train\"]\ndev_df = splits[\"dev\"]     \neval_df = splits[\"eval\"]   \n\n\nif len(train_df) == 0:\n    raise RuntimeError(\n        \"Training DataFrame is empty. \"\n        \"Check metadata and audio paths.\"\n    )\n\nif len(dev_df) == 0:\n    raise RuntimeError(\n        \"Validation DataFrame is empty. \"\n        \"Check metadata and audio paths.\"\n    )\n\nif len(eval_df) == 0:\n    warnings.warn(\n        \"Held-out test DataFrame is empty -- confusion matrix / per-class \"\n        \"report at the end of the notebook will be skipped. Check \"\n        \"`test_fraction_of_speakers` and the dev metadata.\"\n    )\n\nprint(\"\\n[INFO] Train sample:\")\ndisplay(train_df.head())\n\nprint(\"\\n[INFO] Val sample:\")\ndisplay(dev_df.head())\n\nprint(\"\\n[INFO] Test sample:\")\ndisplay(eval_df.head())\n","metadata":{"execution":{"iopub.status.busy":"2026-08-17T04:54:42.715198Z","iopub.execute_input":"2026-08-17T04:54:42.715555Z","iopub.status.idle":"2026-08-17T05:14:57.120039Z","shell.execute_reply.started":"2026-08-17T04:54:42.715534Z","shell.execute_reply":"2026-08-17T05:14:57.119324Z"},"papermill":{"duration":748.647276,"end_time":"2026-08-16T17:39:39.627121+00:00","exception":false,"start_time":"2026-08-16T17:27:10.979845+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class ASVspoofDataset(Dataset):\n    def __init__(self,\n                 df: pd.DataFrame,\n                 config: Dict[str, Any],\n                 train: bool = False,\n                 apply_vad_fn: Optional[Any] = None,\n                 augmenter: Optional[Any] = None):\n        self.df = df.reset_index(drop=True)\n        self.config = config\n        self.train = train\n        self.apply_vad_fn = apply_vad_fn\n        self.augmenter = augmenter  # NEW\n        self.sample_rate = config[\"sample_rate\"]\n        self.max_len = int(config[\"max_audio_seconds\"] * self.sample_rate)\n\n    def __len__(self) -> int:\n        return len(self.df)\n\n    def _load_waveform(self, filepath: str) -> torch.Tensor:\n        waveform, sr = torchaudio.load(filepath)\n        if waveform.shape[0] > 1:\n            waveform = waveform.mean(dim=0, keepdim=True)  # downmix to mono\n        if sr != self.sample_rate:\n            resampler = T.Resample(orig_freq=sr, new_freq=self.sample_rate)\n            waveform = resampler(waveform)\n        return waveform.squeeze(0)  # (T,)\n\n    def _fix_length(self, waveform: torch.Tensor) -> torch.Tensor:\n        length = waveform.shape[0]\n        if length >= self.max_len:\n            if self.train:\n                start = random.randint(0, length - self.max_len)\n            else:\n                start = (length - self.max_len) // 2\n            waveform = waveform[start:start + self.max_len]\n        else:\n            pad = self.max_len - length\n            waveform = F.pad(waveform, (0, pad))\n        return waveform\n\n    def __getitem__(self, idx: int) -> Dict[str, Any]:\n        row = self.df.iloc[idx]\n        filepath = row[\"filepath\"]\n        target = int(row[\"target\"])\n\n        try:\n            waveform = self._load_waveform(filepath)\n        except Exception as e:\n            warnings.warn(f\"Failed to load {filepath}: {e}. Returning silence.\")\n            waveform = torch.zeros(self.max_len)\n\n        if self.config.get(\"use_vad\", True) and self.apply_vad_fn is not None:\n            waveform = self.apply_vad_fn(waveform, self.sample_rate)\n\n        if self.train and self.config.get(\"use_augmentation\", False) and self.augmenter is not None:\n            waveform = self.augmenter(waveform)\n\n        waveform = self._fix_length(waveform)\n\n        return {\n            \"waveform\": waveform,\n            \"target\": torch.tensor(target, dtype=torch.long),\n            \"filepath\": filepath,\n        }\n\n\ndef collate_fn(batch: List[Dict[str, Any]]) -> Dict[str, Any]:\n    waveforms = torch.stack([b[\"waveform\"] for b in batch], dim=0)\n    targets = torch.stack([b[\"target\"] for b in batch], dim=0)\n    filepaths = [b[\"filepath\"] for b in batch]\n    return {\"waveform\": waveforms, \"target\": targets, \"filepath\": filepaths}\n\nprint(\"[INFO] ASVspoofDataset and collate_fn defined (v2: augmentation now applied inside __getitem__).\")\n","metadata":{"execution":{"iopub.status.busy":"2026-08-17T05:14:57.121031Z","iopub.execute_input":"2026-08-17T05:14:57.121545Z","iopub.status.idle":"2026-08-17T05:14:57.134019Z","shell.execute_reply.started":"2026-08-17T05:14:57.121522Z","shell.execute_reply":"2026-08-17T05:14:57.13333Z"},"papermill":{"duration":0.019747,"end_time":"2026-08-16T17:39:39.65234+00:00","exception":false,"start_time":"2026-08-16T17:39:39.632593+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def build_dataloaders(train_df: pd.DataFrame,\n                       dev_df: pd.DataFrame,\n                       eval_df: pd.DataFrame,\n                       config: Dict[str, Any],\n                       vad_fn: Optional[Any] = None,\n                       augmenter: Optional[Any] = None) -> Dict[str, DataLoader]:\n    train_ds = ASVspoofDataset(train_df, config, train=True, apply_vad_fn=vad_fn, augmenter=augmenter)\n    dev_ds = ASVspoofDataset(dev_df, config, train=False, apply_vad_fn=vad_fn)\n    eval_ds = ASVspoofDataset(eval_df, config, train=False, apply_vad_fn=vad_fn)\n\n    train_sampler = None\n    shuffle_train = True\n    if config.get(\"use_weighted_sampler\", False) and len(train_df) > 0:\n        class_counts = train_df[\"target\"].value_counts().sort_index()\n        class_weight_map = (1.0 / class_counts).to_dict()\n        sample_weights = train_df[\"target\"].map(class_weight_map).values.astype(np.float64)\n        train_sampler = WeightedRandomSampler(\n            weights=torch.as_tensor(sample_weights, dtype=torch.double),\n            num_samples=len(sample_weights),\n            replacement=True,\n        )\n        shuffle_train = False \n\n    loaders = {\n        \"train\": DataLoader(train_ds, batch_size=config[\"batch_size\"],\n                             shuffle=shuffle_train, sampler=train_sampler,\n                             num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n                             pin_memory=True, drop_last=True,\n                             persistent_workers=config[\"num_workers\"] > 0),\n        \"dev\": DataLoader(dev_ds, batch_size=config[\"batch_size\"], shuffle=False,\n                           num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n                           pin_memory=True, persistent_workers=config[\"num_workers\"] > 0),\n        \"eval\": DataLoader(eval_ds, batch_size=config[\"batch_size\"], shuffle=False,\n                            num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n                            pin_memory=True, persistent_workers=config[\"num_workers\"] > 0),\n    }\n    for name, loader in loaders.items():\n        print(f\"[{name.upper():5s}] {len(loader.dataset)} samples -> {len(loader)} batches \"\n              f\"(batch_size={config['batch_size']})\")\n    if train_sampler is not None:\n        print(\"[INFO] Train loader uses a WeightedRandomSampler (inverse class frequency).\")\n    return loaders\n","metadata":{"execution":{"iopub.status.busy":"2026-08-17T05:14:57.135295Z","iopub.execute_input":"2026-08-17T05:14:57.1356Z","iopub.status.idle":"2026-08-17T05:14:57.164608Z","shell.execute_reply.started":"2026-08-17T05:14:57.135571Z","shell.execute_reply":"2026-08-17T05:14:57.163836Z"},"papermill":{"duration":0.013436,"end_time":"2026-08-16T17:39:39.671017+00:00","exception":false,"start_time":"2026-08-16T17:39:39.657581+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class EnergyVAD:\n\n    def __init__(self, sample_rate: int = 16000, frame_ms: int = 30, threshold_db: float = -35.0):\n        self.sample_rate = sample_rate\n        self.frame_len = int(sample_rate * frame_ms / 1000)\n        self.threshold_db = threshold_db\n\n    def __call__(self, waveform: torch.Tensor, sample_rate: int) -> torch.Tensor:\n        wav = waveform.numpy()\n        n_frames = max(1, len(wav) // self.frame_len)\n        frames = [wav[i * self.frame_len:(i + 1) * self.frame_len] for i in range(n_frames)]\n\n        energies_db = []\n        for fr in frames:\n            energy = np.mean(fr ** 2) + 1e-10\n            energies_db.append(10 * np.log10(energy))\n        energies_db = np.array(energies_db)\n\n        if len(energies_db) == 0:\n            return waveform\n\n        max_db = energies_db.max()\n        active_mask = energies_db >= (max_db + self.threshold_db)\n\n        if active_mask.sum() == 0:\n            return waveform\n\n        active_frames = [frames[i] for i in range(len(frames)) if active_mask[i]]\n        active_wav = np.concatenate(active_frames)\n        return torch.from_numpy(active_wav).float()\n\n\nclass WebRTCVAD:\n    def __init__(self, sample_rate: int = 16000, frame_ms: int = 30, aggressiveness: int = 2):\n        self.sample_rate = sample_rate\n        self.frame_ms = frame_ms\n        self.frame_len = int(sample_rate * frame_ms / 1000)\n        try:\n            import webrtcvad\n            self.vad = webrtcvad.Vad(aggressiveness)\n            self.available = True\n        except ImportError:\n            warnings.warn(\"webrtcvad not installed; falling back to EnergyVAD.\")\n            self.available = False\n            self._fallback = EnergyVAD(sample_rate, frame_ms)\n\n    def __call__(self, waveform: torch.Tensor, sample_rate: int) -> torch.Tensor:\n        if not self.available:\n            return self._fallback(waveform, sample_rate)\n\n        wav_int16 = (waveform.numpy() * 32768.0).astype(np.int16)\n        n_frames = len(wav_int16) // self.frame_len\n        active_frames = []\n        for i in range(n_frames):\n            frame_bytes = wav_int16[i * self.frame_len:(i + 1) * self.frame_len].tobytes()\n            if len(frame_bytes) < self.frame_len * 2:\n                continue\n            if self.vad.is_speech(frame_bytes, self.sample_rate):\n                active_frames.append(wav_int16[i * self.frame_len:(i + 1) * self.frame_len])\n\n        if len(active_frames) == 0:\n            return waveform\n\n        active_wav = np.concatenate(active_frames).astype(np.float32) / 32768.0\n        return torch.from_numpy(active_wav)\n\n\nvad_fn = EnergyVAD(\n    sample_rate=CONFIG[\"sample_rate\"],\n    frame_ms=CONFIG[\"vad_frame_ms\"],\n    threshold_db=CONFIG[\"vad_energy_threshold_db\"],\n) if CONFIG[\"use_vad\"] else None\n\nprint(\"[INFO] VAD module ready:\", type(vad_fn).__name__ if vad_fn else \"disabled\")\n","metadata":{"execution":{"iopub.status.busy":"2026-08-17T05:14:57.166639Z","iopub.execute_input":"2026-08-17T05:14:57.167365Z","iopub.status.idle":"2026-08-17T05:14:57.186347Z","shell.execute_reply.started":"2026-08-17T05:14:57.167343Z","shell.execute_reply":"2026-08-17T05:14:57.185534Z"},"papermill":{"duration":0.047762,"end_time":"2026-08-16T17:39:39.723919+00:00","exception":false,"start_time":"2026-08-16T17:39:39.676157+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class LogMelSpectrogramExtractor(nn.Module):\n    def __init__(self, config: Dict[str, Any]):\n        super().__init__()\n        self.mel_spec = T.MelSpectrogram(\n            sample_rate=config[\"sample_rate\"],\n            n_fft=config[\"n_fft\"],\n            hop_length=config[\"hop_length\"],\n            win_length=config[\"win_length\"],\n            n_mels=config[\"n_mels\"],\n            power=2.0,\n        )\n        self.amplitude_to_db = T.AmplitudeToDB(stype=\"power\", top_db=80)\n\n    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n        mel = self.mel_spec(waveform)           \n        log_mel = self.amplitude_to_db(mel)      \n        mean = log_mel.mean(dim=(-2, -1), keepdim=True)\n        std = log_mel.std(dim=(-2, -1), keepdim=True) + 1e-6\n        log_mel = (log_mel - mean) / std\n        return log_mel\n\n\nmel_extractor = LogMelSpectrogramExtractor(CONFIG).to(DEVICE)\n\n\ndef visualize_spectrograms(loader: DataLoader, extractor: nn.Module, n_examples: int = 4) -> None:\n    batch = next(iter(loader))\n    waveforms = batch[\"waveform\"][:n_examples].to(DEVICE)\n    targets = batch[\"target\"][:n_examples]\n\n    with torch.no_grad():\n        specs = extractor(waveforms).cpu().numpy()\n\n    fig, axes = plt.subplots(1, n_examples, figsize=(4 * n_examples, 4))\n    if n_examples == 1:\n        axes = [axes]\n    for i, ax in enumerate(axes):\n        label = \"Bonafide (Real)\" if targets[i].item() == 1 else \"Spoof (Fake)\"\n        img = librosa.display.specshow(specs[i], sr=CONFIG[\"sample_rate\"],\n                                        hop_length=CONFIG[\"hop_length\"],\n                                        x_axis=\"time\", y_axis=\"mel\", ax=ax, cmap=\"magma\")\n        ax.set_title(label)\n    fig.suptitle(\"Log-Mel Spectrogram Examples (Normalized)\")\n    plt.tight_layout()\n    plt.savefig(os.path.join(CONFIG[\"results_dir\"], \"sample_spectrograms.png\"), dpi=150)\n    plt.show()\n\nprint(\"[INFO] LogMelSpectrogramExtractor ready (visualization-only; see note above).\")\n","metadata":{"execution":{"iopub.status.busy":"2026-08-17T05:14:57.187639Z","iopub.execute_input":"2026-08-17T05:14:57.187965Z","iopub.status.idle":"2026-08-17T05:14:57.608692Z","shell.execute_reply.started":"2026-08-17T05:14:57.187934Z","shell.execute_reply":"2026-08-17T05:14:57.607902Z"},"papermill":{"duration":6.506213,"end_time":"2026-08-16T17:39:46.235736+00:00","exception":false,"start_time":"2026-08-16T17:39:39.729523+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class WaveformAugmenter:\n    def __init__(self, config: Dict[str, Any]):\n        self.config = config\n        self.sample_rate = config[\"sample_rate\"]\n\n    def add_noise(self, waveform: torch.Tensor) -> torch.Tensor:\n        snr_low, snr_high = self.config[\"noise_snr_db_range\"]\n        snr_db = random.uniform(snr_low, snr_high)\n        signal_power = waveform.pow(2).mean()\n        noise_power = signal_power / (10 ** (snr_db / 10))\n        noise = torch.randn_like(waveform) * torch.sqrt(noise_power + 1e-12)\n        return waveform + noise\n\n    def pitch_shift(self, waveform: torch.Tensor) -> torch.Tensor:\n        low, high = self.config[\"pitch_shift_semitones_range\"]\n        n_steps = random.uniform(low, high)\n        wav_np = waveform.numpy()\n        shifted = librosa.effects.pitch_shift(y=wav_np, sr=self.sample_rate, n_steps=n_steps)\n        return torch.from_numpy(shifted).float()\n\n    def time_stretch(self, waveform: torch.Tensor) -> torch.Tensor:\n        low, high = self.config[\"time_stretch_rate_range\"]\n        rate = random.uniform(low, high)\n        wav_np = waveform.numpy()\n        stretched = librosa.effects.time_stretch(y=wav_np, rate=rate)\n        stretched = torch.from_numpy(stretched).float()\n\n        orig_len = waveform.shape[0]\n        if stretched.shape[0] > orig_len:\n            start = random.randint(0, stretched.shape[0] - orig_len)\n            stretched = stretched[start:start + orig_len]\n        else:\n            stretched = F.pad(stretched, (0, orig_len - stretched.shape[0]))\n        return stretched\n\n    def __call__(self, waveform: torch.Tensor) -> torch.Tensor:\n        if random.random() < self.config[\"noise_prob\"]:\n            waveform = self.add_noise(waveform)\n        if random.random() < self.config[\"pitch_shift_prob\"]:\n            waveform = self.pitch_shift(waveform)\n        if random.random() < self.config[\"time_stretch_prob\"]:\n            waveform = self.time_stretch(waveform)\n        return waveform\n\n\nclass SpecAugment(nn.Module):\n    def __init__(self, config: Dict[str, Any]):\n        super().__init__()\n        self.freq_mask = T.FrequencyMasking(freq_mask_param=config[\"spec_freq_mask_param\"])\n        self.time_mask = T.TimeMasking(time_mask_param=config[\"spec_time_mask_param\"])\n\n    def forward(self, spec: torch.Tensor) -> torch.Tensor:\n        spec = self.freq_mask(spec)\n        spec = self.time_mask(spec)\n        return spec\n\n\nwaveform_augmenter = WaveformAugmenter(CONFIG)\nspec_augmenter = SpecAugment(CONFIG).to(DEVICE)\n\nprint(\"[INFO] Augmentation modules ready: WaveformAugmenter (noise/pitch/stretch), SpecAugment (freq/time mask).\")\n\ndataloaders = build_dataloaders(train_df, dev_df, eval_df, CONFIG, vad_fn=vad_fn, augmenter=waveform_augmenter)\n\nif len(dataloaders[\"train\"].dataset) > 0:\n    visualize_spectrograms(dataloaders[\"train\"], mel_extractor)\nelse:\n    print(\"[WARN] Train dataset is empty — populate DATA_ROOT with ASVspoof5 to visualize spectrograms.\")\n","metadata":{"execution":{"iopub.status.busy":"2026-08-17T05:14:57.610008Z","iopub.execute_input":"2026-08-17T05:14:57.610355Z","iopub.status.idle":"2026-08-17T05:15:23.785275Z","shell.execute_reply.started":"2026-08-17T05:14:57.610332Z","shell.execute_reply":"2026-08-17T05:15:23.783783Z"},"papermill":{"duration":0.027525,"end_time":"2026-08-16T17:39:46.272267+00:00","exception":false,"start_time":"2026-08-16T17:39:46.244742+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class TinySSLEncoder(nn.Module):\n    def __init__(self,\n                 model_name: str = \"ntu-spml/distilhubert\",\n                 freeze: bool = True,\n                 finetune: bool = False,\n                 unfreeze_last_n_layers: int = 0,\n                 sample_rate: int = 16000):\n        super().__init__()\n        self.sample_rate = sample_rate\n        self.model = AutoModel.from_pretrained(model_name)\n        self.output_dim = self.model.config.hidden_size\n\n        if finetune:\n            for param in self.model.parameters():\n                param.requires_grad = True\n            self._frozen_module = None  \n        else:\n            \n            for param in self.model.parameters():\n                param.requires_grad = False\n           \n            transformer_layers = self._get_transformer_layers()\n            if unfreeze_last_n_layers > 0 and transformer_layers is not None:\n                n = min(unfreeze_last_n_layers, len(transformer_layers))\n                for layer in transformer_layers[-n:]:\n                    for param in layer.parameters():\n                        param.requires_grad = True\n            self._frozen_module = self.model  \n\n        do_freeze = freeze and not finetune\n        self._frozen = do_freeze and unfreeze_last_n_layers <= 0\n        self.model.train(mode=not (do_freeze and unfreeze_last_n_layers <= 0))\n\n    def _get_transformer_layers(self):\n        encoder = getattr(self.model, \"encoder\", None)\n        if encoder is not None and hasattr(encoder, \"layers\"):\n            return encoder.layers\n        return None\n\n    @staticmethod\n    def _force_eval_on_frozen_subtrees(module: nn.Module) -> None:\n        has_trainable = any(p.requires_grad for p in module.parameters(recurse=True))\n        if not has_trainable:\n            module.eval()\n        else:\n            for child in module.children():\n                TinySSLEncoder._force_eval_on_frozen_subtrees(child)\n\n    def train(self, mode: bool = True):\n        super().train(mode)\n       