L encoder for end-to-end fine-tuning.\n","            `finetune=True` overrides `freeze`.\n","        sample_rate: Expected input sample rate (must match the SSL model's\n","            pretraining sample rate, typically 16 kHz).\n","    '''\n","\n","    def __init__(self,\n","                 model_name: str = \"ntu-spml/distilhubert\",\n","                 freeze: bool = True,\n","                 finetune: bool = False,\n","                 sample_rate: int = 16000):\n","        super().__init__()\n","        self.sample_rate = sample_rate\n","        self.model = AutoModel.from_pretrained(model_name)\n","        self.output_dim = self.model.config.hidden_size\n","\n","        do_freeze = freeze and not finetune\n","        for param in self.model.parameters():\n","            param.requires_grad = not do_freeze\n","        self.model.train(mode=not do_freeze)  # keep in eval-like mode if frozen\n","        self._frozen = do_freeze\n","\n","    def set_finetune(self, finetune: bool) -> None:\n","        '''Toggle fine-tuning of the SSL encoder at runtime (single config flag).'''\n","        for param in self.model.parameters():\n","            param.requires_grad = finetune\n","        self._frozen = not finetune\n","\n","    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            waveform: (B, T) raw audio at `self.sample_rate`.\n","\n","        Returns:\n","            (B, frames, hidden_size) contextualized SSL embeddings.\n","        '''\n","        if self._frozen:\n","            with torch.no_grad():\n","                outputs = self.model(waveform)\n","        else:\n","            outputs = self.model(waveform)\n","        return outputs.last_hidden_state  # (B, frames, hidden_size)\n","\n","\n","# Instantiate the SSL encoder (downloads pretrained weights from the HF Hub).\n","try:\n","    ssl_encoder = TinySSLEncoder(\n","        model_name=CONFIG[\"ssl_model_name\"],\n","        freeze=CONFIG[\"ssl_freeze\"],\n","        finetune=CONFIG[\"ssl_finetune\"],\n","        sample_rate=CONFIG[\"sample_rate\"],\n","    ).to(DEVICE)\n","    CONFIG[\"ssl_output_dim\"] = ssl_encoder.output_dim\n","    n_trainable = sum(p.numel() for p in ssl_encoder.parameters() if p.requires_grad)\n","    print(f\"[INFO] Loaded SSL encoder '{CONFIG['ssl_model_name']}' \"\n","          f\"(hidden_size={ssl_encoder.output_dim}, trainable_params={n_trainable:,}, \"\n","          f\"frozen={ssl_encoder._frozen})\")\n","except Exception as e:\n","    print(f\"[WARN] Could not download SSL encoder weights ({e}). \"\n","          f\"Ensure internet access / the model id is correct before training.\")\n","    ssl_encoder = None"]},{"cell_type":"code","execution_count":13,"id":"ba258b80","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:49.365557Z","iopub.status.busy":"2026-08-16T17:39:49.365141Z","iopub.status.idle":"2026-08-16T17:39:49.540043Z","shell.execute_reply":"2026-08-16T17:39:49.539032Z"},"papermill":{"duration":0.186816,"end_time":"2026-08-16T17:39:49.54177+00:00","exception":false,"start_time":"2026-08-16T17:39:49.354954+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Downloading: \"https://download.pytorch.org/models/mobilenet_v3_small-047dcff4.pth\" to /root/.cache/torch/hub/checkpoints/mobilenet_v3_small-047dcff4.pth\n"]},{"name":"stderr","output_type":"stream","text":["100%|██████████| 9.83M/9.83M [00:00<00:00, 193MB/s]"]},{"name":"stdout","output_type":"stream","text":["[INFO] Loaded CNN backbone 'mobilenetv3_small' (out_dim=576, total_params=926,720)\n"]},{"name":"stderr","output_type":"stream","text":["\n"]}],"source":["# ==============================================================\n","# Cell 14: Lightweight CNN backbone (MobileNetV3-Small / EfficientNet-Lite0)\n","# ==============================================================\n","class LightweightCNN(nn.Module):\n","    '''Lightweight CNN feature extractor operating on a 2D feature map\n","    (e.g., the SSL embedding sequence reshaped/treated as an \"image\").\n","\n","    Supports:\n","      - \"mobilenetv3_small\": torchvision MobileNetV3-Small, classifier removed.\n","      - \"efficientnet_lite0\": timm EfficientNet-Lite0, classifier removed.\n","\n","    The chosen backbone's first conv is adapted to accept a single input channel\n","    (our features are single-channel \"images\": time x SSL-dim), and both are\n","    used purely as convolutional feature extractors (global-pooled embeddings).\n","\n","    Args:\n","        backbone: \"mobilenetv3_small\" or \"efficientnet_lite0\".\n","        pretrained: Whether to load ImageNet-pretrained weights.\n","        in_channels: Number of input channels (1 for our SSL-feature-map input).\n","    '''\n","\n","    def __init__(self, backbone: str = \"mobilenetv3_small\", pretrained: bool = True,\n","                 in_channels: int = 1):\n","        super().__init__()\n","        self.backbone_name = backbone\n","\n","        if backbone == \"mobilenetv3_small\":\n","            net = torchvision.models.mobilenet_v3_small(\n","                weights=torchvision.models.MobileNet_V3_Small_Weights.DEFAULT if pretrained else None\n","            )\n","            # Adapt first conv to accept `in_channels` instead of 3.\n","            old_conv = net.features[0][0]\n","            new_conv = nn.Conv2d(in_channels, old_conv.out_channels,\n","                                  kernel_size=old_conv.kernel_size, stride=old_conv.stride,\n","                                  padding=old_conv.padding, bias=False)\n","            with torch.no_grad():\n","                new_conv.weight[:] = old_conv.weight.mean(dim=1, keepdim=True).repeat(1, in_channels, 1, 1)\n","            net.features[0][0] = new_conv\n","            self.features = net.features\n","            self.pool = nn.AdaptiveAvgPool2d(1)\n","            self.out_dim = net.classifier[0].in_features  # 576 for mobilenet_v3_small\n","\n","        elif backbone == \"efficientnet_lite0\":\n","            net = timm.create_model(\"efficientnet_lite0\", pretrained=pretrained,\n","                                     in_chans=in_channels, num_classes=0, global_pool=\"avg\")\n","            self.features = net\n","            self.pool = None  # timm model with num_classes=0 already returns pooled features\n","            self.out_dim = net.num_features\n","\n","        else:\n","            raise ValueError(f\"Unknown backbone: {backbone}\")\n","\n","    def forward(self, x: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            x: (B, in_channels, H, W) feature map.\n","\n","        Returns:\n","            (B, out_dim) pooled embedding.\n","        '''\n","        if self.backbone_name == \"mobilenetv3_small\":\n","            feats = self.features(x)          # (B, C, H', W')\n","            pooled = self.pool(feats)          # (B, C, 1, 1)\n","            return pooled.flatten(1)           # (B, C)\n","        else:  # efficientnet_lite0 (timm, pooling built-in)\n","            return self.features(x)\n","\n","\n","cnn_backbone = LightweightCNN(\n","    backbone=CONFIG[\"cnn_backbone\"],\n","    pretrained=CONFIG[\"cnn_pretrained\"],\n","    in_channels=1,\n",").to(DEVICE)\n","CONFIG[\"cnn_out_dim\"] = cnn_backbone.out_dim\n","\n","n_params = sum(p.numel() for p in cnn_backbone.parameters())\n","print(f\"[INFO] Loaded CNN backbone '{CONFIG['cnn_backbone']}' \"\n","      f\"(out_dim={cnn_backbone.out_dim}, total_params={n_params:,})\")"]},{"cell_type":"code","execution_count":14,"id":"17a1515b","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:49.561808Z","iopub.status.busy":"2026-08-16T17:39:49.561155Z","iopub.status.idle":"2026-08-16T17:39:49.571846Z","shell.execute_reply":"2026-08-16T17:39:49.571064Z"},"papermill":{"duration":0.022045,"end_time":"2026-08-16T17:39:49.573235+00:00","exception":false,"start_time":"2026-08-16T17:39:49.55119+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] Wavelet block ENABLED (db4, level=3, out_dim=128)\n"]}],"source":["# ==============================================================\n","# Cell 15: (Optional) Wavelet Block — DWT feature fusion\n","# ==============================================================\n","class WaveletBlock(nn.Module):\n","    '''Extracts multi-resolution Discrete Wavelet Transform (DWT) statistics\n","    from the raw waveform and projects them into a fixed-size embedding to be\n","    fused with the CNN embedding.\n","\n","    Motivation: vocoder-based TTS/voice-conversion artifacts often manifest as\n","    subtle high-frequency sub-band irregularities that a wavelet decomposition\n","    can expose more directly than a Mel spectrogram alone.\n","\n","    Args:\n","        wavelet_name: PyWavelets wavelet family, e.g. \"db4\".\n","        level: Number of DWT decomposition levels.\n","        out_dim: Output embedding dimensionality after projection.\n","    '''\n","\n","    def __init__(self, wavelet_name: str = \"db4\", level: int = 3, out_dim: int = 128):\n","        super().__init__()\n","        self.wavelet_name = wavelet_name\n","        self.level = level\n","        # 5 summary statistics per sub-band (mean, std, max, min, energy) x (level+1) sub-bands.\n","        n_subbands = level + 1\n","        in_dim = n_subbands * 5\n","        self.proj = nn.Sequential(\n","            nn.Linear(in_dim, out_dim),\n","            nn.GELU(),\n","            nn.LayerNorm(out_dim),\n","        )\n","        self.out_dim = out_dim\n","\n","    def _dwt_features_single(self, wav_np: np.ndarray) -> np.ndarray:\n","        '''Compute summary statistics over DWT coefficients for one waveform.'''\n","        coeffs = pywt.wavedec(wav_np, self.wavelet_name, level=self.level)\n","        feats = []\n","        for c in coeffs:\n","            c = c.astype(np.float64)\n","            feats.extend([\n","                c.mean(),\n","                c.std(),\n","                c.max() if c.size > 0 else 0.0,\n","                c.min() if c.size > 0 else 0.0,\n","                np.sum(c ** 2) / max(c.size, 1),  # average energy\n","            ])\n","        return np.array(feats, dtype=np.float32)\n","\n","    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            waveform: (B, T) raw audio tensor (CPU or GPU; DWT itself runs on CPU/numpy).\n","\n","        Returns:\n","            (B, out_dim) wavelet embedding, on the same device as `waveform`.\n","        '''\n","        device = waveform.device\n","        wav_np = waveform.detach().cpu().numpy()\n","        batch_feats = np.stack([self._dwt_features_single(w) for w in wav_np], axis=0)\n","        batch_feats = torch.from_numpy(batch_feats).float().to(device)\n","        return self.proj(batch_feats)\n","\n","\n","wavelet_block = WaveletBlock(\n","    wavelet_name=CONFIG[\"wavelet_name\"],\n","    level=CONFIG[\"wavelet_level\"],\n","    out_dim=CONFIG[\"wavelet_out_dim\"],\n",").to(DEVICE) if CONFIG[\"use_wavelet\"] else None\n","\n","print(f\"[INFO] Wavelet block {'ENABLED' if wavelet_block is not None else 'DISABLED'} \"\n","      f\"({CONFIG['wavelet_name']}, level={CONFIG['wavelet_level']}, \"\n","      f\"out_dim={CONFIG['wavelet_out_dim']})\")"]},{"cell_type":"code","execution_count":15,"id":"b51cd63e","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:49.592485Z","iopub.status.busy":"2026-08-16T17:39:49.591973Z","iopub.status.idle":"2026-08-16T17:39:49.598553Z","shell.execute_reply":"2026-08-16T17:39:49.597695Z"},"papermill":{"duration":0.018205,"end_time":"2026-08-16T17:39:49.600064+00:00","exception":false,"start_time":"2026-08-16T17:39:49.581859+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] SelfAttentionPooling defined.\n"]}],"source":["# ==============================================================\n","# Cell 16: Self-Attention Pooling\n","# ==============================================================\n","class SelfAttentionPooling(nn.Module):\n","    '''Self-attention pooling layer that collapses a sequence of frame-level\n","    embeddings into a single utterance-level embedding using a learned\n","    attention weight per frame (Lee et al., \"Self-Attentive Pooling\").\n","\n","    Args:\n","        input_dim: Dimensionality of each frame embedding.\n","        hidden_dim: Hidden size of the attention scoring MLP.\n","    '''\n","\n","    def __init__(self, input_dim: int, hidden_dim: int = 128):\n","        super().__init__()\n","        self.attention = nn.Sequential(\n","            nn.Linear(input_dim, hidden_dim),\n","            nn.Tanh(),\n","            nn.Linear(hidden_dim, 1),\n","        )\n","\n","    def forward(self, x: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            x: (B, T, D) sequence of frame embeddings.\n","\n","        Returns:\n","            (B, D) attention-weighted utterance embedding.\n","        '''\n","        scores = self.attention(x)                 # (B, T, 1)\n","        weights = torch.softmax(scores, dim=1)      # (B, T, 1)\n","        pooled = torch.sum(weights * x, dim=1)      # (B, D)\n","        return pooled\n","\n","print(\"[INFO] SelfAttentionPooling defined.\")"]},{"cell_type":"code","execution_count":16,"id":"568b6676","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:49.618996Z","iopub.status.busy":"2026-08-16T17:39:49.618412Z","iopub.status.idle":"2026-08-16T17:39:49.624812Z","shell.execute_reply":"2026-08-16T17:39:49.623873Z"},"papermill":{"duration":0.017938,"end_time":"2026-08-16T17:39:49.626534+00:00","exception":false,"start_time":"2026-08-16T17:39:49.608596+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] ClassifierHead defined.\n"]}],"source":["# ==============================================================\n","# Cell 17: Classifier Head\n","# ==============================================================\n","class ClassifierHead(nn.Module):\n","    '''Final MLP classifier head: Linear -> Dropout -> GELU -> Linear -> logits.\n","\n","    Args:\n","        input_dim: Dimensionality of the fused utterance embedding.\n","        hidden_dim: Hidden layer width.\n","        num_classes: Number of output classes (2 for real/fake).\n","        dropout: Dropout probability.\n","    '''\n","\n","    def __init__(self, input_dim: int, hidden_dim: int = 256,\n","                 num_classes: int = 2, dropout: float = 0.3):\n","        super().__init__()\n","        self.net = nn.Sequential(\n","            nn.Linear(input_dim, hidden_dim),\n","            nn.Dropout(dropout),\n","            nn.GELU(),\n","            nn.Linear(hidden_dim, num_classes),\n","        )\n","\n","    def forward(self, x: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            x: (B, input_dim) fused embedding.\n","\n","        Returns:\n","            (B, num_classes) raw logits.\n","        '''\n","        return self.net(x)\n","\n","print(\"[INFO] ClassifierHead defined.\")"]},{"cell_type":"code","execution_count":17,"id":"75a02f7c","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:49.647192Z","iopub.status.busy":"2026-08-16T17:39:49.64671Z","iopub.status.idle":"2026-08-16T17:39:49.66549Z","shell.execute_reply":"2026-08-16T17:39:49.664617Z"},"papermill":{"duration":0.031347,"end_time":"2026-08-16T17:39:49.666902+00:00","exception":false,"start_time":"2026-08-16T17:39:49.635555+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] DeepfakeDetector built. Total params: 24,897,795 | Trainable params: 1,405,827\n"]}],"source":["# ==============================================================\n","# Cell 18: Complete Model — DeepfakeDetector\n","# ==============================================================\n","class DeepfakeDetector(nn.Module):\n","    '''End-to-end lightweight deepfake audio detector.\n","\n","    Pipeline: raw waveform -> (VAD applied upstream in Dataset) -> log-mel\n","    spectrogram -> Tiny SSL encoder -> reshape to 2D map -> Lightweight CNN\n","    -> [+ optional wavelet features] -> Self-Attention Pooling (on CNN's\n","    spatial sequence) -> fused embedding -> Classifier -> logits.\n","\n","    Args:\n","        mel_extractor: LogMelSpectrogramExtractor module (kept for API completeness;\n","            the SSL encoder consumes raw waveform directly per DistilHuBERT design).\n","        ssl_encoder: TinySSLEncoder module.\n","        cnn_backbone: LightweightCNN module.\n","        wavelet_block: Optional WaveletBlock module (None to disable).\n","        config: Global CONFIG dictionary.\n","    '''\n","\n","    def __init__(self,\n","                 ssl_encoder: TinySSLEncoder,\n","                 cnn_backbone: LightweightCNN,\n","                 wavelet_block: Optional[WaveletBlock],\n","                 config: Dict[str, Any]):\n","        super().__init__()\n","        self.ssl_encoder = ssl_encoder\n","        self.cnn_backbone = cnn_backbone\n","        self.wavelet_block = wavelet_block\n","        self.config = config\n","\n","        # Project the SSL hidden_size down to a small number of \"channels\" so the\n","        # (B, frames, ssl_dim) sequence can be treated as a (B, 1, frames, ssl_dim) image.\n","        self.ssl_to_image_channels = 1\n","\n","        # Attention pooling operates on the SSL sequence directly (pre-CNN) to\n","        # produce a second, complementary utterance embedding.\n","        self.attn_pool = SelfAttentionPooling(\n","            input_dim=config[\"ssl_output_dim\"],\n","            hidden_dim=config[\"attention_hidden_dim\"],\n","        )\n","\n","        fused_dim = config[\"cnn_out_dim\"] + config[\"ssl_output_dim\"]\n","        if wavelet_block is not None:\n","            fused_dim += wavelet_block.out_dim\n","\n","        self.classifier = ClassifierHead(\n","            input_dim=fused_dim,\n","            hidden_dim=config[\"classifier_hidden_dim\"],\n","            num_classes=config[\"num_classes\"],\n","            dropout=config[\"dropout\"],\n","        )\n","\n","    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            waveform: (B, T) raw audio (already VAD-processed & length-normalized).\n","\n","        Returns:\n","            (B, num_classes) classification logits.\n","        '''\n","        # 1) Tiny SSL encoder -> (B, frames, ssl_dim)\n","        ssl_feats = self.ssl_encoder(waveform)\n","\n","        # 2) Attention-pooled SSL embedding (utterance-level, complementary to CNN branch)\n","        ssl_pooled = self.attn_pool(ssl_feats)                       # (B, ssl_dim)\n","\n","        # 3) Treat the SSL sequence as a single-channel 2D \"image\": (B, 1, frames, ssl_dim)\n","        cnn_input = ssl_feats.unsqueeze(1)\n","        cnn_feats = self.cnn_backbone(cnn_input)                     # (B, cnn_out_dim)\n","\n","        # 4) Optional wavelet-domain features from the raw waveform\n","        fused = [cnn_feats, ssl_pooled]\n","        if self.wavelet_block is not None:\n","            wavelet_feats = self.wavelet_block(waveform)             # (B, wavelet_out_dim)\n","            fused.append(wavelet_feats)\n","\n","        fused_embedding = torch.cat(fused, dim=1)                    # (B, fused_dim)\n","\n","        # 5) Classify\n","        logits = self.classifier(fused_embedding)                    # (B, num_classes)\n","        return logits\n","\n","\n","model = DeepfakeDetector(\n","    ssl_encoder=ssl_encoder,\n","    cnn_backbone=cnn_backbone,\n","    wavelet_block=wavelet_block,\n","    config=CONFIG,\n",").to(DEVICE) if ssl_encoder is not None else None\n","\n","if model is not None:\n","    total_params = sum(p.numel() for p in model.parameters())\n","    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n","    print(f\"[INFO] DeepfakeDetector built. Total params: {total_params:,} | \"\n","          f\"Trainable params: {trainable_params:,}\")\n","else:\n","    print(\"[WARN] Model not built because the SSL encoder failed to load (see Cell 13).\")"]},{"cell_type":"code","execution_count":18,"id":"7f3d0312","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:49.689161Z","iopub.status.busy":"2026-08-16T17:39:49.688866Z","iopub.status.idle":"2026-08-16T17:39:49.921044Z","shell.execute_reply":"2026-08-16T17:39:49.919952Z"},"papermill":{"duration":0.245455,"end_time":"2026-08-16T17:39:49.92277+00:00","exception":false,"start_time":"2026-08-16T17:39:49.677315+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] Loss function: CrossEntropyLoss | class_weights=tensor([0.2062, 1.7938], device='cuda:0')\n"]}],"source":["# ==============================================================\n","# Cell 19: Loss Functions\n","# ==============================================================\n","class FocalLoss(nn.Module):\n","    '''Multi-class Focal Loss (Lin et al., 2017), useful under class imbalance\n","    (ASVspoof training sets are typically dominated by spoof utterances).\n","\n","    Args:\n","        gamma: Focusing parameter; higher values down-weight easy examples more.\n","        weight: Optional per-class weight tensor (as in `nn.CrossEntropyLoss`).\n","        reduction: 'mean' | 'sum' | 'none'.\n","    '''\n","\n","    def __init__(self, gamma: float = 2.0, weight: Optional[torch.Tensor] = None,\n","                 reduction: str = \"mean\"):\n","        super().__init__()\n","        self.gamma = gamma\n","        self.weight = weight\n","        self.reduction = reduction\n","\n","    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:\n","        ce_loss = F.cross_entropy(logits, targets, weight=self.weight, reduction=\"none\")\n","        pt = torch.exp(-ce_loss)\n","        focal_loss = ((1 - pt) ** self.gamma) * ce_loss\n","        if self.reduction == \"mean\":\n","            return focal_loss.mean()\n","        elif self.reduction == \"sum\":\n","            return focal_loss.sum()\n","        return focal_loss\n","\n","\n","def build_loss_fn(config: Dict[str, Any], class_weights: Optional[torch.Tensor] = None) -> nn.Module:\n","    '''Factory for the training loss function, selected via CONFIG['use_focal_loss'].'''\n","    if config[\"use_focal_loss\"]:\n","        return FocalLoss(gamma=config[\"focal_gamma\"], weight=class_weights)\n","    return nn.CrossEntropyLoss(weight=class_weights)\n","\n","\n","# Compute inverse-frequency class weights from the training split to counter class imbalance.\n","if len(train_df) > 0:\n","    class_counts = train_df[\"target\"].value_counts().sort_index()\n","    weights = (1.0 / class_counts).reindex(range(CONFIG[\"num_classes\"])).fillna(1.0)\n","    weights = (weights / weights.sum()) * CONFIG[\"num_classes\"]\n","    class_weights = torch.tensor(weights.values, dtype=torch.float32).to(DEVICE)\n","else:\n","    class_weights = None\n","\n","criterion = build_loss_fn(CONFIG, class_weights)\n","print(f\"[INFO] Loss function: {type(criterion).__name__} | class_weights={class_weights}\")"]},{"cell_type":"code","execution_count":19,"id":"71ea8a75","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:49.945782Z","iopub.status.busy":"2026-08-16T17:39:49.945045Z","iopub.status.idle":"2026-08-16T17:39:49.956501Z","shell.execute_reply":"2026-08-16T17:39:49.955744Z"},"papermill":{"duration":0.024642,"end_time":"2026-08-16T17:39:49.957905+00:00","exception":false,"start_time":"2026-08-16T17:39:49.933263+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] Optimizer: AdamW(lr=0.0003, weight_decay=0.0001)\n","[INFO] Scheduler: Cosine with 1 warmup epoch(s)\n","[INFO] Mixed precision (AMP): True\n"]}],"source":["# ==============================================================\n","# Cell 20: Optimizer, LR Scheduler, Mixed Precision\n","# ==============================================================\n","def build_optimizer_and_scheduler(model: nn.Module, config: Dict[str, Any],\n","                                   steps_per_epoch: int):\n","    '''Builds AdamW optimizer with a cosine-annealing LR schedule with linear warmup.\n","\n","    Args:\n","        model: The model whose trainable parameters will be optimized.\n","        config: Global CONFIG dictionary.\n","        steps_per_epoch: Number of optimizer steps per epoch (len(train_loader)).\n","\n","    Returns:\n","        (optimizer, scheduler) tuple.\n","    '''\n","    trainable_params = [p for p in model.parameters() if p.requires_grad]\n","    optimizer = torch.optim.AdamW(trainable_params, lr=config[\"lr\"],\n","                                   weight_decay=config[\"weight_decay\"])\n","\n","    total_steps = steps_per_epoch * config[\"epochs\"]\n","    warmup_steps = steps_per_epoch * config[\"warmup_epochs\"]\n","\n","    def lr_lambda(current_step: int) -> float:\n","        if current_step < warmup_steps:\n","            return float(current_step) / float(max(1, warmup_steps))\n","        progress = float(current_step - warmup_steps) / float(max(1, total_steps - warmup_steps))\n","        return 0.5 * (1.0 + math.cos(math.pi * progress))\n","\n","    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda)\n","    return optimizer, scheduler\n","\n","\n","if model is not None and len(dataloaders[\"train\"]) > 0:\n","    optimizer, scheduler = build_optimizer_and_scheduler(\n","        model, CONFIG, steps_per_epoch=len(dataloaders[\"train\"])\n","    )\n","    scaler = GradScaler(enabled=CONFIG[\"use_amp\"] and DEVICE.type == \"cuda\")\n","    print(f\"[INFO] Optimizer: AdamW(lr={CONFIG['lr']}, weight_decay={CONFIG['weight_decay']})\")\n","    print(f\"[INFO] Scheduler: Cosine with {CONFIG['warmup_epochs']} warmup epoch(s)\")\n","    print(f\"[INFO] Mixed precision (AMP): {scaler.is_enabled()}\")\n","else:\n","    optimizer, scheduler, scaler = None, None, None\n","    print(\"[WARN] Optimizer/scheduler not built — model or train loader unavailable.\")"]},{"cell_type":"code","execution_count":20,"id":"7ac35532","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:49.978775Z","iopub.status.busy":"2026-08-16T17:39:49.978466Z","iopub.status.idle":"2026-08-17T00:56:33.585342Z","shell.execute_reply":"2026-08-17T00:56:33.584278Z"},"papermill":{"duration":26203.619282,"end_time":"2026-08-17T00:56:33.587196+00:00","exception":false,"start_time":"2026-08-16T17:39:49.967914+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"d3dc9a8f505c40e7bedbfd00c3fae46c","version_major":2,"version_minor":0},"text/plain":["Train:   0%|          | 0/11397 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"b4dd9e9f05d345fc8ec2bc9760b8013d","version_major":2,"version_minor":0},"text/plain":["Eval:   0%|          | 0/8810 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["[Epoch 01/20] train_loss=0.2125 train_acc=0.9362 train_f1=0.7320 | val_loss=1.2871 val_acc=0.6952 val_f1=0.5803 | 4335.4s\n","  -> New best model saved (val_f1=0.5803) -> ./checkpoints/best_model.pt\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"755deb4e99f9444f8f6b25ab5c01af0e","version_major":2,"version_minor":0},"text/plain":["Train:   0%|          | 0/11397 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stderr","output_type":"stream","text":["Exception ignored in: <function _MultiProcessingDataLoaderIter.__del__ at 0x7ca455d9e7a0>\n","Traceback (most recent call