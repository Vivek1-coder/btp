er(all_targets, all_scores)\n        metrics[\"eer\"] = eer\n        metrics[\"eer_threshold\"] = eer_thresh\n    else:\n        metrics[\"roc_auc\"] = float(\"nan\")\n        metrics[\"eer\"] = float(\"nan\")\n        metrics[\"eer_threshold\"] = float(\"nan\")\n\n    metrics[\"targets\"] = all_targets\n    metrics[\"preds\"] = all_preds\n    metrics[\"scores\"] = all_scores\n    return metrics\n\n\nif model is not None and len(dataloaders[\"dev\"].dataset) > 0:\n    if os.path.exists(CONFIG[\"best_model_path\"]):\n        ckpt = torch.load(CONFIG[\"best_model_path\"], map_location=DEVICE)\n        model.load_state_dict(ckpt[\"model_state_dict\"])\n        print(f\"[INFO] Loaded best checkpoint from epoch {ckpt['epoch']} \"\n              f\"(val_f1={ckpt.get('val_f1', float('nan')):.4f}, val_eer={ckpt.get('val_eer', float('nan')):.4f})\")\n\n    dev_metrics = evaluate_full(model, dataloaders[\"dev\"], CONFIG)\n    print(\"\\n[VALIDATION SET METRICS] (early-stopping split, NOT the final held-out result)\")\n    for k in [\"accuracy\", \"precision\", \"recall\", \"f1\", \"roc_auc\", \"eer\"]:\n        print(f\"  {k:>10s}: {dev_metrics[k]:.4f}\")\nelse:\n    dev_metrics = None\n    print(\"[WARN] Skipping validation metrics — no trained model / val data available.\")\n","metadata":{"papermill":{"duration":1760.627914,"end_time":"2026-08-17T01:25:54.263062+00:00","exception":false,"start_time":"2026-08-17T00:56:33.635148+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def plot_confusion_matrix(targets: np.ndarray, preds: np.ndarray, save_path: str) -> None:\n    cm = confusion_matrix(targets, preds, labels=[0, 1])\n    fig, ax = plt.subplots(figsize=(5, 5))\n    im = ax.imshow(cm, cmap=\"Blues\")\n    ax.set_xticks([0, 1]); ax.set_xticklabels([\"Fake\", \"Real\"])\n    ax.set_yticks([0, 1]); ax.set_yticklabels([\"Fake\", \"Real\"])\n    ax.set_xlabel(\"Predicted\"); ax.set_ylabel(\"Ground Truth\")\n    ax.set_title(\"Confusion Matrix (held-out test set)\")\n    for i in range(2):\n        for j in range(2):\n            ax.text(j, i, str(cm[i, j]), ha=\"center\", va=\"center\",\n                     color=\"white\" if cm[i, j] > cm.max() / 2 else \"black\", fontsize=14)\n    fig.colorbar(im)\n    plt.tight_layout()\n    plt.savefig(save_path, dpi=150)\n    plt.show()\n\n\ndef plot_roc_curve(targets: np.ndarray, scores: np.ndarray, save_path: str) -> None:\n    fpr, tpr, _ = roc_curve(targets, scores, pos_label=1)\n    auc = roc_auc_score(targets, scores)\n    plt.figure(figsize=(6, 6))\n    plt.plot(fpr, tpr, label=f\"ROC curve (AUC = {auc:.4f})\")\n    plt.plot([0, 1], [0, 1], linestyle=\"--\", color=\"gray\", label=\"Chance\")\n    plt.xlabel(\"False Positive Rate\")\n    plt.ylabel(\"True Positive Rate\")\n    plt.title(\"ROC Curve (held-out test set)\")\n    plt.legend()\n    plt.grid(alpha=0.3)\n    plt.tight_layout()\n    plt.savefig(save_path, dpi=150)\n    plt.show()\n\n\nif model is not None and len(dataloaders[\"eval\"].dataset) > 0:\n    test_metrics = evaluate_full(model, dataloaders[\"eval\"], CONFIG)\n    print(\"\\n[HELD-OUT TEST SET METRICS] (speaker-disjoint from both train and validation)\")\n    for k in [\"accuracy\", \"precision\", \"recall\", \"f1\", \"roc_auc\", \"eer\"]:\n        print(f\"  {k:>10s}: {test_metrics[k]:.4f}\")\n\n    print(\"\\n[PER-CLASS CLASSIFICATION REPORT] (0=spoof/fake, 1=bonafide/real)\")\n    print(classification_report(test_metrics[\"targets\"], test_metrics[\"preds\"],\n                                 target_names=[\"spoof\", \"bonafide\"], zero_division=0))\n\n    plot_confusion_matrix(test_metrics[\"targets\"], test_metrics[\"preds\"],\n                           os.path.join(CONFIG[\"results_dir\"], \"confusion_matrix.png\"))\n    plot_roc_curve(test_metrics[\"targets\"], test_metrics[\"scores\"],\n                    os.path.join(CONFIG[\"results_dir\"], \"roc_curve.png\"))\n\n    eval_filepaths = eval_