form.shape[0]\n        if length >= self.max_len:\n            start = (length - self.max_len) // 2\n            waveform = waveform[start:start + self.max_len]\n        else:\n            waveform = F.pad(waveform, (0, self.max_len - length))\n        return waveform\n\n    @torch.no_grad()\n    def predict(self, filepath: str) -> Dict[str, Any]:\n        waveform = self._preprocess(filepath).unsqueeze(0).to(self.device)  # (1, T)\n\n        start_time = time.time()\n        logits = self.model(waveform)\n        probs = F.softmax(logits, dim=1).squeeze(0)\n        inference_time_ms = (time.time() - start_time) * 1000\n\n        threshold = self.config.get('decision_threshold', 0.5)\n        pred_class = 1 if probs[1] >= threshold else 0\n        label = \"Real\" if pred_class == 1 else \"Fake\"\n        confidence = float(probs[pred_class].item())\n\n        return {\n            \"filepath\": filepath,\n            \"label\": label,\n            \"probability_real\": float(probs[1].item()),\n            \"confidence\": confidence,\n            \"inference_time_ms\": inference_time_ms,\n        }\n\n\nif model is not None:\n    inferencer = DeepfakeInference(model, CONFIG, vad_fn=vad_fn, device=DEVICE)\n    if len(eval_df) > 0:\n        example_path = eval_df.iloc[0][\"filepath\"]\n        if os.path.exists(example_path):\n            result = inferencer.predict(example_path)\n            print(json.dumps(result, indent=2))\n        else:\n            print(f\"[WARN] Example file not found on disk: {example_path}\")\n    else:\n        print(\"[INFO] inferencer is ready. Call inferencer.predict('path/to/audio.wav') to test.\")\nelse:\n    inferencer = None\n    print(\"[WARN] Inference wrapper not created — model unavailable.\")","metadata":{"papermill":{"duration":0.072758,"end_time":"2026-08-17T01:25:54.505725+00:00","exception":false,"start_time":"2026-08-17T01:25:54.432967+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def summarize_model(model: nn.Module, config: Dict[str, Any]) -> pd.DataFrame:\n    rows = []\n    for name, module in model.named_children():\n        n_total = sum(p.numel() for p in module.parameters())\n        n_trainable = sum(p.numel() for p in module.parameters() if p.requires_grad)\n        rows.append({\"component\": name, \"total_params\": n_total, \"trainable_params\": n_trainable})\n\n    df = pd.DataFrame(rows)\n    total_params = sum(p.numel() for p in model.parameters())\n    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n    model_size_mb = total_params * 4 / (1024 ** 2)  # float32 = 4 bytes/param\n\n    print(df.to_string(index=False))\n    print(\"-\" * 60)\n    print(f\"{'TOTAL':>20s}: {total_params:,} params\")\n    print(f\"{'TRAINABLE':>20s}: {trainable_params:,} params\")\n    print(f\"{'MODEL SIZE (fp32)':>20s}: {model_size_mb:.2f} MB\")\n    return df\n\n\nif model is not None:\n    summary_df = summarize_model(model, CONFIG)\n    summary_df.to_csv(os.path.join(CONFIG[\"results_dir\"], \"model_summary.csv\"), index=False)\nelse:\n    print(\"[WARN] Cannot summarize — model unavailable.\")","metadata":{"papermill":{"duration":0.120176,"end_time":"2026-08-17T01:25:54.671653+00:00","exception":false,"start_time":"2026-08-17T01:25:54.551477+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def export_model(model: nn.Module, config: Dict[str, Any], device: torch.device) -> None:\n    export_dir = config[\"checkpoint_dir\"]\n    os.makedirs(export_dir, exist_ok=True)\n    model = model.to(device).eval()\n\n    state_dict_path = os.path.join(export_dir, \"deepfake_detector_state_dict.pt\")\n    torch.save(model.state_dict(), state_dict_path)\n    print(f\"[INFO] Saved PyTorch state_dict -> {state_dict_path}\")\n\n    dummy_input = torch.randn(1, int(config[\"max_audio_seconds\"] * config[\"sample_rate\"])).to