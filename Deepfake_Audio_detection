td>\n","      <td>0</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","      <td>D_5368</td>\n","      <td>D_0000000064</td>\n","      <td>/kaggle/input/datasets/ulianazb/asvspoof-2024/...</td>\n","      <td>A12</td>\n","      <td>spoof</td>\n","      <td>0</td>\n","    </tr>\n","    <tr>\n","      <th>4</th>\n","      <td>D_3166</td>\n","      <td>D_0000000085</td>\n","      <td>/kaggle/input/datasets/ulianazb/asvspoof-2024/...</td>\n","      <td>A15</td>\n","      <td>spoof</td>\n","      <td>0</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["  speaker_id     file_name                                           filepath  \\\n","0     D_0062  D_0000000001  /kaggle/input/datasets/ulianazb/asvspoof-2024/...   \n","1     D_0755  D_0000000022  /kaggle/input/datasets/ulianazb/asvspoof-2024/...   \n","2     D_0106  D_0000000043  /kaggle/input/datasets/ulianazb/asvspoof-2024/...   \n","3     D_5368  D_0000000064  /kaggle/input/datasets/ulianazb/asvspoof-2024/...   \n","4     D_3166  D_0000000085  /kaggle/input/datasets/ulianazb/asvspoof-2024/...   \n","\n","  attack_id  label  target  \n","0       A11  spoof       0  \n","1       A16  spoof       0  \n","2       A15  spoof       0  \n","3       A12  spoof       0  \n","4       A15  spoof       0  "]},"metadata":{},"output_type":"display_data"}],"source":["# ==============================================================\n","# Cell 7: Read ASVspoof 5 Metadata\n","# ==============================================================\n","\n","def empty_asvspoof_df():\n","    return pd.DataFrame(\n","        columns=[\n","            \"speaker_id\",\n","            \"file_name\",\n","            \"filepath\",\n","            \"attack_id\",\n","            \"label\",\n","            \"target\",\n","        ]\n","    )\n","\n","\n","def read_asvspoof5_metadata(\n","    metadata_path: Union[str, Path],\n","    audio_dir: Union[str, Path],\n","    audio_ext: str = \".flac\",\n",") -> pd.DataFrame:\n","    \"\"\"\n","    Parse the ASVspoof 5 metadata format used in this dataset.\n","\n","    Format:\n","        SPEAKER_ID FLAC_FILE_NAME GENDER CODEC ATTACK_ID KEY\n","\n","    Examples:\n","        T_4850 T_0000000000 F - A05 spoof\n","        T_1869 T_0000000011 F - bonafide bonafide\n","\n","    The final field (KEY) is the classification label:\n","        spoof\n","        bonafide\n","    \"\"\"\n","\n","    metadata_path = Path(metadata_path)\n","    audio_dir = Path(audio_dir)\n","\n","    if not metadata_path.exists():\n","        raise FileNotFoundError(\n","            f\"Metadata file not found:\\n{metadata_path}\"\n","        )\n","\n","    if not audio_dir.exists():\n","        raise FileNotFoundError(\n","            f\"Audio directory not found:\\n{audio_dir}\"\n","        )\n","\n","    print(f\"\\n[INFO] Metadata: {metadata_path}\")\n","    print(f\"[INFO] Audio directory: {audio_dir}\")\n","\n","    rows = []\n","\n","    malformed = 0\n","    unknown_labels = 0\n","\n","    with open(metadata_path, \"r\", encoding=\"utf-8\") as f:\n","\n","        for line_number, line in enumerate(f, start=1):\n","\n","            line = line.strip()\n","\n","            if not line:\n","                continue\n","\n","            parts = line.split()\n","\n","            # --------------------------------------------------\n","            # Expected:\n","            #\n","            # 0 -> speaker_id\n","            # 1 -> file_name\n","            # 2 -> gender\n","            # 3 -> codec\n","            # 4 -> attack_id\n","            # 5 -> label\n","            # --------------------------------------------------\n","\n","            if len(parts) < 6:\n","                malformed += 1\n","\n","                if malformed <= 5:\n","                    print(\n","                        f\"[WARNING] Malformed line {line_number}: \"\n","                        f\"{line}\"\n","                    )\n","\n","                continue\n","\n","            speaker_id = parts[0]\n","            file_name = parts[1]\n","            gender = parts[2]\n","            codec = parts[3]\n","            attack_id = parts[4]\n","            label = parts[5].lower()\n","\n","            # --------------------------------------------------\n","            # Only keep bonafide/spoof\n","            # --------------------------------------------------\n","\n","            if label not in CONFIG[\"label_map\"]:\n","                unknown_labels += 1\n","                continue\n","\n","            # --------------------------------------------------\n","            # Metadata contains filename WITHOUT .flac\n","            #\n","            # T_0000000000\n","            #\n","            # Therefore:\n","            #\n","            # T_0000000000.flac\n","            # --------------------------------------------------\n","\n","            file_path = audio_dir / f\"{file_name}{audio_ext}\"\n","\n","            target = CONFIG[\"label_map\"][label]\n","\n","            rows.append({\n","                \"speaker_id\": speaker_id,\n","                \"file_name\": file_name,\n","                \"filepath\": str(file_path),\n","                \"attack_id\": attack_id,\n","                \"label\": label,\n","                \"target\": target,\n","            })\n","\n","    # ----------------------------------------------------------\n","    # Create DataFrame\n","    # ----------------------------------------------------------\n","\n","    if not rows:\n","        print(\"\\n[ERROR] No valid metadata rows were found.\")\n","\n","        print(f\"Malformed rows: {malformed}\")\n","        print(f\"Unknown labels: {unknown_labels}\")\n","\n","        return empty_asvspoof_df()\n","\n","    df = pd.DataFrame(rows)\n","\n","    # ----------------------------------------------------------\n","    # Check actual audio files\n","    # ----------------------------------------------------------\n","\n","    exists = df[\"filepath\"].map(os.path.exists)\n","\n","    print(f\"\\n[INFO] Metadata entries: {len(df):,}\")\n","\n","    print(\n","        f\"[INFO] Audio files found: \"\n","        f\"{exists.sum():,} / {len(df):,}\"\n","    )\n","\n","    # ----------------------------------------------------------\n","    # Class distribution\n","    # ----------------------------------------------------------\n","\n","    print(\n","        f\"[INFO] Class distribution: \"\n","        f\"{df['label'].value_counts().to_dict()}\"\n","    )\n","\n","    # ----------------------------------------------------------\n","    # Show missing files if any\n","    # ----------------------------------------------------------\n","\n","    if not exists.all():\n","\n","        missing = df.loc[~exists, \"filepath\"]\n","\n","        print(\n","            f\"\\n[WARNING] Missing audio files: \"\n","            f\"{len(missing):,}\"\n","        )\n","\n","        print(\"\\n[DEBUG] First 5 missing files:\")\n","\n","        for path in missing.head(5):\n","            print(f\"    {path}\")\n","\n","    return df.reset_index(drop=True)\n","\n","\n","# ==============================================================\n","# Load Train + Dev\n","# ==============================================================\n","\n","def load_splits(\n","    protocol_paths: Dict[str, Path],\n","    train_audio_dir: Path,\n","    dev_audio_dir: Path,\n","    audio_ext: str = \".flac\",\n",") -> Dict[str, pd.DataFrame]:\n","\n","    splits = {}\n","\n","    # ----------------------------------------------------------\n","    # TRAIN\n","    # ----------------------------------------------------------\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"TRAIN SPLIT\")\n","    print(\"=\" * 70)\n","\n","    train_df = read_asvspoof5_metadata(\n","        metadata_path=protocol_paths[\"train\"],\n","        audio_dir=train_audio_dir,\n","        audio_ext=audio_ext,\n","    )\n","\n","    splits[\"train\"] = train_df\n","\n","    # ----------------------------------------------------------\n","    # DEV\n","    # ----------------------------------------------------------\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"DEV SPLIT\")\n","    print(\"=\" * 70)\n","\n","    dev_df = read_asvspoof5_metadata(\n","        metadata_path=protocol_paths[\"dev\"],\n","        audio_dir=dev_audio_dir,\n","        audio_ext=audio_ext,\n","    )\n","\n","    splits[\"dev\"] = dev_df\n","\n","    # ----------------------------------------------------------\n","    # No evaluation metadata in current dataset\n","    # ----------------------------------------------------------\n","\n","    splits[\"eval\"] = empty_asvspoof_df()\n","\n","    # ----------------------------------------------------------\n","    # Summary\n","    # ----------------------------------------------------------\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"DATASET SUMMARY\")\n","    print(\"=\" * 70)\n","\n","    print(f\"Train : {len(train_df):,}\")\n","    print(f\"Dev   : {len(dev_df):,}\")\n","    print(f\"Eval  : {len(splits['eval']):,} (not available)\")\n","\n","    return splits\n","\n","\n","# ==============================================================\n","# Build DataFrames\n","# ==============================================================\n","\n","splits = load_splits(\n","    protocol_paths=PROTOCOL_PATHS,\n","    train_audio_dir=TRAIN_AUDIO_DIR,\n","    dev_audio_dir=DEV_AUDIO_DIR,\n","    audio_ext=AUDIO_EXTENSION,\n",")\n","\n","train_df = splits[\"train\"]\n","dev_df = splits[\"dev\"]\n","eval_df = splits[\"eval\"]\n","\n","\n","# ==============================================================\n","# Sanity Check\n","# ==============================================================\n","\n","if len(train_df) == 0:\n","    raise RuntimeError(\n","        \"Training DataFrame is empty. \"\n","        \"Check metadata and audio paths.\"\n","    )\n","\n","if len(dev_df) == 0:\n","    raise RuntimeError(\n","        \"Development DataFrame is empty. \"\n","        \"Check metadata and audio paths.\"\n","    )\n","\n","print(\"\\n[INFO] Train sample:\")\n","display(train_df.head())\n","\n","print(\"\\n[INFO] Dev sample:\")\n","display(dev_df.head())"]},{"cell_type":"code","execution_count":7,"id":"9393bb47","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:39.639085Z","iopub.status.busy":"2026-08-16T17:39:39.638774Z","iopub.status.idle":"2026-08-16T17:39:39.651099Z","shell.execute_reply":"2026-08-16T17:39:39.650514Z"},"papermill":{"duration":0.019747,"end_time":"2026-08-16T17:39:39.65234+00:00","exception":false,"start_time":"2026-08-16T17:39:39.632593+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] ASVspoofDataset and collate_fn defined.\n"]}],"source":["# ==============================================================\n","# Cell 8: Dataset class\n","# ==============================================================\n","class ASVspoofDataset(Dataset):\n","    '''PyTorch Dataset for ASVspoof2024 bonafide/spoof audio classification.\n","\n","    Loads raw waveforms, resamples to the target sample rate, and (optionally)\n","    applies VAD + waveform-level augmentation. Feature extraction (log-mel) is\n","    performed downstream in the collate function / training loop for flexibility.\n","\n","    Args:\n","        df: DataFrame with columns ['filepath', 'target'] as produced by\n","            `read_asvspoof_protocol`.\n","        config: Global CONFIG dictionary.\n","        train: If True, waveform augmentations may be applied.\n","        apply_vad_fn: Optional callable(waveform, sr) -> waveform, used to strip silence.\n","    '''\n","\n","    def __init__(self,\n","                 df: pd.DataFrame,\n","                 config: Dict[str, Any],\n","                 train: bool = False,\n","                 apply_vad_fn: Optional[Any] = None):\n","        self.df = df.reset_index(drop=True)\n","        self.config = config\n","        self.train = train\n","        self.apply_vad_fn = apply_vad_fn\n","        self.sample_rate = config[\"sample_rate\"]\n","        self.max_len = int(config[\"max_audio_seconds\"] * self.sample_rate)\n","\n","    def __len__(self) -> int:\n","        return len(self.df)\n","\n","    def _load_waveform(self, filepath: str) -> torch.Tensor:\n","        '''Load an audio file and resample to the target sample rate (mono).'''\n","        waveform, sr = torchaudio.load(filepath)\n","        if waveform.shape[0] > 1:\n","            waveform = waveform.mean(dim=0, keepdim=True)  # downmix to mono\n","        if sr != self.sample_rate:\n","            resampler = T.Resample(orig_freq=sr, new_freq=self.sample_rate)\n","            waveform = resampler(waveform)\n","        return waveform.squeeze(0)  # (T,)\n","\n","    def _fix_length(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''Center-pad or randomly-crop/trim waveform to a fixed length.'''\n","        length = waveform.shape[0]\n","        if length >= self.max_len:\n","            if self.train:\n","                start = random.randint(0, length - self.max_len)\n","            else:\n","                start = (length - self.max_len) // 2\n","            waveform = waveform[start:start + self.max_len]\n","        else:\n","            pad = self.max_len - length\n","            waveform = F.pad(waveform, (0, pad))\n","        return waveform\n","\n","    def __getitem__(self, idx: int) -> Dict[str, Any]:\n","        row = self.df.iloc[idx]\n","        filepath = row[\"filepath\"]\n","        target = int(row[\"target\"])\n","\n","        try:\n","            waveform = self._load_waveform(filepath)\n","        except Exception as e:\n","            warnings.warn(f\"Failed to load {filepath}: {e}. Returning silence.\")\n","            waveform = torch.zeros(self.max_len)\n","\n","        if self.config.get(\"use_vad\", True) and self.apply_vad_fn is not None:\n","            waveform = self.apply_vad_fn(waveform, self.sample_rate)\n","\n","        waveform = self._fix_length(waveform)\n","\n","        return {\n","            \"waveform\": waveform,\n","            \"target\": torch.tensor(target, dtype=torch.long),\n","            \"filepath\": filepath,\n","        }\n","\n","\n","def collate_fn(batch: List[Dict[str, Any]]) -> Dict[str, Any]:\n","    '''Collate a list of dataset samples into a batch.'''\n","    waveforms = torch.stack([b[\"waveform\"] for b in batch], dim=0)\n","    targets = torch.stack([b[\"target\"] for b in batch], dim=0)\n","    filepaths = [b[\"filepath\"] for b in batch]\n","    return {\"waveform\": waveforms, \"target\": targets, \"filepath\": filepaths}\n","\n","print(\"[INFO] ASVspoofDataset and collate_fn defined.\")"]},{"cell_type":"code","execution_count":8,"id":"db26146c","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:39.664212Z","iopub.status.busy":"2026-08-16T17:39:39.66367Z","iopub.status.idle":"2026-08-16T17:39:39.669669Z","shell.execute_reply":"2026-08-16T17:39:39.669052Z"},"papermill":{"duration":0.013436,"end_time":"2026-08-16T17:39:39.671017+00:00","exception":false,"start_time":"2026-08-16T17:39:39.657581+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ==============================================================\n","# Cell 9: DataLoaders\n","# ==============================================================\n","def build_dataloaders(train_df: pd.DataFrame,\n","                       dev_df: pd.DataFrame,\n","                       eval_df: pd.DataFrame,\n","                       config: Dict[str, Any],\n","                       vad_fn: Optional[Any] = None) -> Dict[str, DataLoader]:\n","    '''Construct train/dev/eval DataLoaders from protocol DataFrames.'''\n","    train_ds = ASVspoofDataset(train_df, config, train=True, apply_vad_fn=vad_fn)\n","    dev_ds = ASVspoofDataset(dev_df, config, train=False, apply_vad_fn=vad_fn)\n","    eval_ds = ASVspoofDataset(eval_df, config, train=False, apply_vad_fn=vad_fn)\n","\n","    loaders = {\n","        \"train\": DataLoader(train_ds, batch_size=config[\"batch_size\"], shuffle=True,\n","                             num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n","                             pin_memory=True, drop_last=True),\n","        \"dev\": DataLoader(dev_ds, batch_size=config[\"batch_size\"], shuffle=False,\n","                           num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n","                           pin_memory=True),\n","        \"eval\": DataLoader(eval_ds, batch_size=config[\"batch_size\"], shuffle=False,\n","                            num_workers=config[\"num_workers\"], collate_fn=collate_fn,\n","                            pin_memory=True),\n","    }\n","    for name, loader in loaders.items():\n","        print(f\"[{name.upper():5s}] {len(loader.dataset)} samples -> {len(loader)} batches \"\n","              f\"(batch_size={config['batch_size']})\")\n","    return loaders\n","\n","# NOTE: dataloaders are (re)built in Cell 10 once the VAD function is available,\n","# so that VAD can be applied inside the Dataset."]},{"cell_type":"code","execution_count":9,"id":"0baf7861","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:39.682476Z","iopub.status.busy":"2026-08-16T17:39:39.682192Z","iopub.status.idle":"2026-08-16T17:39:39.722349Z","shell.execute_reply":"2026-08-16T17:39:39.721608Z"},"papermill":{"duration":0.047762,"end_time":"2026-08-16T17:39:39.723919+00:00","exception":false,"start_time":"2026-08-16T17:39:39.676157+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[TRAIN] 182357 samples -> 11397 batches (batch_size=16)\n","[DEV  ] 140950 samples -> 8810 batches (batch_size=16)\n","[EVAL ] 0 samples -> 0 batches (batch_size=16)\n","[INFO] VAD module ready: EnergyVAD\n"]}],"source":["# ==============================================================\n","# Cell 10: Voice Activity Detection (VAD)\n","# ==============================================================\n","class EnergyVAD:\n","    '''Lightweight, dependency-free energy-based Voice Activity Detector.\n","\n","    Splits the waveform into fixed-length frames, computes per-frame log-energy,\n","    and keeps only frames above an adaptive threshold. This avoids a hard\n","    dependency on `webrtcvad` while still removing leading/trailing/inner silence,\n","    which is important for anti-spoofing since silence padding can leak\n","    recording-device / dataset artifacts unrelated to the bonafide/spoof decision.\n","\n","    Args:\n","        sample_rate: Audio sample rate in Hz.\n","        frame_ms: Frame length in milliseconds used for energy computation.\n","        threshold_db: Frames with energy below (max_energy_db + threshold_db) are dropped.\n","    '''\n","\n","    def __init__(self, sample_rate: int = 16000, frame_ms: int = 30, threshold_db: float = -35.0):\n","        self.sample_rate = sample_rate\n","        self.frame_len = int(sample_rate * frame_ms / 1000)\n","        self.threshold_db = threshold_db\n","\n","    def __call__(self, waveform: torch.Tensor, sample_rate: int) -> torch.Tensor:\n","        '''Remove non-speech (low-energy) frames from a waveform.\n","\n","        Args:\n","            waveform: 1D tensor of shape (T,).\n","            sample_rate: Sample rate of `waveform` (assumed to match self.sample_rate).\n","\n","        Returns:\n","            1D tensor containing only the speech-active frames concatenated together.\n","            Falls back to the original waveform if VAD would remove everything.\n","        '''\n","        wav = waveform.numpy()\n","        n_frames = max(1, len(wav) // self.frame_len)\n","        frames = [wav[i * self.frame_len:(i + 1) * self.frame_len] for i in range(n_frames)]\n","\n","        energies_db = []\n","        for fr in frames:\n","            energy = np.mean(fr ** 2) + 1e-10\n","            energies_db.append(10 * np.log10(energy))\n","        energies_db = np.array(energies_db)\n","\n","        if len(energies_db) == 0:\n","            return waveform\n","\n","        max_db = energies_db.max()\n","        active_mask = energies_db >= (max_db + self.threshold_db)\n","\n","        if active_mask.sum() == 0:\n","            # Nothing passed the threshold -> keep original audio rather than return silence.\n","            return waveform\n","\n","        active_frames = [frames[i] for i in range(len(frames)) if active_mask[i]]\n","        active_wav = np.concatenate(active_frames)\n","        return torch.from_numpy(active_wav).float()\n","\n","\n","class WebRTCVAD:\n","    '''Wrapper around the `webrtcvad` library (optional dependency).\n","\n","    Falls back gracefully to EnergyVAD if `webrtcvad` is not installed.\n","    '''\n","\n","    def __init__(self, sample_rate: int = 16000, frame_ms: int = 30, aggressiveness: int = 2):\n","        self.sample_rate = sample_rate\n","        self.frame_ms = frame_ms\n","        self.frame_len = int(sample_rate * frame_ms / 1000)\n","        try:\n","            import webrtcvad\n","            self.vad = webrtcvad.Vad(aggressiveness)\n","            self.available = True\n","        except ImportError:\n","            warnings.warn(\"webrtcvad not installed; falling back to EnergyVAD.\")\n","            self.available = False\n","            self._fallback = EnergyVAD(sample_rate, frame_ms)\n","\n","    def __call__(self, waveform: torch.Tensor, sample_rate: int) -> torch.Tensor:\n","        if not self.available:\n","            return self._fallback(waveform, sample_rate)\n","\n","        wav_int16 = (waveform.numpy() * 32768.0).astype(np.int16)\n","        n_frames = len(wav_int16) // self.frame_len\n","        active_frames = []\n","        for i in range(n_frames):\n","            frame_bytes = wav_int16[i * self.frame_len:(i + 1) * self.frame_len].tobytes()\n","            if len(frame_bytes) < self.frame_len * 2:\n","                continue\n","            if self.vad.is_speech(frame_bytes, self.sample_rate):\n","                active_frames.append(wav_int16[i * self.frame_len:(i + 1) * self.frame_len])\n","\n","        if len(active_frames) == 0:\n","            return waveform\n","\n","        active_wav = np.concatenate(active_frames).astype(np.float32) / 32768.0\n","        return torch.from_numpy(active_wav)\n","\n","\n","# Instantiate the VAD used throughout the pipeline (energy-based by default; robust, no extra deps).\n","vad_fn = EnergyVAD(\n","    sample_rate=CONFIG[\"sample_rate\"],\n","    frame_ms=CONFIG[\"vad_frame_ms\"],\n","    threshold_db=CONFIG[\"vad_energy_threshold_db\"],\n",") if CONFIG[\"use_vad\"] else None\n","\n","# Now that vad_fn exists, build the real dataloaders.\n","dataloaders = build_dataloaders(train_df, dev_df, eval_df, CONFIG, vad_fn=vad_fn)\n","print(\"[INFO] VAD module ready:\", type(vad_fn).__name__ if vad_fn else \"disabled\")"]},{"cell_type":"code","execution_count":10,"id":"c90141be","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:39.736242Z","iopub.status.busy":"2026-08-16T17:39:39.735821Z","iopub.status.idle":"2026-08-16T17:39:46.229809Z","shell.execute_reply":"2026-08-16T17:39:46.228898Z"},"papermill":{"duration":6.506213,"end_time":"2026-08-16T17:39:46.235736+00:00","exception":false,"start_time":"2026-08-16T17:39:39.729523+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1600x400 with 4 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# ==============================================================\n","# Cell 11: Feature extraction — 80-bin Log-Mel Spectrogram\n","# ==============================================================\n","class LogMelSpectrogramExtractor(nn.Module):\n","    '''Computes an 80-bin log-Mel spectrogram from a raw waveform batch.\n","\n","    Wraps `torchaudio.transforms.MelSpectrogram` with log-compression, and is\n","    implemented as an `nn.Module` so it moves to GPU with `.to(device)` and can\n","    be placed directly inside the model's forward pass if desired.\n","    '''\n","\n","    def __init__(self, config: Dict[str, Any]):\n","        super().__init__()\n","        self.mel_spec = T.MelSpectrogram(\n","            sample_rate=config[\"sample_rate\"],\n","            n_fft=config[\"n_fft\"],\n","            hop_length=config[\"hop_length\"],\n","            win_length=config[\"win_length\"],\n","            n_mels=config[\"n_mels\"],\n","            power=2.0,\n","        )\n","        self.amplitude_to_db = T.AmplitudeToDB(stype=\"power\", top_db=80)\n","\n","    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            waveform: (B, T) raw audio tensor.\n","\n","        Returns:\n","            (B, n_mels, frames) log-mel spectrogram tensor.\n","        '''\n","        mel = self.mel_spec(waveform)           # (B, n_mels, frames)\n","        log_mel = self.amplitude_to_db(mel)      # log-scaled, dB\n","        # Per-utterance normalization (zero mean, unit variance) stabilizes training.\n","        mean = log_mel.mean(dim=(-2, -1), keepdim=True)\n","        std = log_mel.std(dim=(-2, -1), keepdim=True) + 1e-6\n","        log_mel = (log_mel - mean) / std\n","        return log_mel\n","\n","\n","mel_extractor = LogMelSpectrogramExtractor(CONFIG).to(DEVICE)\n","\n","# ---- Visualize a few example spectrograms ----\n","def visualize_spectrograms(loader: DataLoader, extractor: nn.Module, n_examples: int = 4) -> None:\n","    '''Plot log-mel spectrograms for a handful of real and fake examples.'''\n","    batch = next(iter(loader))\n","    waveforms = batch[\"waveform\"][:n_examples].to(DEVICE)\n","    targets = batch[\"target\"][:n_examples]\n","\n","    with torch.no_grad():\n","        specs = extractor(waveforms).cpu().numpy()\n","\n","    fig, axes = plt.subplots(1, n_examples, figsize=(4 * n_examples, 4))\n","    if n_examples == 1:\n","        axes = [axes]\n","    for i, ax in enumerate(axes):\n","        label = \"Bonafide (Real)\" if targets[i].item() == 1 else \"Spoof (Fake)\"\n","        img = librosa.display.specshow(specs[i], sr=CONFIG[\"sample_rate\"],\n","                                        hop_length=CONFIG[\"hop_length\"],\n","                                        x_axis=\"time\", y_axis=\"mel\", ax=ax, cmap=\"magma\")\n","        ax.set_title(label)\n","    fig.suptitle(\"Log-Mel Spectrogram Examples (Normalized)\")\n","    plt.tight_layout()\n","    plt.savefig(os.path.join(CONFIG[\"results_dir\"], \"sample_spectrograms.png\"), dpi=150)\n","    plt.show()\n","\n","if len(dataloaders[\"train\"].dataset) > 0:\n","    visualize_spectrograms(dataloaders[\"train\"], mel_extractor)\n","else:\n","    print(\"[WARN] Train dataset is empty — populate DATA_ROOT with ASVspoof2024 to visualize spectrograms.\")"]},{"cell_type":"code","execution_count":11,"id":"f6ed8b0a","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:46.256248Z","iopub.status.busy":"2026-08-16T17:39:46.255815Z","iopub.status.idle":"2026-08-16T17:39:46.270654Z","shell.execute_reply":"2026-08-16T17:39:46.269814Z"},"papermill":{"duration":0.027525,"end_time":"2026-08-16T17:39:46.272267+00:00","exception":false,"start_time":"2026-08-16T17:39:46.244742+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[INFO] Augmentation modules ready: WaveformAugmenter (noise/pitch/stretch), SpecAugment (freq/time mask).\n"]}],"source":["# ==============================================================\n","# Cell 12: Data Augmentation (SpecAugment + waveform-level augmentation)\n","# ==============================================================\n","class WaveformAugmenter:\n","    '''Waveform-level augmentations applied before feature extraction: additive\n","    noise, pitch shift, and time stretch. Each is applied stochastically.\n","    '''\n","\n","    def __init__(self, config: Dict[str, Any]):\n","        self.config = config\n","        self.sample_rate = config[\"sample_rate\"]\n","\n","    def add_noise(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''Add Gaussian noise at a randomly sampled SNR (dB).'''\n","        snr_low, snr_high = self.config[\"noise_snr_db_range\"]\n","        snr_db = random.uniform(snr_low, snr_high)\n","        signal_power = waveform.pow(2).mean()\n","        noise_power = signal_power / (10 ** (snr_db / 10))\n","        noise = torch.randn_like(waveform) * torch.sqrt(noise_power + 1e-12)\n","        return waveform + noise\n","\n","    def pitch_shift(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''Shift pitch by a random number of semitones using librosa.'''\n","        low, high = self.config[\"pitch_shift_semitones_range\"]\n","        n_steps = random.uniform(low, high)\n","        wav_np = waveform.numpy()\n","        shifted = librosa.effects.pitch_shift(y=wav_np, sr=self.sample_rate, n_steps=n_steps)\n","        return torch.from_numpy(shifted).float()\n","\n","    def time_stretch(self, waveform: torch.Tensor) -> torch.Tensor:\n","        '''Time-stretch the waveform and crop/pad back to the original length.'''\n","        low, high = self.config[\"time_stretch_rate_range\"]\n","        rate = random.uniform(low, high)\n","        wav_np = waveform.numpy()\n","        stretched = librosa.effects.time_stretch(y=wav_np, rate=rate)\n","        stretched = torch.from_numpy(stretched).float()\n","\n","        orig_len = waveform.shape[0]\n","        if stretched.shape[0] > orig_len:\n","            start = random.randint(0, stretched.shape[0] - orig_len)\n","            stretched = stretched[start:start + orig_len]\n","        else:\n","            stretched = F.pad(stretched, (0, orig_len - stretched.shape[0]))\n","        return stretched\n","\n","    def __call__(self, waveform: torch.Tensor) -> torch.Tensor:\n","        if random.random() < self.config[\"noise_prob\"]:\n","            waveform = self.add_noise(waveform)\n","        if random.random() < self.config[\"pitch_shift_prob\"]:\n","            waveform = self.pitch_shift(waveform)\n","        if random.random() < self.config[\"time_stretch_prob\"]:\n","            waveform = self.time_stretch(waveform)\n","        return waveform\n","\n","\n","class SpecAugment(nn.Module):\n","    '''SpecAugment: frequency masking + time masking applied to a log-mel spectrogram batch.'''\n","\n","    def __init__(self, config: Dict[str, Any]):\n","        super().__init__()\n","        self.freq_mask = T.FrequencyMasking(freq_mask_param=config[\"spec_freq_mask_param\"])\n","        self.time_mask = T.TimeMasking(time_mask_param=config[\"spec_time_mask_param\"])\n","\n","    def forward(self, spec: torch.Tensor) -> torch.Tensor:\n","        '''\n","        Args:\n","            spec: (B, n_mels, frames) log-mel spectrogram.\n","\n","        Returns:\n","            Augmented spectrogram of the same shape.\n","        '''\n","        spec = self.freq_mask(spec)\n","        spec = self.time_mask(spec)\n","        return spec\n","\n","\n","waveform_augmenter = WaveformAugmenter(CONFIG)\n","spec_augmenter = SpecAugment(CONFIG).to(DEVICE)\n","\n","\n","def augment_batch_waveforms(waveforms: torch.Tensor, augmenter: WaveformAugmenter) -> torch.Tensor:\n","    '''Apply waveform-level augmentation independently to each item in a batch (CPU tensors).'''\n","    out = []\n","    for i in range(waveforms.shape[0]):\n","        out.append(augmenter(waveforms[i]))\n","    return torch.stack(out, dim=0)\n","\n","print(\"[INFO] Augmentation modules ready: WaveformAugmenter (noise/pitch/stretch), SpecAugment (freq/time mask).\")"]},{"cell_type":"code","execution_count":12,"id":"61c45ef1","metadata":{"execution":{"iopub.execute_input":"2026-08-16T17:39:46.290436Z","iopub.status.busy":"2026-08-16T17:39:46.289924Z","iopub.status.idle":"2026-08-16T17:39:49.344399Z","shell