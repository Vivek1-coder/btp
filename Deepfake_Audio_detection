","  \"use_vad\": true,\n","  \"vad_frame_ms\": 30,\n","  \"vad_energy_threshold_db\": -35.0,\n","  \"ssl_model_name\": \"ntu-spml/distilhubert\",\n","  \"ssl_freeze\": true,\n","  \"ssl_finetune\": false,\n","  \"ssl_unfreeze_last_n_layers\": 2,\n","  \"ssl_finetune_lr\": 2e-05,\n","  \"ssl_output_dim\": 768,\n","  \"cnn_backbone\": \"temporal_cnn\",\n","  \"temporal_cnn_channels\": [\n","    256,\n","    256,\n","    128\n","  ],\n","  \"temporal_cnn_kernel_size\": 5,\n","  \"cnn_pretrained\": true,\n","  \"cnn_out_dim\": 128,\n","  \"use_wavelet\": true,\n","  \"wavelet_name\": \"db4\",\n","  \"wavelet_level\": 3,\n","  \"wavelet_out_dim\": 128,\n","  \"attention_hidden_dim\": 128,\n","  \"classifier_hidden_dim\": 256,\n","  \"dropout\": 0.4,\n","  \"num_classes\": 2,\n","  \"batch_size\": 48,\n","  \"num_workers\": 4,\n","  \"epochs\": 30,\n","  \"lr\": 0.0003,\n","  \"weight_decay\": 0.0005,\n","  \"warmup_epochs\": 1,\n","  \"use_amp\": true,\n","  \"use_focal_loss\": false,\n","  \"focal_gamma\": 2.0,\n","  \"label_smoothing\": 0.05,\n","  \"grad_clip_norm\": 5.0,\n","  \"early_stopping_patience\": 6,\n","  \"selection_metric\": \"val_eer\",\n","  \"use_weighted_sampler\": true,\n","  \"use_loss_class_weights\": false,\n","  \"use_augmentation\": true,\n","  \"spec_freq_mask_param\": 15,\n","  \"spec_time_mask_param\": 25,\n","  \"noise_prob\": 0.4,\n","  \"noise_snr_db_range\": [\n","    5,\n","    20\n","  ],\n","  \"pitch_shift_prob\": 0.1,\n","  \"pitch_shift_semitones_range\": [\n","    -2,\n","    2\n","  ],\n","  \"time_stretch_prob\": 0.1,\n","  \"time_stretch_rate_range\": [\n","    0.9,\n","    1.1\n","  ],\n","  \"test_fraction_of_speakers\": 0.3,\n","  \"checkpoint_dir\": \"./checkpoints\",\n","  \"results_dir\": \"./results\",\n","  \"best_model_path\": \"./checkpoints/best_model.pt\",\n","  \"seed\": 42,\n","  \"label_map\": {\n","    \"bonafide\": 1,\n","    \"spoof\": 0\n","  }\n","}\n"]}],"source":["# ==============================================================\n","# Cell 5: Configuration dictionary\n","# ==============================================================\n","# NOTE (v2): values/keys marked CHANGED or NEW were modified from the original\n","# notebook based on the diagnosis in Cell 1 (overfitting, axis-mismatched CNN,\n","# double-corrected class imbalance, slow augmentation, no held-out test set).\n","CONFIG: Dict[str, Any] = {\n","    # ---------------- Audio ----------------\n","    \"sample_rate\": 16000,\n","    \"max_audio_seconds\": 4.0,          # utterances are trimmed/padded to this length\n","    \"n_fft\": 512,\n","    \"hop_length\": 160,\n","    \"win_length\": 400,\n","    \"n_mels\": 80,\n","\n","    # ---------------- VAD ----------------\n","    \"use_vad\": True,\n","    \"vad_frame_ms\": 30,\n","    \"vad_energy_threshold_db\": -35.0,  # used by the energy-based VAD fallback\n","\n","    # ---------------- SSL Encoder ----------------\n","    \"ssl_model_name\": \"ntu-spml/distilhubert\",  # DistilHuBERT on HuggingFace Hub\n","    \"ssl_freeze\": True,                 # base freeze flag (kept for backward compat)\n","    \"ssl_finetune\": False,              # legacy \"unfreeze everything\" flag; too expensive/unstable, kept off\n","    \"ssl_unfreeze_last_n_layers\": 2,    # NEW: partial fine-tuning of only the last N transformer layers\n","    \"ssl_finetune_lr\": 2e-5,            # NEW: small discriminative LR for the unfrozen SSL layers\n","    \"ssl_output_dim\": 768,              # DistilHuBERT hidden size\n","\n","    # ---------------- Temporal CNN backbone ----------------\n","    # CHANGED: replaces the v1 \"reshape SSL sequence into an image, run through\n","    # ImageNet-pretrained MobileNetV3\" backbone (axis mismatch — see Cell 1). The\n","    # SSL \"channel\" axis has no spatial locality, so 2D conv + ImageNet weights\n","    # don't transfer. A Conv1d stack over time (SSL dim = channels) is the\n","    # architecturally correct, still-lightweight replacement.\n","    \"cnn_backbone\": \"temporal_cnn\",         # \"temporal_cnn\" (recommended) | \"mobilenetv3_small\" (legacy) | \"efficientnet_lite0\" (legacy)\n","    \"temporal_cnn_channels\": [256, 256, 128],   # NEW: Conv1d channel progression\n","    \"temporal_cnn_kernel_size\": 5,              # NEW\n","    \"cnn_pretrained\": True,             # only consulted by the legacy image backbones\n","    \"cnn_out_dim\": 128,                 # auto-detected/overwritten at runtime\n","\n","    # ---------------- Wavelet block ----------------\n","    \"use_wavelet\": True,\n","    \"wavelet_name\": \"db4\",\n","    \"wavelet_level\": 3,\n","    \"wavelet_out_dim\": 128,\n","\n","    # ---------------- Attention pooling ----------------\n","    \"attention_hidden_dim\": 128,\n","\n","    # ---------------- Classifier ----------------\n","    \"classifier_hidden_dim\": 256,\n","    \"dropout\": 0.4,                     # CHANGED 0.3 -> 0.4: stronger regularization (v1 overfit within epoch 1)\n","    \"num_classes\": 2,   # 0 = fake/spoof, 1 = real/bonafide\n","\n","    # ---------------- Training ----------------\n","    \"batch_size\": 48,                   # CHANGED 16 -> 48: backbone is mostly frozen + augmentation is now parallel, so throughput allows larger batches\n","    \"num_workers\": 4,\n","    \"epochs\": 30,                       # CHANGED 20 -> 30: early stopping still applies; cheap now that epochs are much faster\n","    \"lr\": 3e-4,                         # LR for the newly-added temporal CNN / wavelet / attention / classifier\n","    \"weight_decay\": 5e-4,               # CHANGED 1e-4 -> 5e-4: extra regularization\n","    \"warmup_epochs\": 1,\n","    \"use_amp\": True,\n","    \"use_focal_loss\": False,\n","    \"focal_gamma\": 2.0,\n","    \"label_smoothing\": 0.05,            # NEW: mild regularization / better-calibrated probabilities for EER\n","    \"grad_clip_norm\": 5.0,\n","    \"early_stopping_patience\": 6,\n","    \"selection_metric\": \"val_eer\",      # NEW: select checkpoint by EER (lower=better) — the standard anti-spoofing metric, rather than F1 which is threshold- and imbalance-sensitive\n","\n","    # ---------------- Class imbalance ----------------\n","    \"use_weighted_sampler\": True,       # NEW: primary imbalance fix, applied at the data level (train loader only)\n","    \"use_loss_class_weights\": False,    # CHANGED: off by default. v1 combined loss re-weighting with an already-imbalanced sampling scheme, which likely over-corrected and biased predictions toward \"bonafide\" (v1 dev recall=0.94 / precision=0.42 on that class). Stacking both corrections is redundant; the sampler alone is the intended fix here.\n","\n","    # ---------------- Augmentation ----------------\n","    \"use_augmentation\": True,\n","    \"spec_freq_mask_param\": 15,\n","    \"spec_time_mask_param\": 25,\n","    \"noise_prob\": 0.4,\n","    \"noise_snr_db_range\": (5, 20),\n","    \"pitch_shift_prob\": 0.1,            # CHANGED 0.2 -> 0.1: this op (librosa phase-vocoder) is the single slowest augmentation; used sparingly now that it runs per-worker instead of on the main process\n","    \"pitch_shift_semitones_range\": (-2, 2),\n","    \"time_stretch_prob\": 0.1,           # CHANGED 0.2 -> 0.1: same reasoning as pitch_shift\n","    \"time_stretch_rate_range\": (0.9, 1.1),\n","\n","    # ---------------- Data split ----------------\n","    \"test_fraction_of_speakers\": 0.3,   # NEW: fraction of *dev* speakers held out as an untouched final test set (speaker-disjoint from the validation speakers used for early stopping)\n","\n","    # ---------------- Paths ----------------\n","    \"checkpoint_dir\": \"./checkpoints\",\n","    \"results_dir\": \"./results\",\n","    \"best_model_path\": \"./checkpoints/best_model.pt\",\n","\n","    # ---------------- Misc ----------------\n","    \"seed\": SEED,\n","    \"label_map\": {\"bonafide\": 1, \"spoof\": 0},  # real = 1, fake = 0\n","}\n","\n","os.makedirs(CONFIG