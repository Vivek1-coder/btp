m, num_classes),\n        )\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        return self.net(x)\n\nprint(\"[INFO] ClassifierHead defined (v2: Dropout moved after GELU).\")\n","metadata":{"execution":{"iopub.status.busy":"2026-08-17T05:15:27.801342Z","iopub.execute_input":"2026-08-17T05:15:27.801688Z","iopub.status.idle":"2026-08-17T05:15:27.81652Z","shell.execute_reply.started":"2026-08-17T05:15:27.801659Z","shell.execute_reply":"2026-08-17T05:15:27.815954Z"},"papermill":{"duration":0.017938,"end_time":"2026-08-16T17:39:49.626534+00:00","exception":false,"start_time":"2026-08-16T17:39:49.608596+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class DeepfakeDetector(nn.Module):\n    def __init__(self,\n                 ssl_encoder: TinySSLEncoder,\n                 cnn_backbone: nn.Module,\n                 wavelet_block: Optional[WaveletBlock],\n                 config: Dict[str, Any]):\n        super().__init__()\n        self.ssl_encoder = ssl_encoder\n        self.cnn_backbone = cnn_backbone\n        self.wavelet_block = wavelet_block\n        self.config = config\n        self._use_temporal_cnn = (config[\"cnn_backbone\"] == \"temporal_cnn\")\n\n        self.attn_pool = SelfAttentionPooling(\n            input_dim=config[\"ssl_output_dim\"],\n            hidden_dim=config[\"attention_hidden_dim\"],\n        )\n\n        fused_dim = config[\"cnn_out_dim\"] + config[\"ssl_output_dim\"]\n        if wavelet_block is not None:\n            fused_dim += wavelet_block.out_dim\n\n        self.classifier = ClassifierHead(\n            input_dim=fused_dim,\n            hidden_dim=config[\"classifier_hidden_dim\"],\n            num_classes=config[\"num_classes\"],\n            dropout=config[\"dropout\"],\n        )\n\n    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n        ssl_feats = self.ssl_encoder(waveform)\n        ssl_pooled = self.attn_pool(ssl_feats)        