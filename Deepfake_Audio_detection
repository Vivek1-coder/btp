onfig[\"n_mels\"],\n            power=2.0,\n        )\n        self.amplitude_to_db = T.AmplitudeToDB(stype=\"power\", top_db=80)\n\n    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n        '''\n        Args:\n            waveform: (B, T) raw audio tensor.\n\n        Returns:\n            (B, n_mels, frames) log-mel spectrogram tensor.\n        '''\n        mel = self.mel_spec(waveform)           # (B, n_mels, frames)\n        log_mel = self.amplitude_to_db(mel)      # log-scaled, dB\n        # Per-utterance normalization (zero mean, unit variance) stabilizes training.\n        mean = log_mel.mean(dim=(-2, -1), keepdim=True)\n        std = log_mel.std(dim=(-2, -1), keepdim=True) + 1e-6\n        log_mel = (log_mel - mean) / std\n        return log_mel\n\n\nmel_extractor = LogMelSpectrogramExtractor(CONFIG).to(DEVICE)\n\n# ---- Visualize a few example spectrograms ----\ndef visualize_spectrograms(loader: DataLoader, extractor: nn.Module, n_examples: int = 4) -> None:\n    '''Plot log-mel spectrograms for a handful of real and fake examples.'''\n    batch = next(iter(loader))\n    waveforms = batch[\"waveform\"][:n_examples].to(DEVICE)\n    targets = batch[\"target\"][:n_examples]\n\n    with torch.no_grad():\n        specs = extractor(waveforms).cpu().numpy()\n\n    fig, axes = plt.subplots(1, n_examples, figsize=(4 * n_examples, 4))\n    if n_examples == 1:\n        axes = [axes]\n    for i, ax in enumerate(axes):\n        label = \"Bonafide (Real)\" if targets[i].item() == 1 else \"Spoof (Fake)\"\n        img = librosa.display.specshow(specs[i], sr=CONFIG[\"sample_rate\"],\n                                        hop_length=CONFIG[\"hop_length\"],\n                                        x_axis=\"time\", y_axis=\"mel\", ax=ax, cmap=\"magma\")\n        ax.set_title(label)\n    fig.suptitle(\"Log-Mel Spectrogram Examples (Normalized)\")\n    plt.tight_layout()\n    plt.savefig(os.path.join(CONFIG[\"results_dir\"], \"sample_spectrograms.png\"), dpi=150)\n    plt.show()\n\nif len(dataloaders[\"train\"].dataset) > 0:\n    visualize_spectrograms(dataloaders[\"train\"], mel_extractor)\nelse:\n    print(\"[WARN] Train dataset is empty — populate DATA_ROOT with ASVspoof2024 to visualize spectrograms.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.400131Z","iopub.status.idle":"2026-08-14T17:34:25.40046Z","shell.execute_reply.started":"2026-08-14T17:34:25.40032Z","shell.execute_reply":"2026-08-14T17:34:25.400342Z"}},"outputs":[],"execution_count":null},{"id":"adf1a5dc-9196-4383-b558-2019e958441c","cell_type":"code","source":"# ==============================================================\n# Cell 12: Data Augmentation (SpecAugment + waveform-level augmentation)\n# ==============================================================\nclass WaveformAugmenter:\n    '''Waveform-level augmentations applied before feature extraction: additive\n    noise, pitch shift, and time stretch. Each is applied stochastically.\n    '''\n\n    def __init__(self, config: Dict[str, Any]):\n        self.config = config\n        self.sample_rate = config[\"sample_rate\"]\n\n    def add_noise(self, waveform: torch.Tensor) -> torch.Tensor:\n        '''Add Gaussian noise at a randomly sampled SNR (dB).'''\n        snr_low, snr_high = self.config[\"noise_snr_db_range\"]\n        snr_db = random.uniform(snr_low, snr_high)\n        signal_power = waveform.pow(2).mean()\n        noise_power = signal_power / (10 ** (snr_db / 10))\n        noise = torch.randn_like(waveform) * torch.sqrt(noise_power + 1e-12)\n        return waveform + noise\n\n    def pitch_shift(self, waveform: torch.Tensor) -> torch.Tensor:\n        '''Shift pitch by a random number of semitones using librosa.'''\n        low, high = self.config[\"pitch_shift_semitones_range\"]\n        n_steps = random.uniform(low, high)\n        wav_np = waveform.numpy()\n        shifted = librosa.effects.pitch_shift(y=wav_np, sr=self.sample_rate, n_steps=n_steps)\n        return torch.from_numpy(shifted).float()\n\n    def time_stretch(self, waveform: torch.Tensor) -> torch.Tensor:\n        '''Time-stretch the waveform and crop/pad back to the original length.'''\n        low, high = self.config[\"time_stretch_rate_range\"]\n        rate = random.uniform(low, high)\n        wav_np = waveform.numpy()\n        stretched = librosa.effects.time_stretch(y=wav_np, rate=rate)\n        stretched = torch.from_numpy(stretched).float()\n\n        orig_len = waveform.shape[0]\n        if stretched.shape[0] > orig_len:\n            start = random.randint(0, stretched.shape[0] - orig_len)\n            stretched = stretched[start:start + orig_len]\n        else:\n            stretched = F.pad(stretched, (0, orig_len - stretched.shape[0]))\n        return stretched\n\n    def __call__(self, waveform: torch.Tensor) -> torch.Tensor:\n        if random.random() < self.config[\"noise_prob\"]:\n            waveform = self.add_noise(waveform)\n        if random.random() < self.config[\"pitch_shift_prob\"]:\n            waveform = self.pitch_shift(waveform)\n        if random.random() < self.config[\"time_stretch_prob\"]:\n            waveform = self.time_stretch(waveform)\n        return waveform\n\n\nclass SpecAugment(nn.Module):\n    '''SpecAugment: frequency masking + time masking applied to a log-mel spectrogram batch.'''\n\n    def __init__(self, config: Dict[str, Any]):\n        super().__init__()\n        self.freq_mask = T.FrequencyMasking(freq_mask_param=config[\"spec_freq_mask_param\"])\n        self.time_mask = T.TimeMasking(time_mask_param=config[\"spec_time_mask_param\"])\n\n    def forward(self, spec: torch.Tensor) -> torch.Tensor:\n        '''\n        Args:\n            spec: (B, n_mels, frames) log-mel spectrogram.\n\n        Returns:\n            Augmented spectrogram of the same shape.\n        '''\n        spec = self.freq_mask(spec)\n        spec = self.time_mask(spec)\n        return spec\n\n\nwaveform_augmenter = WaveformAugmenter(CONFIG)\nspec_augmenter = SpecAugment(CONFIG).to(DEVICE)\n\n\ndef augment_batch_waveforms(waveforms: torch.Tensor, augmenter: WaveformAugmenter) -> torch.Tensor:\n    '''Apply waveform-level augmentation independently to each item in a batch (CPU tensors).'''\n    out = []\n    for i in range(waveforms.shape[0]):\n        out.append(augmenter(waveforms[i]))\n    return torch.stack(out, dim=0)\n\nprint(\"[INFO] Augmentation modules ready: WaveformAugmenter (noise/pitch/stretch), SpecAugment (freq/time mask).\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.401558Z","iopub.status.idle":"2026-08-14T17:34:25.401787Z","shell.execute_reply.started":"2026-08-14T17:34:25.401677Z","shell.execute_reply":"2026-08-14T17:34:25.40169Z"}},"outputs":[],"execution_count":null},{"id":"9842b365-d7a0-46c8-a207-cf3404b836f6","cell_type":"code","source":"# ==============================================================\n# Cell 13: Tiny SSL Encoder (DistilHuBERT)\n# ==============================================================\nclass TinySSLEncoder(nn.Module):\n    '''Tiny self-supervised speech encoder wrapping a distilled HuBERT model\n    (DistilHuBERT) from HuggingFace. Consumes raw waveforms and outputs a\n    sequence of contextualized frame-level embeddings.\n\n    Args:\n        model_name: HuggingFace hub id, e.g. \"ntu-spml/distilhubert\".\n        freeze: If True, all SSL encoder parameters are frozen (no gradient).\n        finetune: If True, unfreezes the SSL encoder for end-to-end fine-tuning.\n            `finetune=True` overrides `freeze`.\n        sample_rate: Expected input sample rate (must match the SSL model's\n            pretraining sample rate, typically 16 kHz).\n    '''\n\n    def __init__(self,\n                 model_name: str = \"ntu-spml/distilhubert\",\n                 freeze: bool = True,\n                 finetune: bool = False,\n                 sample_rate: int = 16000):\n        super().__init__()\n        self.sample_rate = sample_rate\n        self.model = AutoModel.from_pretrained(model_name)\n        self.output_dim = self.model.config.hidden_size\n\n        do_freeze = freeze and not finetune\n        for param in self.model.parameters():\n            param.requires_grad = not do_freeze\n        self.model.train(mode=not do_freeze)  # keep in eval-like mode if frozen\n        self._frozen = do_freeze\n\n    def set_finetune(self, finetune: bool) -> None:\n        '''Toggle fine-tuning of the SSL encoder at runtime (single config flag).'''\n        for param in self.model.parameters():\n            param.requires_grad = finetune\n        self._frozen = not finetune\n\n    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n        '''\n        Args:\n            waveform: (B, T) raw audio at `self.sample_rate`.\n\n        Returns:\n            (B, frames, hidden_size) contextualized SSL embeddings.\n        '''\n        if self._frozen:\n            with torch.no_grad():\n                outputs = self.model(waveform)\n        else:\n            outputs = self.model(waveform)\n        return outputs.last_hidden_state  # (B, frames, hidden_size)\n\n\n# Instantiate the SSL encoder (downloads pretrained weights from the HF Hub).\ntry:\n    ssl_encoder = TinySSLEncoder(\n        model_name=CONFIG[\"ssl_model_name\"],\n        freeze=CONFIG[\"ssl_freeze\"],\n        finetune=CONFIG[\"ssl_finetune\"],\n        sample_rate=CONFIG[\"sample_rate\"],\n    ).to(DEVICE)\n    CONFIG[\"ssl_output_dim\"] = ssl_encoder.output_dim\n    n_trainable = sum(p.numel() for p in ssl_encoder.parameters() if p.requires_grad)\n    print(f\"[INFO] Loaded SSL encoder '{CONFIG['ssl_model_name']}' \"\n          f\"(hidden_size={ssl_encoder.output_dim}, trainable_params={n_trainable:,}, \"\n          f\"frozen={ssl_encoder._frozen})\")\nexcept Exception as e:\n    print(f\"[WARN] Could not download SSL encoder weights ({e}). \"\n          f\"Ensure internet access / the model id is correct before training.\")\n    ssl_encoder = None","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.403497Z","iopub.status.idle":"2026-08-14T17:34:25.404105Z","shell.execute_reply.started":"2026-08-14T17:34:25.403879Z","shell.execute_reply":"2026-08-14T17:34:25.403904Z"}},"outputs":[],"execution_count":null},{"id":"f781616b-d47c-4b48-adad-c40d845dde94","cell_type":"code","source":"# ==============================================================\n# Cell 14: Lightweight CNN backbone (MobileNetV3-Small / EfficientNet-Lite0)\n# ==============================================================\nclass LightweightCNN(nn.Module):\n    '''Lightweight CNN feature extractor operating on a 2D feature map\n    (e.g., the SSL embedding sequence reshaped/treated as an \"image\").\n\n    Supports:\n      - \"mobilenetv3_small\": torchvision MobileNetV3-Small, classifier removed.\n      - \"efficientnet_lite0\": timm EfficientNet-Lite0, classifier removed.\n\n    The chosen backbone's first conv is adapted to accept a single input channel\n    (our features are single-channel \"images\": time x SSL-dim), and both are\n    used purely as convolutional feature extractors (global-pooled embeddings).\n\n    Args:\n        backbone: \"mobilenetv3_small\" or \"efficientnet_lite0\".\n        pretrained: Whether to load ImageNet-pretrained weights.\n        in_channels: Number of input channels (1 for our SSL-feature-map input).\n    '''\n\n    def __init__(self, backbone: str = \"mobilenetv3_small\", pretrained: bool = True,\n                 in_channels: int = 1):\n        super().__init__()\n        self.backbone_name = backbone\n\n        if backbone == \"mobilenetv3_small\":\n            net = torchvision.models.mobilenet_v3_small(\n                weights=torchvision.models.MobileNet_V3_Small_Weights.DEFAULT if pretrained else None\n            )\n            # Adapt first conv to accept `in_channels` instead of 3.\n            old_conv = net.features[0][0]\n            new_conv = nn.Conv2d(in_channels, old_conv.out_channels,\n                                  kernel_size=old_conv.kernel_size, stride=old_conv.stride,\n                                  padding=old_conv.padding, bias=False)\n            with torch.no_grad():\n                new_conv.weight[:] = old_conv.weight.mean(dim=1, keepdim=True).repeat(1, in_channels, 1, 1)\n            net.features[0][0] = new_conv\n            self.features = net.features\n            self.pool = nn.AdaptiveAvgPool2d(1)\n            self.out_dim = net.classifier[0].in_features  # 576 for mobilenet_v3_small\n\n        elif backbone == \"efficientnet_lite0\":\n            net = timm.create_model(\"efficientnet_lite0\", pretrained=pretrained,\n                                     in_chans=in_channels, num_classes=0, global_pool=\"avg\")\n            self.features = net\n            self.pool = None  # timm model with num_classes=0 already returns pooled features\n            self.out_dim = net.num_features\n\n        else:\n            raise ValueError(f\"Unknown backbone: {backbone}\")\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        '''\n        Args:\n            x: (B, in_channels, H, W) feature map.\n\n        Returns:\n            (B, out_dim) pooled embedding.\n        '''\n        if self.backbone_name == \"mobilenetv3_small\":\n            feats = self.features(x)          # (B, C, H', W')\n            pooled = self.pool(feats)          # (B, C, 1, 1)\n            return pooled.flatten(1)           # (B, C)\n        else:  # efficientnet_lite0 (timm, pooling built-in)\n            return self.features(x)\n\n\ncnn_backbone = LightweightCNN(\n    backbone=CONFIG[\"cnn_backbone\"],\n    pretrained=CONFIG[\"cnn_pretrained\"],\n    in_channels=1,\n).to(DEVICE)\nCONFIG[\"cnn_out_dim\"] = cnn_backbone.out_dim\n\nn_params = sum(p.numel() for p in cnn_backbone.parameters())\nprint(f\"[INFO] Loaded CNN backbone '{CONFIG['cnn_backbone']}' \"\n      f\"(out_dim={cnn_backbone.out_dim}, total_params={n_params:,})\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.405205Z","iopub.status.idle":"2026-08-14T17:34:25.405605Z","shell.execute_reply.started":"2026-08-14T17:34:25.405409Z","shell.execute_reply":"2026-08-14T17:34:25.405431Z"}},"outputs":[],"execution_count":null},{"id":"9e732370-ed65-4955-95a7-b30921ead4f7","cell_type":"code","source":"# ==============================================================\n# Cell 15: (Optional) Wavelet Block — DWT feature fusion\n# ==============================================================\nclass WaveletBlock(nn.Module):\n    '''Extracts multi-resolution Discrete Wavelet Transform (DWT) statistics\n    from the raw waveform and projects them into a fixed-size embedding to be\n    fused with the CNN embedding.\n\n    Motivation: vocoder-based TTS/voice-conversion artifacts often manifest as\n    subtle high-frequency sub-band irregularities that a wavelet decomposition\n    can expose more directly than a Mel spectrogram alone.\n\n    Args:\n        wavelet_name: PyWavelets wavelet family, e.g. \"db4\".\n        level: Number of DWT decomposition levels.\n        out_dim: Output embedding dimensionality after projection.\n    '''\n\n    def __init__(self, wavelet_name: str = \"db4\", level: int = 3, out_dim: int = 128):\n        super().__init__()\n        self.wavelet_name = wavelet_name\n        self.level = level\n        # 5 summary statistics per sub-band (mean, std, max, min, energy) x (level+1) sub-bands.\n        n_subbands = level + 1\n        in_dim = n_subbands * 5\n        self.proj = nn.Sequential(\n            nn.Linear(in_dim, out_dim),\n            nn.GELU(),\n            nn.LayerNorm(out_dim),\n        )\n        self.out_dim = out_dim\n\n    def _dwt_features_single(self, wav_np: np.ndarray) -> np.ndarray:\n        '''Compute summary statistics over DWT coefficients for one waveform.'''\n        coeffs = pywt.wavedec(wav_np, self.wavelet_name, level=self.level)\n        feats = []\n        for c in coeffs:\n            c = c.astype(np.float64)\n            feats.extend([\n                c.mean(),\n                c.std(),\n                c.max() if c.size > 0 else 0.0,\n                c.min() if c.size > 0 else 0.0,\n                np.sum(c ** 2) / max(c.size, 1),  # average energy\n            ])\n        return np.array(feats, dtype=np.float32)\n\n    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n        '''\n        Args:\n            waveform: (B, T) raw audio tensor (CPU or GPU; DWT itself runs on CPU/numpy).\n\n        Returns:\n            (B, out_dim) wavelet embedding, on the same device as `waveform`.\n        '''\n        device = waveform.device\n        wav_np = waveform.detach().cpu().numpy()\n        batch_feats = np.stack([self._dwt_features_single(w) for w in wav_np], axis=0)\n        batch_feats = torch.from_numpy(batch_feats).float().to(device)\n        return self.proj(batch_feats)\n\n\nwavelet_block = WaveletBlock(\n    wavelet_name=CONFIG[\"wavelet_name\"],\n    level=CONFIG[\"wavelet_level\"],\n    out_dim=CONFIG[\"wavelet_out_dim\"],\n).to(DEVICE) if CONFIG[\"use_wavelet\"] else None\n\nprint(f\"[INFO] Wavelet block {'ENABLED' if wavelet_block is not None else 'DISABLED'} \"\n      f\"({CONFIG['wavelet_name']}, level={CONFIG['wavelet_level']}, \"\n      f\"out_dim={CONFIG['wavelet_out_dim']})\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.407114Z","iopub.status.idle":"2026-08-14T17:34:25.407885Z","shell.execute_reply.started":"2026-08-14T17:34:25.407696Z","shell.execute_reply":"2026-08-14T17:34:25.407719Z"}},"outputs":[],"execution_count":null},{"id":"73f92f8f-e6e4-4f78-878f-2fb29b81fb30","cell_type":"code","source":"# ==============================================================\n# Cell 16: Self-Attention Pooling\n# ==============================================================\nclass SelfAttentionPooling(nn.Module):\n    '''Self-attention pooling layer that collapses a sequence of frame-level\n    embeddings into a single utterance-level embedding using a learned\n    attention weight per frame (Lee et al., \"Self-Attentive Pooling\").\n\n    Args:\n        input_dim: Dimensionality of each frame embedding.\n        hidden_dim: Hidden size of the attention scoring MLP.\n    '''\n\n    def __init__(self, input_dim: int, hidden_dim: int = 128):\n        super().__init__()\n        self.attention = nn.Sequential(\n            nn.Linear(input_dim, hidden_dim),\n            nn.Tanh(),\n            nn.Linear(hidden_dim, 1),\n        )\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        '''\n        Args:\n            x: (B, T, D) sequence of frame embeddings.\n\n        Returns:\n            (B, D) attention-weighted utterance embedding.\n        '''\n        scores = self.attention(x)                 # (B, T, 1)\n        weights = torch.softmax(scores, dim=1)      # (B, T, 1)\n        pooled = torch.sum(weights * x, dim=1)      # (B, D)\n        return pooled\n\nprint(\"[INFO] SelfAttentionPooling defined.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.409103Z","iopub.status.idle":"2026-08-14T17:34:25.409547Z","shell.execute_reply.started":"2026-08-14T17:34:25.409342Z","shell.execute_reply":"2026-08-14T17:34:25.409378Z"}},"outputs":[],"execution_count":null},{"id":"b33800c2-252b-4e0e-b2fc-67beb66aa63f","cell_type":"code","source":"# ==============================================================\n# Cell 17: Classifier Head\n# ==============================================================\nclass ClassifierHead(nn.Module):\n    '''Final MLP classifier head: Linear -> Dropout -> GELU -> Linear -> logits.\n\n    Args:\n        input_dim: Dimensionality of the fused utterance embedding.\n        hidden_dim: Hidden layer width.\n        num_classes: Number of output classes (2 for real/fake).\n        dropout: Dropout probability.\n    '''\n\n    def __init__(self, input_dim: int, hidden_dim: int = 256,\n                 num_classes: int = 2, dropout: float = 0.3):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, hidden_dim),\n            nn.Dropout(dropout),\n            nn.GELU(),\n            nn.Linear(hidden_dim, num_classes),\n        )\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        '''\n        Args:\n            x: (B, input_dim) fused embedding.\n\n        Returns:\n            (B, num_classes) raw logits.\n        '''\n        return self.net(x)\n\nprint(\"[INFO] ClassifierHead defined.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.410724Z","iopub.status.idle":"2026-08-14T17:34:25.41118Z","shell.execute_reply.started":"2026-08-14T17:34:25.410884Z","shell.execute_reply":"2026-08-14T17:34:25.410904Z"}},"outputs":[],"execution_count":null},{"id":"47304413-e4d5-4254-8921-54d31d638be3","cell_type":"code","source":"# ==============================================================\n# Cell 18: Complete Model — DeepfakeDetector\n# ==============================================================\nclass DeepfakeDetector(nn.Module):\n    '''End-to-end lightweight deepfake audio detector.\n\n    Pipeline: raw waveform -> (VAD applied upstream in Dataset) -> log-mel\n    spectrogram -> Tiny SSL encoder -> reshape to 2D map -> Lightweight CNN\n    -> [+ optional wavelet features] -> Self-Attention Pooling (on CNN's\n    spatial sequence) -> fused embedding -> Classifier -> logits.\n\n    Args:\n        mel_extractor: LogMelSpectrogramExtractor module (kept for API completeness;\n            the SSL encoder consumes raw waveform directly per DistilHuBERT design).\n        ssl_encoder: TinySSLEncoder module.\n        cnn_backbone: LightweightCNN module.\n        wavelet_block: Optional WaveletBlock module (None to disable).\n        config: Global CONFIG dictionary.\n    '''\n\n    def __init__(self,\n                 ssl_encoder: TinySSLEncoder,\n                 cnn_backbone: LightweightCNN,\n                 wavelet_block: Optional[WaveletBlock],\n                 config: Dict[str, Any]):\n        super().__init__()\n        self.ssl_encoder = ssl_encoder\n        self.cnn_backbone = cnn_backbone\n        self.wavelet_block = wavelet_block\n        self.config = config\n\n        # Project the SSL hidden_size down to a small number of \"channels\" so the\n        # (B, frames, ssl_dim) sequence can be treated as a (B, 1, frames, ssl_dim) image.\n        self.ssl_to_image_channels = 1\n\n        # Attention pooling operates on the SSL sequence directly (pre-CNN) to\n        # produce a second, complementary utterance embedding.\n        self.attn_pool = SelfAttentionPooling(\n            input_dim=config[\"ssl_output_dim\"],\n            hidden_dim=config[\"attention_hidden_dim\"],\n        )\n\n        fused_dim = config[\"cnn_out_dim\"] + config[\"ssl_output_dim\"]\n        if wavelet_block is not None:\n            fused_dim += wavelet_block.out_dim\n\n        self.classifier = ClassifierHead(\n            input_dim=fused_dim,\n            hidden_dim=config[\"classifier_hidden_dim\"],\n            num_classes=config[\"num_classes\"],\n            dropout=config[\"dropout\"],\n        )\n\n    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n        '''\n        Args:\n            waveform: (B, T) raw audio (already VAD-processed & length-normalized).\n\n        Returns:\n            (B, num_classes) classification logits.\n        '''\n        # 1) Tiny SSL encoder -> (B, frames, ssl_dim)\n        ssl_feats = self.ssl_encoder(waveform)\n\n        # 2) Attention-pooled SSL embedding (utterance-level, complementary to CNN branch)\n        ssl_pooled = self.attn_pool(ssl_feats)                       # (B, ssl_dim)\n\n        # 3) Treat the SSL sequence as a single-channel 2D \"image\": (B, 1, frames, ssl_dim)\n        cnn_input = ssl_feats.unsqueeze(1)\n        cnn_feats = self.cnn_backbone(cnn_input)                     # (B, cnn_out_dim)\n\n        # 4) Optional wavelet-domain features from the raw waveform\n        fused = [cnn_feats, ssl_pooled]\n        if self.wavelet_block is not None:\n            wavelet_feats = self.wavelet_block(waveform)             # (B, wavelet_out_dim)\n            fused.append(wavelet_feats)\n\n        fused_embedding = torch.cat(fused, dim=1)                    # (B, fused_dim)\n\n        # 5) Classify\n        logits = self.classifier(fused_embedding)                    # (B, num_classes)\n        return logits\n\n\nmodel = DeepfakeDetector(\n    ssl_encoder=ssl_encoder,\n    cnn_backbone=cnn_backbone,\n    wavelet_block=wavelet_block,\n    config=CONFIG,\n).to(DEVICE) if ssl_encoder is not None else None\n\nif model is not None:\n    total_params = sum(p.numel() for p in model.parameters())\n    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n    print(f\"[INFO] DeepfakeDetector built. Total params: {total_params:,} | \"\n          f\"Trainable params: {trainable_params:,}\")\nelse:\n    print(\"[WARN] Model not built because the SSL encoder failed to load (see Cell 13).\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.412359Z","iopub.status.idle":"2026-08-14T17:34:25.412581Z","shell.execute_reply.started":"2026-08-14T17:34:25.412478Z","shell.execute_reply":"2026-08-14T17:34:25.412491Z"}},"outputs":[],"execution_count":null},{"id":"aa3b9668-3c31-454b-83fb-ae103622dd60","cell_type":"code","source":"# ==============================================================\n# Cell 19: Loss Functions\n# ==============================================================\nclass FocalLoss(nn.Module):\n    '''Multi-class Focal Loss (Lin et al., 2017), useful under class imbalance\n    (ASVspoof training sets are typically dominated by spoof utterances).\n\n    Args:\n        gamma: Focusing parameter; higher values down-weight easy examples more.\n        weight: Optional per-class weight tensor (as in `nn.CrossEntropyLoss`).\n        reduction: 'mean' | 'sum' | 'none'.\n    '''\n\n    def __init__(self, gamma: float = 2.0, weight: Optional[torch.Tensor] = None,\n                 reduction: str = \"mean\"):\n        super().__init__()\n        self.gamma = gamma\n        self.weight = weight\n        self.reduction = reduction\n\n    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:\n        ce_loss = F.cross_entropy(logits, targets, weight=self.weight, reduction=\"none\")\n        pt = torch.exp(-ce_loss)\n        focal_loss = ((1 - pt) ** self.gamma) * ce_loss\n        if self.reduction == \"mean\":\n            return focal_loss.mean()\n        elif self.reduction == \"sum\":\n            return focal_loss.sum()\n        return focal_loss\n\n\ndef build_loss_fn(config: Dict[str, Any], class_weights: Optional[torch.Tensor] = None) -> nn.Module:\n    '''Factory for the training loss function, selected via CONFIG['use_focal_loss'].'''\n    if config[\"use_focal_loss\"]:\n        return FocalLoss(gamma=config[\"focal_gamma\"], weight=class_weights)\n    return nn.CrossEntropyLoss(weight=class_weights)\n\n\n# Compute inverse-frequency class weights from the training split to counter class imbalance.\nif len(train_df) > 0:\n    class_counts = train_df[\"target\"].value_counts().sort_index()\n    weights = (1.0 / class_counts).reindex(range(CONFIG[\"num_classes\"])).fillna(1.0)\n    weights = (weights / weights.sum()) * CONFIG[\"num_classes\"]\n    class_weights = torch.tensor(weights.values, dtype=torch.float32).to(DEVICE)\nelse:\n    class_weights = None\n\ncriterion = build_loss_fn(CONFIG, class_weights)\nprint(f\"[INFO] Loss function: {type(criterion).__name__} | class_weights={class_weights}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.413622Z","iopub.status.idle":"2026-08-14T17:34:25.413886Z","shell.execute_reply.started":"2026-08-14T17:34:25.413777Z","shell.execute_reply":"2026-08-14T17:34:25.41379Z"}},"outputs":[],"execution_count":null},{"id":"b43abe15-f8a9-4db6-ad3f-9da5c5d8cd7b","cell_type":"code","source":"# ==============================================================\n# Cell 20: Optimizer, LR Scheduler, Mixed Precision\n# ==============================================================\ndef build_optimizer_and_scheduler(model: nn.Module, config: Dict[str, Any],\n                                   steps_per_epoch: int):\n    '''Builds AdamW optimizer with a cosine-annealing LR schedule with linear warmup.\n\n    Args:\n        model: The model whose trainable parameters will be optimized.\n        config: Global CONFIG dictionary.\n        steps_per_epoch: Number of optimizer steps per epoch (len(train_loader)).\n\n    Returns:\n        (optimizer, scheduler) tuple.\n    '''\n    trainable_params = [p for p in model.parameters() if p.requires_grad]\n    optimizer = torch.optim.AdamW(trainable_params, lr=config[\"lr\"],\n                                   weight_decay=config[\"weight_decay\"])\n\n    total_steps = steps_per_epoch * config[\"epochs\"]\n    warmup_steps = steps_per_epoch * config[\"warmup_epochs\"]\n\n    def lr_lambda(current_step: int) -> float:\n        if current_step < warmup_steps:\n            return float(current_step) / float(max(1, warmup_steps))\n        progress = float(current_step - warmup_steps) / float(max(1, total_steps - warmup_steps))\n        return 0.5 * (1.0 + math.cos(math.pi * progress))\n\n    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda)\n    return optimizer, scheduler\n\n\nif model is not None and len(dataloaders[\"train\"]) > 0:\n    optimizer, scheduler = build_optimizer_and_scheduler(\n        model, CONFIG, steps_per_epoch=len(dataloaders[\"train\"])\n    )\n    scaler = GradScaler(enabled=CONFIG[\"use_amp\"] and DEVICE.type == \"cuda\")\n    print(f\"[INFO] Optimizer: AdamW(lr={CONFIG['lr']}, weight_decay={CONFIG['weight_decay']})\")\n    print(f\"[INFO] Scheduler: Cosine with {CONFIG['warmup_epochs']} warmup epoch(s)\")\n    print(f\"[INFO] Mixed precision (AMP): {scaler.is_enabled()}\")\nelse:\n    optimizer, scheduler, scaler = None, None, None\n    print(\"[WARN] Optimizer/scheduler not built — model or train loader unavailable.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.415187Z","iopub.status.idle":"2026-08-14T17:34:25.41548Z","shell.execute_reply.started":"2026-08-14T17:34:25.415368Z","shell.execute_reply":"2026-08-14T17:34:25.415382Z"}},"outputs":[],"execution_count":null},{"id":"389b3b5a-7689-49a6-b0cb-ae99700442a3","cell_type":"code","source":"# ==============================================================\n# Cell 21: Training Loop\n# ==============================================================\ndef run_epoch(model: nn.Module,\n              loader: DataLoader,\n              mel_extractor: nn.Module,\n              criterion: nn.Module,\n              config: Dict[str, Any],\n              optimizer: Optional[torch.optim.Optimizer] = None,\n              scheduler: Optional[torch.optim.lr_scheduler._LRScheduler] = None,\n              scaler: Optional[GradScaler] = None,\n              augmenter: Optional[WaveformAugmenter] = None,\n              train: bool = True) -> Dict[str, float]:\n    '''Run one epoch of training or evaluation.\n\n    Args:\n        model: DeepfakeDetector model.\n        loader: DataLoader for this epoch (train or dev).\n        mel_extractor: (Unused directly by the model's forward, kept for API symmetry\n            / available for auxiliary spectrogram-based losses or visualization.)\n        criterion: Loss function.\n        config: Global CONFIG dictionary.\n        optimizer: Required if `train=True`.\n        scheduler: Optional LR scheduler, stepped once per batch if provided.\n        scaler: GradScaler for AMP; ignored if AMP disabled.\n        augmenter: Optional WaveformAugmenter, applied only when `train=True`.\n        train: Whether to run in training (True) or evaluation (False) mode.\n\n    Returns:\n        Dict with keys: 'loss', 'accuracy', 'f1'.\n    '''\n    model.train() if train else model.eval()\n\n    total_loss, all_preds, all_targets = 0.0, [], []\n    use_amp = config[\"use_amp\"] and DEVICE.type == \"cuda\"\n\n    pbar = tqdm(loader, desc=\"Train\" if train else \"Eval\", leave=False)\n    for batch in pbar:\n        waveform = batch[\"waveform\"]\n        if train and config[\"use_augmentation\"] and augmenter is not None:\n            waveform = augment_batch_waveforms(waveform, augmenter)\n        waveform = waveform.to(DEVICE, non_blocking=True)\n        target = batch[\"target\"].to(DEVICE, non_blocking=True)\n\n        with torch.set_grad_enabled(train):\n            with autocast(enabled=use_amp):\n                logits = model(waveform)\n                loss = criterion(logits, target)\n\n            if train:\n                optimizer.zero_grad(set_to_none=True)\n                scaler.scale(loss).backward()\n                scaler.unscale_(optimizer)\n                torch.nn.utils.clip_grad_norm_(model.parameters(), config[\"grad_clip_norm\"])\n                scaler.step(optimizer)\n                scaler.update()\n                if scheduler is not None:\n                    scheduler.step()\n\n        total_loss += loss.item() * waveform.size(0)\n        preds = torch.argmax(logits, dim=1)\n        all_preds.extend(preds.detach().cpu().numpy().tolist())\n        all_targets.extend(target.detach().cpu().numpy().tolist())\n        pbar.set_postfix(loss=f\"{loss.item():.4f}\")\n\n    avg_loss = total_loss / max(1, len(loader.dataset))\n    acc = accuracy_score(all_targets, all_preds) if all_targets else 0.0\n    f1 = f1_score(all_targets, all_preds, zero_division=0) if all_targets else 0.0\n\n    return {\"loss\": avg_loss, \"accuracy\": acc, \"f1\": f1}\n\n\ndef train_model(model: nn.Module,\n                 dataloaders: Dict[str, DataLoader],\n                 mel_extractor: nn.Module,\n                 criterion: nn.Module,\n                 optimizer: torch.optim.Optimizer,\n                 scheduler: torch.optim.lr_scheduler._LRScheduler,\n                 scaler: GradScaler,\n                 augmenter: WaveformAugmenter,\n                 config: Dict[str, Any]) -> Dict[str, List[float]]:\n    '''Full training loop with per-epoch metrics, best-checkpoint saving, and early stopping.'''\n    history = {\"train_loss\": [], \"train_acc\": [], \"train_f1\": [],\n               \"val_loss\": [], \"val_acc\": [], \"val_f1\": []}\n\n    best_val_f1 = -1.0\n    patience_counter = 0\n\n    for epoch in range(1, config[\"epochs\"] + 1):\n        t0 = time.time()\n\n        train_metrics = run_epoch(model, dataloaders[\"train\"], mel_extractor, criterion, config,\n                                   optimizer=optimizer, scheduler=scheduler, scaler=scaler,\n                                   augmenter=augmenter, train=True)\n        val_metrics = run_epoch(model, dataloaders[\"dev\"], mel_extractor, criterion, config,\n                                 train=False)\n\n        history[\"train_loss\"].append(train_metrics[\"loss\"])\n        history[\"train_acc\"].append(train_metrics[\"accuracy\"])\n        history[\"train_f1\"].append(train_metrics[\"f1\"])\n        history[\"val_loss\"].append(val_metrics[\"loss\"])\n        history[\"val_acc\"].append(val_metrics[\"accuracy\"])\n        history[\"val_f1\"].append(val_metrics[\"f1\"])\n\n        elapsed = time.time() - t0\n        print(f\"[Epoch {epoch:02d}/{config['epochs']}] \"\n              f\"train_loss={train_metrics['loss']:.4f} train_acc={train_metrics['accuracy']:.4f} \"\n              f\"train_f1={train_metrics['f1']:.4f} | \"\n              f\"val_loss={val_metrics['loss']:.4f} val_acc={val_metrics['accuracy']:.4f} \"\n              f\"val_f1={val_metrics['f1']:.4f} | {elapsed:.1f}s\")\n\n        if val_metrics[\"f1\"] > best_val_f1:\n            best_val_f1 = val_metrics[\"f1\"]\n            patience_counter = 0\n            torch.save({\n                \"epoch\": epoch,\n                \"model_state_dict\": model.state_dict(),\n                \"optimizer_state_dict\": optimizer.state_dict(),\n                \"val_f1\": best_val_f1,\n                \"config\": config,\n            }, config[\"best_model_path\"])\n            print(f\"  -> New best model saved (val_f1={best_val_f1:.4f}) -> {config['best_model_path']}\")\n        else:\n            patience_counter += 1\n            if patience_counter >= config[\"early_stopping_patience\"]:\n                print(f\"[INFO] Early stopping triggered at epoch {epoch} \"\n                      f\"(no val_f1 improvement for {config['early_stopping_patience']} epochs).\")\n                break\n\n    return history\n\n\nif model is not None and optimizer is not None and len(dataloaders[\"train\"]) > 0:\n    history = train_model(model, dataloaders, mel_extractor, criterion,\n                           optimizer, scheduler, scaler, waveform_augmenter, CONFIG)\n\n    # ---- Plot training curves ----\n    fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n    for ax, key, title in zip(\n        axes,\n        [(\"train_loss\", \"val_loss\"), (\"train_acc\", \"val_acc\"), (\"train_f1\", \"val_f1\")],\n        [\"Loss\", \"Accuracy\", \"F1 Score\"],\n    ):\n        ax.plot(history[key[0]], label=\"train\")\n        ax.plot(history[key[1]], label=\"val\")\n        ax.set_title(title)\n        ax.set_xlabel(\"Epoch\")\n        ax.legend()\n        ax.grid(alpha=0.3)\n    plt.tight_layout()\n    plt.savefig(os.path.join(CONFIG[\"results_dir\"], \"training_curves.png\"), dpi=150)\n    plt.show()\nelse:\n    history = None\n    print(\"[WARN] Skipping training — model/optimizer/train data unavailable. \"\n          \"Populate DATA_ROOT with ASVspoof2024 and re-run from Cell 6 onward.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.416661Z","iopub.status.idle":"2026-08-14T17:34:25.416977Z","shell.execute_reply.started":"2026-08-14T17:34:25.416771Z","shell.execute_reply":"2026-08-14T17:34:25.416809Z"}},"outputs":[],"execution_count":null},{"id":"e1987dad-2fbc-4d7f-9cb9-89bac58415bc","cell_type":"code","source":"# ==============================================================\n# Cell 22: Validation — Full Metric Suite (incl. Equal Error Rate)\n# ==============================================================\ndef compute_eer(targets: np.ndarray, scores: np.ndarray) -> Tuple[float, float]:\n    '''Compute the Equal Error Rate (EER), the standard anti-spoofing metric.\n\n    Args:\n        targets: Ground-truth binary labels (1 = bonafide/real, 0 = spoof/fake).\n        scores: Model confidence scores for the \"bonafide\" (real) class.\n\n    Returns:\n        (eer, threshold) — EER as a fraction in [0, 1], and the score threshold at which it occurs.\n    '''\n    fpr, tpr, thresholds = roc_curve(targets, scores, pos_label=1)\n    fnr = 1 - tpr\n    # EER is where FPR and FNR curves cross.\n    idx = np.nanargmin(np.abs(fpr - fnr))\n    eer = (fpr[idx] + fnr[idx]) / 2.0\n    threshold = thresholds[idx]\n    return float(eer), float(threshold)\n\n\n@torch.no_grad()\ndef evaluate_full(model: nn.Module, loader: DataLoader, config: Dict[str, Any]) -> Dict[str, Any]:\n    '''Run full evaluation on a dataloader, returning all standard classification\n    and anti-spoofing metrics.\n\n    Returns:\n        Dict with keys: accuracy, precision, recall, f1, roc_auc, eer, eer_threshold,\n        targets (np.ndarray), preds (np.ndarray), scores (np.ndarray, prob of class=1/real).\n    '''\n    model.eval()\n    all_targets, all_preds, all_scores = [], [], []\n\n    for batch in tqdm(loader, desc=\"Validating\", leave=False):\n        waveform = batch[\"waveform\"].to(DEVICE)\n        target = batch[\"target\"].to(DEVICE)\n\n        logits = model(waveform)\n        probs = F.softmax(logits, dim=1)\n        preds = torch.argmax(probs, dim=1)\n\n        all_targets.extend(target.cpu().numpy().tolist())\n        all_preds.extend(preds.cpu().numpy().tolist())\n        all_scores.extend(probs[:, 1].cpu().numpy().tolist())  # P(real)\n\n    all_targets = np.array(all_targets)\n    all_preds = np.array(all_preds)\n    all_scores = np.array(all_scores)\n\n    metrics = {\n        \"accuracy\": accuracy_score(all_targets, all_preds),\n        \"precision\": precision_score(all_targets, all_preds, zero_division=0),\n        \"recall\": recall_score(all_targets, all_preds, zero_division=0),\n        \"f1\": f1_score(all_targets, all_preds, zero_division=0),\n    }\n    if len(np.unique(all_targets)) > 1:\n        metrics[\"roc_auc\"] = roc_auc_score(all_targets, all_scores)\n        eer, eer_thresh = compute_eer(all_targets, all_scores)\n        metrics[\"eer\"] = eer\n        metrics[\"eer_threshold\"] = eer_thresh\n    else:\n        metrics[\"roc_auc\"] = float(\"nan\")\n        metrics[\"eer\"] = float(\"nan\")\n        metrics[\"eer_threshold\"] = float(\"nan\")\n\n    metrics[\"targets\"] = all_targets\n    metrics[\"preds\"] = all_preds\n    metrics[\"scores\"] = all_scores\n    return metrics\n\n\nif model is not None and len(dataloaders[\"dev\"].dataset) > 0:\n    # Load best checkpoint if available before final validation reporting.\n    if os.path.exists(CONFIG[\"best_model_path\"]):\n        ckpt = torch.load(CONFIG[\"best_model_path\"], map_location=DEVICE)\n        model.load_state_dict(ckpt[\"model_state_dict\"])\n        print(f\"[INFO] Loaded best checkpoint from epoch {ckpt['epoch']} (val_f1={ckpt['val_f1']:.4f})\")\n\n    dev_metrics = evaluate_full(model, dataloaders[\"dev\"], CONFIG)\n    print(\"\\n[DEV SET METRICS]\")\n    for k in [\"accuracy\", \"precision\", \"recall\", \"f1\", \"roc_auc\", \"eer\"]:\n        print(f\"  {k:>10s}: {dev_metrics[k]:.4f}\")\nelse:\n    dev_metrics = None\n    print(\"[WARN] Skipping validation metrics — no trained model / dev data available.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.418751Z","iopub.status.idle":"2026-08-14T17:34:25.419201Z","shell.execute_reply.started":"2026-08-14T17:34:25.419011Z","shell.execute_reply":"2026-08-14T17:34:25.419031Z"}},"outputs":[],"execution_count":null},{"id":"51b6f7fd-6ba0-4f30-98de-45d6412cbe0c","cell_type":"code","source":"# ==============================================================\n# Cell 23: Testing — Confusion Matrix, ROC Curve, Prediction CSV\n# ==============================================================\ndef plot_confusion_matrix(targets: np.ndarray, preds: np.ndarray, save_path: str) -> None:\n    '''Plot and save a labeled confusion matrix (Fake=0, Real=1).'''\n    cm = confusion_matrix(targets, preds, labels=[0, 1])\n    fig, ax = plt.subplots(figsize=(5, 5))\n    im = ax.imshow(cm, cmap=\"Blues\")\n    ax.set_xticks([0, 1]); ax.set_xticklabels([\"Fake\", \"Real\"])\n    ax.set_yticks([0, 1]); ax.set_yticklabels([\"Fake\", \"Real\"])\n    ax.set_xlabel(\"Predicted\"); ax.set_ylabel(\"Ground Truth\")\n    ax.set_title(\"Confusion Matrix\")\n    for i in range(2):\n        for j in range(2):\n            ax.text(j, i, str(cm[i, j]), ha=\"center\", va=\"center\",\n                     color=\"white\" if cm[i, j] > cm.max() / 2 else \"black\", fontsize=14)\n    fig.colorbar(im)\n    plt.tight_layout()\n    plt.savefig(save_path, dpi=150)\n    plt.show()\n\n\ndef plot_roc_curve(targets: np.ndarray, scores: np.ndarray, save_path: str) -> None:\n    '''Plot and save the ROC curve.'''\n    fpr, tpr, _ = roc_curve(targets, scores, pos_label=1)\n    auc = roc_auc_score(targets, scores)\n    plt.figure(figsize=(6, 6))\n    plt.plot(fpr, tpr, label=f\"ROC curve (AUC = {auc:.4f})\")\n    plt.plot([0, 1], [0, 1], linestyle=\"--\", color=\"gray\", label=\"Chance\")\n    plt.xlabel(\"False Positive Rate\")\n    plt.ylabel(\"True Positive Rate\")\n    plt.title(\"ROC Curve\")\n    plt.legend()\n    plt.grid(alpha=0.3)\n    plt.tight_layout()\n    plt.savefig(save_path, dpi=150)\n    plt.show()\n\n\nif model is not None and len(dataloaders[\"eval\"].dataset) > 0:\n    test_metrics = evaluate_full(model, dataloaders[\"eval\"], CONFIG)\n    print(\"\\n[EVAL/TEST SET METRICS]\")\n    for k in [\"accuracy\", \"precision\", \"recall\", \"f1\", \"roc_auc\", \"eer\"]:\n        print(f\"  {k:>10s}: {test_metrics[k]:.4f}\")\n\n    plot_confusion_matrix(test_metrics[\"targets\"], test_metrics[\"preds\"],\n                           os.path.join(CONFIG[\"results_dir\"], \"confusion_matrix.png\"))\n    plot_roc_curve(test_metrics[\"targets\"], test_metrics[\"scores\"],\n                    os.path.join(CONFIG[\"results_dir\"], \"roc_curve.png\"))\n\n    # ---- Save per-utterance predictions to CSV ----\n    eval_filepaths = eval_df[\"filepath\"].tolist()[:len(test_metrics[\"targets\"])]\n    pred_df = pd.DataFrame({\n        \"filepath\": eval_filepaths,\n        \"ground_truth\": [\"real\" if t == 1 else \"fake\" for t in test_metrics[\"targets\"]],\n        \"prediction\": [\"real\" if p == 1 else \"fake\" for p in test_metrics[\"preds\"]],\n        \"score_real\": test_metrics[\"scores\"],\n    })\n    pred_csv_path = os.path.join(CONFIG[\"results_dir\"], \"predictions.csv\")\n    pred_df.to_csv(pred_csv_path, index=False)\n    print(f\"[INFO] Saved predictions -> {pred_csv_path}\")\n    pred_df.head()\nelse:\n    test_metrics = None\n    print(\"[WARN] Skipping testing — no trained model / eval data available.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.420522Z","iopub.status.idle":"2026-08-14T17:34:25.42086Z","shell.execute_reply.started":"2026-08-14T17:34:25.420686Z","shell.execute_reply":"2026-08-14T17:34:25.420706Z"}},"outputs":[],"execution_count":null},{"id":"adb85026-8fba-4a61-b6a5-941d99be0f23","cell_type":"code","source":"# ==============================================================\n# Cell 24: Inference — single-file Real/Fake prediction\n# ==============================================================\nclass DeepfakeInference:\n    '''Convenience wrapper for running inference on a single audio file, reporting\n    the predicted label, class probability, confidence, and wall-clock inference time.\n\n    Args:\n        model: Trained DeepfakeDetector.\n        config: Global CONFIG dictionary.\n        vad_fn: Optional VAD callable applied before feature extraction.\n        device: torch.device to run inference on.\n    '''\n\n    def __init__(self, model: nn.Module, config: Dict[str, Any],\n                 vad_fn: Optional[Any] = None, device: torch.device = DEVICE):\n        self.model = model.to(device).eval()\n        self.config = config\n        self.vad_fn = vad_fn\n        self.device = device\n        self.sample_rate = config[\"sample_rate\"]\n        self.max_len = int(config[\"max_audio_seconds\"] * self.sample_rate)\n\n    def _preprocess(self, filepath: str) -> torch.Tensor:\n        waveform, sr = torchaudio.load(filepath)\n        if waveform.shape[0] > 1:\n            waveform = waveform.mean(dim=0, keepdim=True)\n        if sr != self.sample_rate:\n            waveform = T.Resample(sr, self.sample_rate)(waveform)\n        waveform = waveform.squeeze(0)\n\n        if self.vad_fn is not None:\n            waveform = self.vad_fn(waveform, self.sample_rate)\n\n        length = waveform.shape[0]\n        if length >= self.max_len:\n            start = (length - self.max_len) // 2\n            waveform = waveform[start:start + self.max_len]\n        else:\n            waveform = F.pad(waveform, (0, self.max_len - length))\n        return waveform\n\n    @torch.no_grad()\n    def predict(self, filepath: str) -> Dict[str, Any]:\n        '''Run inference on a single audio file.\n\n        Args:\n            filepath: Path to a .wav/.flac audio file.\n\n        Returns:\n            Dict with keys: label ('Real'/'Fake'), probability_real, confidence,\n            inference_time_ms.\n        '''\n        waveform = self._preprocess(filepath).unsqueeze(0).to(self.device)  # (1, T)\n\n        start_time = time.time()\n        logits = self.model(waveform)\n        probs = F.softmax(logits, dim=1).squeeze(0)\n        inference_time_ms = (time.time() - start_time) * 1000\n\n        pred_class = int(torch.argmax(probs).item())\n        label = \"Real\" if pred_class == 1 else \"Fake\"\n        confidence = float(probs[pred_class].item())\n\n        return {\n            \"filepath\": filepath,\n            \"label\": label,\n            \"probability_real\": float(probs[1].item()),\n            \"confidence\": confidence,\n            \"inference_time_ms\": inference_time_ms,\n        }\n\n\nif model is not None:\n    inferencer = DeepfakeInference(model, CONFIG, vad_fn=vad_fn, device=DEVICE)\n\n    # Example: run inference on the first eval-set file (if available).\n    if len(eval_df) > 0:\n        example_path = eval_df.iloc[0][\"filepath\"]\n        if os.path.exists(example_path):\n            result = inferencer.predict(example_path)\n            print(json.dumps(result, indent=2))\n        else:\n            print(f\"[WARN] Example file not found on disk: {example_path}\")\n    else:\n        print(\"[INFO] inferencer is ready. Call inferencer.predict('path/to/audio.wav') to test.\")\nelse:\n    inferencer = None\n    print(\"[WARN] Inference wrapper not created — model unavailable.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.422764Z","iopub.status.idle":"2026-08-14T17:34:25.423152Z","shell.execute_reply.started":"2026-08-14T17:34:25.422959Z","shell.execute_reply":"2026-08-14T17:34:25.422981Z"}},"outputs":[],"execution_count":null},{"id":"d6a26f01-5334-43df-a0ee-a4bb398d9984","cell_type":"code","source":"# ==============================================================\n# Cell 25: Model Summary — Parameters & Size\n# ==============================================================\ndef summarize_model(model: nn.Module, config: Dict[str, Any]) -> pd.DataFrame:\n    '''Print and return a per-component breakdown of parameter counts and\n    estimated on-disk model size (float32).\n\n    Args:\n        model: The full DeepfakeDetector model.\n        config: Global CONFIG dictionary (used for labeling only).\n\n    Returns:\n        DataFrame with per-submodule parameter counts.\n    '''\n    rows = []\n    for name, module in model.named_children():\n        n_total = sum(p.numel() for p in module.parameters())\n        n_trainable = sum(p.numel() for p in module.parameters() if p.requires_grad)\n        rows.append({\"component\": name, \"total_params\": n_total, \"trainable_params\": n_trainable})\n\n    df = pd.DataFrame(rows)\n    total_params = sum(p.numel() for p in model.parameters())\n    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n    model_size_mb = total_params * 4 / (1024 ** 2)  # float32 = 4 bytes/param\n\n    print(df.to_string(index=False))\n    print(\"-\" * 60)\n    print(f\"{'TOTAL':>20s}: {total_params:,} params\")\n    print(f\"{'TRAINABLE':>20s}: {trainable_params:,} params\")\n    print(f\"{'MODEL SIZE (fp32)':>20s}: {model_size_mb:.2f} MB\")\n    return df\n\n\nif model is not None:\n    summary_df = summarize_model(model, CONFIG)\n    summary_df.to_csv(os.path.join(CONFIG[\"results_dir\"], \"model_summary.csv\"), index=False)\nelse:\n    print(\"[WARN] Cannot summarize — model unavailable.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.424423Z","iopub.status.idle":"2026-08-14T17:34:25.424765Z","shell.execute_reply.started":"2026-08-14T17:34:25.424632Z","shell.execute_reply":"2026-08-14T17:34:25.424655Z"}},"outputs":[],"execution_count":null},{"id":"ebdf1c2f-a320-4f6b-a0bc-34f7ff4c459a","cell_type":"code","source":"# ==============================================================\n# Cell 26: Export — PyTorch state_dict, TorchScript, ONNX\n# ==============================================================\ndef export_model(model: nn.Module, config: Dict[str, Any], device: torch.device) -> None:\n    '''Export the trained model in three formats for downstream deployment:\n    (1) raw PyTorch state_dict, (2) TorchScript (via tracing), (3) ONNX.\n\n    Note: TorchScript/ONNX tracing requires the full forward pass (including the\n    HuggingFace SSL encoder) to be trace-compatible. If tracing fails due to\n    dynamic control flow in the SSL model, the state_dict export still succeeds\n    and can be used directly with PyTorch for real-time inference.\n\n    Args:\n        model: Trained DeepfakeDetector.\n        config: Global CONFIG dictionary.\n        device: Device to run the dummy forward pass on for tracing.\n    '''\n    export_dir = config[\"checkpoint_dir\"]\n    os.makedirs(export_dir, exist_ok=True)\n    model = model.to(device).eval()\n\n    # ---- 1) Plain PyTorch state_dict ----\n    state_dict_path = os.path.join(export_dir, \"deepfake_detector_state_dict.pt\")\n    torch.save(model.state_dict(), state_dict_path)\n    print(f\"[INFO] Saved PyTorch state_dict -> {state_dict_path}\")\n\n    dummy_input = torch.randn(1, int(config[\"max_audio_seconds\"] * config[\"sample_rate\"])).to(device)\n\n    # ---- 2) TorchScript (trace) ----\n    torchscript_path = os.path.join(export_dir, \"deepfake_detector_torchscript.pt\")\n    try:\n        with torch.no_grad():\n            traced = torch.jit.trace(model, dummy_input, strict=False)\n        traced.save(torchscript_path)\n        print(f\"[INFO] Saved TorchScript model -> {torchscript_path}\")\n    except Exception as e:\n        print(f\"[WARN] TorchScript export failed ({e}). \"\n              f\"This can happen with HuggingFace models using dynamic control flow; \"\n              f\"the state_dict export above remains fully usable.\")\n\n    # ---- 3) ONNX ----\n    onnx_path = os.path.join(export_dir, \"deepfake_detector.onnx\")\n    try:\n        torch.onnx.export(\n            model, dummy_input, onnx_path,\n            input_names=[\"waveform\"], output_names=[\"logits\"],\n            dynamic_axes={\"waveform\": {0: \"batch_size\"}, \"logits\": {0: \"batch_size\"}},\n            opset_version=14,\n        )\n        print(f\"[INFO] Saved ONNX model -> {onnx_path}\")\n    except Exception as e:\n        print(f\"[WARN] ONNX export failed ({e}). \"\n              f\"Consider exporting the SSL encoder and CNN+classifier as two separate \"\n              f\"ONNX graphs if the combined graph is not exportable.\")\n\n\nif model is not None:\n    export_model(model, CONFIG, DEVICE)\n    print(\"\\n[DONE] Notebook execution complete. Best model, metrics, plots, and \"\n          \"exported artifacts are available under \"\n          f\"'{CONFIG['checkpoint_dir']}' and '{CONFIG['results_dir']}'.\")\nelse:\n    print(\"[WARN] Skipping export — model unavailable. \"\n          \"Populate DATA_ROOT with the ASVspoof2024 dataset and re-run the notebook top-to-bottom.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-14T17:34:25.425737Z","iopub.status.idle":"2026-08-14T17:34:25.425959Z","shell.execute_reply.started":"2026-08-14T17:34:25.425854Z","shell.execute_reply":"2026-08-14T17:34:25.425865Z"}},"outputs":[],"execution_count":null}]}