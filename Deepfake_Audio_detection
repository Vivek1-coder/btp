      self.reduction = reduction\n\n    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:\n        ce_loss = F.cross_entropy(logits, targets, weight=self.weight, reduction=\"none\")\n        pt = torch.exp(-ce_loss)\n        focal_loss = ((1 - pt) ** self.gamma) * ce_loss\n        if self.reduction == \"mean\":\n            return focal_loss.mean()\n        elif self.reduction == \"sum\":\n            return focal_loss.sum()\n        return focal_loss\n\n\ndef build_loss_fn(config: Dict[str, Any], class_weights: Optional[torch.Tensor] = None) -> nn.Module:\n    if config[\"use_focal_loss\"]:\n        return FocalLoss(gamma=config[\"focal_gamma\"], weight=class_weights)\n    return nn.CrossEntropyLoss(weight=class_weights, label_smoothing=config.get(\"label_smoothing\", 0.0))\n\n\nif len(train_df) > 0:\n    class_counts = train_df[\"target\"].value_counts().sort_index()\n    weights = (1.0 / class_counts).reindex(range(CONFIG[\"num_classes\"])).fillna(1.0)\n    weights = (weights / weights.sum()) * CONFIG[\"num_classes\"]\n    class_weights = torch.tensor(weights.values, dtype=torch.float32).to(DEVICE)\nelse:\n    class_weights = None\n\nloss_class_weights = class_weights if CONFIG.get(\"use_loss_class_weights\", False) else None\ncriterion = build_loss_fn(CONFIG, loss_class_weights)\nprint(f\"[INFO] Loss function: {type(criterion).__name__} | \"\n      f\"label_smoothing={CONFIG.get('label_smoothing', 0.0)} | \"\n      f\"loss_class_weights={'disabled (using WeightedRandomSampler instead)' if loss_class_weights is None else loss_class_weights}\")\n","metadata":{"execution":{"iopub.status.busy":"2026-08-17T05:15:27.839963Z","iopub.execute_input":"2026-08-17T05:15:27.84066Z","iopub.status.idle":"2026-08-17T05:15:27.853595Z","shell.execute_reply.started":"2026-08-17T05:15:27.840638Z","shell.execute_reply":"2026-08-17T05:15:27.852999Z"},"papermill":{"duration":0.245455,"end_time":"2026-08-16T17:39:49.92277+00:00","exception":false,"start_time":"2026-08-16T17:39:49.677315+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def build_optimizer_and_scheduler(model: nn.Module, config: Dict[str, Any],\n                                   steps_per_epoch: int):\n    ssl_params = [p for n, p in model.named_parameters()\n                  if p.requires_grad and n.startswith(\"ssl_encoder.\")]\n    head_params = [p for n, p in model.named_parameters()\n                   if p.requires_grad and not n.startswith(\"ssl_encoder.\")]\n\n    param_groups = [{\"params\": head_params, \"lr\": config[\"lr\"], \"name\": \"head\"}]\n    if len(ssl_params) > 0:\n        param_groups.append({\"params\": ssl_params, \"lr\": config[\"ssl_finetune_lr\"], \"name\": \"ssl_finetune\"})\n\n    optimizer = torch.optim.AdamW(param_groups, weight_decay=config[\"weight_decay\"])\n\n    total_steps = steps_per_epoch * config[\"epochs\"]\n    warmup_steps = steps_per_epoch * config[\"warmup_epochs\"]\n\n    def lr_lambda(current_step: int) -> float:\n        if current_step < warmup_steps:\n            return float(current_step) / float(max(1, warmup_steps))\n        progress = float(current_step - warmup_steps) / float(max(1, total_steps - warmup_steps))\n        return 0.5 * (1.0 + math.cos(math.pi * progress))\n\n    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda)\n    return optimizer, scheduler\n\n\nif model is not None and len(dataloaders[\"train\"]) > 0:\n    optimizer, scheduler = build_optimizer_and_scheduler(\n        model, CONFIG, steps_per_epoch=len(dataloaders[\"train\"])\n    )\n    scaler = GradScaler(enabled=CONFIG[\"use_amp\"] and DEVICE.type == \"cuda\")\n    print(f\"[INFO] Optimizer: AdamW(weight_decay={CONFIG['weight_decay']})\")\n    for g in optimizer.param_groups:\n        print(f\"       param group '{g.get('name', '?')}': {sum(p.numel() for p in g['params']):,} params, lr={g['lr']}\")\n    print(f\"[INFO] Scheduler: Cosin