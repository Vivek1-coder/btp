king=True)\n\n        with torch.set_grad_enabled(train):\n            with autocast(enabled=use_amp):\n                logits = model(waveform)\n                loss = criterion(logits, target)\n\n            if train:\n                optimizer.zero_grad(set_to_none=True)\n                scaler.scale(loss).backward()\n                scaler.unscale_(optimizer)\n                torch.nn.utils.clip_grad_norm_(model.parameters(), config[\"grad_clip_norm\"])\n                scaler.step(optimizer)\n                scaler.update()\n                if scheduler is not None:\n                    scheduler.step()\n\n        total_loss += loss.item() * waveform.size(0)\n        probs = F.softmax(logits.detach().float(), dim=1)\n        preds = torch.argmax(probs, dim=1)\n        all_preds.extend(preds.cpu().numpy().tolist())\n        all_targets.extend(target.detach().cpu().numpy().tolist())\n        all_scores.extend(probs[:, 1].cpu().numpy().tolist())  # P(bonafide)\n        pbar.set_postfix(loss=f\"{loss.item():.4f}\")\n\n    avg_loss = total_loss / max(1, len(loader.dataset))\n    acc = accuracy_score(all_targets, all_preds) if all_targets else 0.0\n    f1 = f1_score(all_targets, all_preds, zero_division=0) if all_targets else 0.0\n    eer = _compute_eer_from_scores(np.array(all_targets), np.array(all_scores)) if all_targets else float(\"nan\")\n\n    return {\"loss\": avg_loss, \"accuracy\": acc, \"f1\": f1, \"eer\": eer}\n\n\ndef train_model(model: nn.Module,\n                 dataloaders: Dict[str, DataLoader],\n                 mel_extractor: nn.Module,\n                 criterion: nn.Module,\n                 optimizer: torch.optim.Optimizer,\n                 scheduler: torch.optim.lr_scheduler._LRScheduler,\n                 scaler: GradScaler,\n                 config: Dict[str, Any]) -> Dict[str, List[float]]:\n    history = {\"train_loss\": [], \"train_acc\": [], \"train_f1\": [], \"train_eer\": [],\n               \"val_loss\": [], \"val_acc\": [], \"val_f1\": [], \"val_eer\": []}\n\n    selection_metric = config.get(\"selection_metric\", \"val_eer\")\n    lower_is_better = selection_metric == \"val_eer\"\n    best_score = math.inf if lower_is_better else -math.inf\n    patience_counter = 0\n\n    for epoch in range(1, config[\"epochs\"] + 1):\n        t0 = time.time()\n\n        train_metrics = run_epoch(model, dataloaders[\"train\"], mel_extractor, criterion, config,\n                                   optimizer=optimizer, scheduler=scheduler, scaler=scaler, train=True)\n        val_metrics = run_epoch(model, dataloaders[\"dev\"], mel_extractor, criterion, config,\n                                 train=False)\n\n        history[\"train_loss\"].append(train_metrics[\"loss\"])\n        history[\"train_acc\"].append(train_metrics[\"accuracy\"])\n        history[\"train_f1\"].append(train_metrics[\"f1\"])\n        history[\"train_eer\"].append(train_metrics[\"eer\"])\n        history[\"val_loss\"].append(val_metrics[\"loss\"])\n        history[\"val_acc\"].append(val_metrics[\"accuracy\"])\n        history[\"val_f1\"].append(val_metrics[\"f1\"])\n        history[\"val_eer\"].append(val_metrics[\"eer\"])\n\n        elapsed = time.time() - t0\n        print(f\"[Epoch {epoch:02d}/{config['epochs']}] \"\n              f\"train_loss={train_metrics['loss']:.4f} train_acc={train_metrics['accuracy']:.4f} \"\n              f\"train_f1={train_metrics['f1']:.4f} train_eer={train_metrics['eer']:.4f} | \"\n              f\"val_loss={val_metrics['loss']:.4f} val_acc={val_metrics['accuracy']:.4f} \"\n              f\"val_f1={val_metrics['f1']:.4f} val_eer={val_metrics['eer']:.4f} | {elapsed:.1f}s\")\n\n        current_score = val_metrics[\"eer\"] if selection_metric == \"val_eer\" else val_metrics[\"f1\"]\n        improved = (current_score < best_score) if lower_is_better else (current_score > best_score)\n\n        if improved:\n            best_score = current_score\n            patience_counter = 0\n            torch.save({\n     