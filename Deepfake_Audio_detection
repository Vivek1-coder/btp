lf, in_channels: int, channels: List[int], kernel_size: int = 5,\n                 dropout: float = 0.2):\n        super().__init__()\n        layers = []\n        prev_c = in_channels\n        for c in channels:\n            layers += [\n                nn.Conv1d(prev_c, c, kernel_size=kernel_size, padding=kernel_size // 2),\n                nn.BatchNorm1d(c),\n                nn.GELU(),\n                nn.Dropout(dropout),\n            ]\n            prev_c = c\n        self.conv = nn.Sequential(*layers)\n        self.pool = nn.AdaptiveAvgPool1d(1)\n        self.out_dim = channels[-1]\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        feats = self.conv(x)          # (B, out_channels, T)\n        pooled = self.pool(feats)     # (B, out_channels, 1)\n        return pooled.flatten(1)      # (B, out_channels)\n\n\nclass LightweightCNN(nn.Module):\n    def __init__(self, backbone: str = \"mobilenetv3_small\", pretrained: bool = True,\n                 in_channels: int = 1):\n        super().__init__()\n        self.backbone_name = backbone\n\n        if backbone == \"mobilenetv3_small\":\n            net = torchvision.models.mobilenet_v3_small(\n                weights=torchvision.models.MobileNet_V3_Small_Weights.DEFAULT if pretrained else None\n            )\n            old_conv = net.features[0][0]\n            new_conv = nn.Conv2d(in_channels, old_conv.out_channels,\n                                  kernel_size=old_conv.kernel_size, stride=old_conv.stride,\n                                  padding=old_conv.padding, bias=False)\n            with torch.no_grad():\n                new_conv.weight[:] = old_conv.weight.mean(dim=1, keepdim=True).repeat(1, in_channels, 1, 1)\n            net.features[0][0] = new_conv\n            self.features = net.features\n            self.pool = nn.AdaptiveAvgPool2d(1)\n            self.out_dim = net.classifier[0].in_features\n\n        elif backbone == \"efficientnet_lite0\":\n            net = timm.create_model(\"efficientnet_lite0\", pretrained=pretrained,\n                                     in_chans=in_channels, num_classes=0, global_pool=\"avg\")\n            self.features = net\n            self.pool = None\n            self.out_dim = net.num_features\n\n        else:\n            raise ValueError(f\"Unknown backbone: {backbone}\")\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if self.backbone_name == \"mobilenetv3_small\":\n            feats = self.features(x)\n            pooled = self.pool(feats)\n            return pooled.flatten(1)\n        else:\n            return self.features(x)\n\n\ndef build_cnn_backbone(config: Dict[str, Any]) -> nn.Module:\n    '''Factory selecting the temporal (recommended) or legacy image-based backbone.'''\n    if config[\"cnn_backbone\"] == \"temporal_cnn\":\n        return LightweightTemporalCNN(\n            in_channels=config[\"ssl_output_dim\"],\n            channels=config[\"temporal_cnn_channels\"],\n            kernel_size=config[\"temporal_cnn_kernel_size\"],\n            dropout=config[\"dropout\"] * 0.5,  \n        )\n    else:\n        return LightweightCNN(\n            backbone=config[\"cnn_backbone\"],\n            pretrained=config[\"cnn_pretrained\"],\n            in_channels=1,\n        )\n\n\ncnn_backbone = build_cnn_backbone(CONFIG).to(DEVICE)\nCONFIG[\"cnn_out_dim\"] = cnn_backbone.out_dim\n\nn_params = sum(p.numel() for p in cnn_backbone.parameters())\nprint(f\"[INFO] Loaded CNN backbone '{CONFIG['cnn_backbone']}' \"\n      f\"(out_dim={cnn_backbone.out_dim}, total_params={n_params:,})\")\n","metadata":{"execution":{"iopub.status.busy":"2026-08-17T05:15:27.447853Z","iopub.execute_input":"2026-08-17T05:15:27.448222Z","iopub.status.idle":"2026-08-17T05:15:27.477222Z","shell.execute_reply.started":"2026-08-17T05:15:27.4482Z","shell.execute_reply":"2026-08-17T05:15:27.476587Z"},"papermill":{"duration":0.186816,"end_time":"2026-08-16T17:39:49.54177+00:00","exception":false,"start_time":"2026-08-16T17:39:49.354954+00:00","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class WaveletBlock(nn.Module):\n    def __init__(self, wavelet_name: str = \"db4\", level: int = 3, out_dim: int = 128):\n        super().__init__()\n        self.wavelet_name = wavelet_name\n        self.level = level\n        n_subbands = level + 1\n        in_dim = n_subbands * 5\n        self.proj = nn.Sequential(\n            nn.Linear(in_dim, out_dim),\n            nn.GELU(),\n            nn.LayerNorm(out_dim),\n        )\n        self.out_dim = out_dim\n\n    def _dwt_features_single(self, wav_np: np.ndarray) -> np.ndarray:\n        coeffs = pywt.wavedec(wav_np, self.wavelet_name, level=self.level)\n        feats = []\n        for c in coeffs:\n            c = c.astype(np.float64)\n            feats.extend([\n                c.mean(),\n                c.std(),\n                c.max() if c.size > 0 else 0.0,\n                c.min() if c.size > 0 else 0.0,\n                np.sum(c ** 2) / max(c.size, 1),  # average energy\n            ])\n        return np.array(feats, dtype=np.float32)\n\n    def forward(self, waveform: torch.Tensor) -> torch.Tensor:\n        device = waveform.device\n        wav_np = waveform.detach().cpu().numpy()\n        batch_feats = np.stack([self._dwt_features_single(w) for w in wav_np], axis=0)\n        batch_feats = torch.from_numpy(batch_feats).float().to(device)\n        return self.proj(batch_feats)\n\n\nwavelet_block = WaveletBlock(\n    wavelet_name=CONFIG[\"wavelet_name\"],\n    level=CONFIG[\"wavelet_level\"],\n    out_dim=CONFIG[\"wavelet_out_dim\"],\n).to(DEVICE) if CONFIG[\"use_wavelet\"] else None\n\nprint(f\"[INFO] Wavelet block {'ENABLED' if wavelet_block is not None else 'DISABLED'} \"\n      f\"({CONFIG['wavelet_name']}, level={CONFIG['wavelet_level']}, \"\n      f\"out_dim={CONFIG['wavelet_out_dim']})\")","metadata":{"execution":{"iopub.status.busy":"2026-08-17T05:15:27.478148Z"